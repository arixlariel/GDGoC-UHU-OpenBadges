---
import { siteConfig } from '@/config/site';
---

<footer class="theme-footer relative z-10 mt-20 border-t theme-border py-10 text-xs theme-text-secondary backdrop-blur-xl transition-all duration-500">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3.5">
      <img
        src="/images/gdgoc-uhu-logo.jpg"
        alt="GDG on Campus UHU"
        class="w-10 h-10 rounded-lg object-cover border theme-border bg-white shadow-xs"
      />
      <div class="flex flex-col items-start gap-0.5">
        <div class="font-bold text-sm theme-text-primary">
          GDG on Campus · Universidad de Huelva
        </div>
        <div class="text-xs theme-text-secondary">
          Certificados Digitales verificados bajo el estándar internacional <span class="font-semibold" style="text-shadow: none;">Open Badges 2.0</span>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-5 text-xs font-medium">
      <a
        href={siteConfig.communityUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-link transition-colors"
      >
        Comunidad
      </a>
      <span class="opacity-40">·</span>
      <a
        href={siteConfig.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-link transition-colors"
      >
        LinkedIn
      </a>
      <span class="opacity-40">·</span>
      <a
        href="https://openbadges.org"
        target="_blank"
        rel="noopener noreferrer"
        class="theme-link transition-colors"
      >
        OpenBadges
      </a>
    </div>
  </div>
</footer>
