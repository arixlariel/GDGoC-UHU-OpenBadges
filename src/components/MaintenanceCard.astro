---
import { siteConfig } from '@/config/site';

interface Props {
  scope: 'hub' | 'openbadges' | 'cybertrainer';
}

const { scope } = Astro.props;

const COPY = {
  hub: {
    title: 'Estamos mejorando el portal',
    description:
      'Estamos realizando tareas de mantenimiento y actualización en el portal oficial de GDGoC UHU. Volveremos en unos minutos',
  },
  openbadges: {
    title: 'Open Badges en mantenimiento',
    description:
      'Estamos actualizando la plataforma de certificados digitales e insignias verificables. Tus credenciales siguen seguras y volveremos en unos minutos',
  },
  cybertrainer: {
    title: 'Cyber Trainer en mantenimiento',
    description:
      'El servidor de retos CTF se encuentra temporalmente en mantenimiento o reiniciándose. Tu progreso y tus flags están a salvo; volveremos en unos minutos',
  },
}[scope];
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 py-14 sm:py-20 relative z-10 flex items-center justify-center flex-1 w-full">
  <div
    data-tilt-max="1.4"
    class="tilt-card theme-card w-full rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden"
  >
    <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-3xl"></div>

    <!-- Icono central -->
    <div class="mx-auto w-20 h-20 rounded-2xl border theme-border flex items-center justify-center mb-6 shadow-sm maint-icon-box">
      <svg
        class="w-10 h-10 theme-accent-text maint-gear-spin"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
        />
      </svg>
    </div>

    <!-- Código 503 discreto -->
    <div class="font-mono text-xs font-bold tracking-[0.22em] uppercase theme-text-secondary mb-2">
      HTTP 503 · Servicio temporalmente en pausa
    </div>

    <h1 class="font-display text-2xl sm:text-4xl font-bold theme-text-primary tracking-tight">
      {COPY.title}
    </h1>

    <p class="mt-3.5 text-sm sm:text-base theme-text-secondary max-w-lg mx-auto leading-relaxed">
      {COPY.description}
    </p>

    <!-- Acciones unificadas en las 3 pantallas de mantenimiento -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        onclick="window.location.reload()"
        class="theme-primary-btn inline-flex items-center justify-center gap-2 h-11 px-6 rounded-full text-white text-xs sm:text-sm font-bold transition-all duration-300 cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reintentar ahora</span>
      </button>

      <a
        href={siteConfig.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-pill-btn inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300"
      >
        <span>LinkedIn</span>
      </a>

      <a
        href={siteConfig.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-pill-btn inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300"
      >
        <span>Instagram</span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .maint-icon-box {
    background: rgba(66, 133, 244, 0.08);
  }
  html[data-theme="cyber"] .maint-icon-box {
    background: rgba(0, 240, 255, 0.1);
    box-shadow: 0 0 28px rgba(0, 240, 255, 0.18);
  }
  html[data-theme="nieve"] .maint-icon-box {
    background: rgba(125, 211, 252, 0.12);
  }
  html[data-theme="piscina"] .maint-icon-box {
    background: rgba(0, 188, 212, 0.1);
  }
  html[data-theme="caramelos"] .maint-icon-box {
    background: rgba(255, 20, 147, 0.1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .maint-gear-spin {
      animation: spinSlow 16s linear infinite;
    }
  }
</style>
