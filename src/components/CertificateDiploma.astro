---
import { getFullUrl } from '@/config/site';
import { generateQrSvgPath } from '@/utils/qrcode';

interface Props {
  assertion: any;
  badge: any;
  assertionId: string;
  initialStyle: 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos';
}

const { assertion, badge, assertionId } = Astro.props;

const issueDate = new Date(assertion.data.issuedOn).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const certUrl = getFullUrl(`/cert/${assertionId}`);
const qr = generateQrSvgPath(certUrl);
const hasEvidence = Boolean(assertion.data.evidence && assertion.data.evidence.trim().length > 0);

// LinkedIn Add to Profile URL
const linkedinUrl = new URL('https://www.linkedin.com/profile/add');
linkedinUrl.searchParams.set('startTask', 'CERTIFICATION_NAME');
linkedinUrl.searchParams.set('name', badge.data.name);
linkedinUrl.searchParams.set('organizationName', 'GDG on Campus Universidad de Huelva');
linkedinUrl.searchParams.set('issueYear', new Date(assertion.data.issuedOn).getFullYear().toString());
linkedinUrl.searchParams.set('issueMonth', (new Date(assertion.data.issuedOn).getMonth() + 1).toString());
linkedinUrl.searchParams.set('certUrl', certUrl);
linkedinUrl.searchParams.set('certId', assertionId);
---

<div class="print-container max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 relative z-10">
  <!-- Contenedor Exterior del Diploma (Grosor de borde idéntico de 6px en los 5 estilos) -->
  <div class="print-diploma-wrapper diploma-outer rounded-3xl transition-all duration-500">
    
    <!-- Tarjeta Principal del Diploma -->
    <div class="diploma-inner relative rounded-[18px] overflow-hidden p-6 sm:p-12 md:p-14 flex flex-col items-center text-center min-h-[620px] justify-between transition-all duration-500">
      
      <!-- Marcos interiores del diploma (Grosor idéntico en todos los estilos) -->
      <div class="diploma-frame-1 absolute inset-3 sm:inset-5 rounded-xl pointer-events-none transition-all duration-500"></div>
      <div class="diploma-frame-2 absolute inset-4 sm:inset-6 rounded-lg pointer-events-none transition-all duration-500"></div>

      <!-- Decoraciones de esquina específicas por estilo -->
      <!-- 1. Google Ornaments -->
      <div class="fx-layer fx-google">
        <svg class="absolute -top-12 -left-12 w-52 h-52 opacity-12 pointer-events-none" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="80" stroke="#4285F4" stroke-width="4" />
          <circle cx="100" cy="100" r="55" stroke="#EA4335" stroke-width="3" stroke-dasharray="8 8" />
        </svg>
        <svg class="absolute -bottom-12 -right-12 w-52 h-52 opacity-12 pointer-events-none" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="80" stroke="#34A853" stroke-width="4" />
          <circle cx="100" cy="100" r="55" stroke="#FBBC04" stroke-width="3" stroke-dasharray="8 8" />
        </svg>
      </div>

      <!-- 2. Cyber Ornaments -->
      <div class="fx-layer fx-cyber">
        <svg class="absolute -top-16 -left-16 w-72 h-72 opacity-25 pointer-events-none" viewBox="0 0 300 300" fill="none">
          <circle cx="120" cy="120" r="85" stroke="#00F0FF" stroke-width="2.5" stroke-dasharray="10 6" />
          <polygon points="20,200 200,20 260,260" stroke="#FF007F" stroke-width="1.5" opacity="0.5" />
        </svg>
        <svg class="absolute -bottom-16 -right-16 w-72 h-72 opacity-25 pointer-events-none" viewBox="0 0 300 300" fill="none">
          <circle cx="180" cy="180" r="85" stroke="#00FF66" stroke-width="2.5" stroke-dasharray="10 6" />
          <polygon points="80,80 280,140 160,280" stroke="#00F0FF" stroke-width="1.5" opacity="0.5" />
        </svg>
      </div>

      <!-- 3. Piscina Ornaments -->
      <div class="fx-layer fx-piscina">
        <span class="absolute top-6 left-8 text-3xl opacity-85 select-none" style="animation: poolWaveBob 3.8s ease-in-out infinite;">🌊</span>
        <span class="absolute top-6 right-8 text-3xl opacity-85 select-none" style="animation: poolWaveBob 4.2s ease-in-out infinite 0.4s;">💦</span>
        <span class="absolute bottom-6 left-8 text-3xl opacity-85 select-none" style="animation: poolWaveBob 4s ease-in-out infinite 0.8s;">🫧</span>
        <span class="absolute bottom-6 right-8 text-3xl opacity-85 select-none" style="animation: poolWaveBob 4.5s ease-in-out infinite 1.2s;">🌊</span>
      </div>

      <!-- 4. Nieve Ornaments -->
      <div class="fx-layer fx-nieve">
        <span class="absolute top-6 left-8 text-3xl opacity-85 select-none" style="animation: floatSlow 4.5s ease-in-out infinite;">❄️</span>
        <span class="absolute top-6 right-8 text-3xl opacity-85 select-none" style="animation: floatReverse 5s ease-in-out infinite;">🌬️</span>
        <span class="absolute bottom-6 left-8 text-3xl opacity-85 select-none" style="animation: floatReverse 4.2s ease-in-out infinite;">❆</span>
        <span class="absolute bottom-6 right-8 text-3xl opacity-85 select-none" style="animation: floatSlow 4.8s ease-in-out infinite;">❄️</span>
      </div>

      <!-- 5. Caramelos Ornaments -->
      <div class="fx-layer fx-caramelos">
        <span class="absolute top-6 left-8 text-3xl opacity-90 select-none" style="animation: candyBounce 4s ease-in-out infinite;">🧁</span>
        <span class="absolute top-6 right-8 text-3xl opacity-90 select-none" style="animation: candyBounce 4.5s ease-in-out infinite 0.4s;">🍬</span>
        <span class="absolute bottom-6 left-8 text-3xl opacity-90 select-none" style="animation: candyBounce 4.2s ease-in-out infinite 0.8s;">🍩</span>
        <span class="absolute bottom-6 right-8 text-3xl opacity-90 select-none" style="animation: candyBounce 4.8s ease-in-out infinite 1.2s;">🍰</span>
      </div>

      <!-- Marca de agua central institucional con el logo de la ETSI UHU -->
      <div class="diploma-watermark absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.055]">
        <div class="w-80 h-80 sm:w-96 sm:h-96 rounded-full overflow-hidden border-4 border-current p-2">
          <img
            src={getFullUrl('/images/gdgoc-uhu-logo.jpg')}
            alt=""
            loading="eager"
            decoding="sync"
            class="w-full h-full object-cover rounded-full grayscale contrast-125"
          />
        </div>
      </div>

      <!-- CAPA DE CONTENIDO DEL DIPLOMA -->
      <div class="relative z-10 w-full flex flex-col items-center flex-1 justify-between">
        
        <!-- Cabecera de Logos (GDG on Campus UHU + Insignia del Evento) -->
        <div class="print-header-block flex flex-col items-center w-full">
          <div class="flex items-center justify-center gap-4 sm:gap-6 mb-4">
            <div class="flex items-center gap-3">
              <img
                src={getFullUrl('/images/gdgoc-uhu-logo.jpg')}
                alt="GDG on Campus Universidad de Huelva"
                loading="eager"
                decoding="sync"
                class="h-12 w-12 sm:h-14 sm:w-14 rounded-xl object-cover border theme-border bg-white shadow-xs"
              />
              <div class="text-left">
                <div class="font-bold text-sm sm:text-base theme-text-primary leading-tight">
                  GDG on Campus
                </div>
                <div class="text-xs font-semibold theme-accent-text">
                  Universidad de Huelva
                </div>
              </div>
            </div>

            <!-- Separador vertical con borde real para impresión PDF -->
            <div class="h-10 border-l-2 theme-border"></div>

            <img
              src={badge.data.image}
              alt={badge.data.name}
              loading="eager"
              decoding="sync"
              class="h-12 w-12 sm:h-14 sm:w-14 object-contain drop-shadow-md hover:scale-110 transition-transform duration-300"
            />
          </div>

          <!-- Rol o Reconocimiento -->
          <div class="theme-badge-pill inline-flex items-center justify-center text-center px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider leading-none mb-2">{assertion.data.role.trim()}</div>

          <h1 class="print-badge-title font-display text-xl sm:text-3xl font-bold theme-text-primary uppercase tracking-[0.06em] mt-1">
            {badge.data.name}
          </h1>

          <div class="text-xs sm:text-sm font-medium theme-text-secondary mt-1 tracking-wide">
            {issueDate}
          </div>
        </div>

        <!-- Bloque Central: Destinatario y Mérito -->
        <div class="print-body-block my-5 sm:my-7 w-full flex flex-col items-center">
          <p class="text-sm sm:text-base theme-text-secondary italic mb-2.5">
            Este certificado digital se otorga a
          </p>

          <!-- Nombre del Alumno con línea y barra de 4 colores en SVG (impresión garantizada) -->
          <div class="print-recipient-box relative inline-block px-4 sm:px-10 pb-3 mb-4 border-b-2 theme-border min-w-[260px] sm:min-w-[420px]">
            <h2 class="diploma-recipient-name font-display text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
              {assertion.data.recipient.name}
            </h2>
            <svg
              class="diploma-underline-accent absolute -bottom-[3px] left-0 right-0 mx-auto w-32 h-1 rounded-full overflow-hidden"
              viewBox="0 0 128 4"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect x="0" y="0" width="32" height="4" fill="#4285F4" />
              <rect x="32" y="0" width="32" height="4" fill="#EA4335" />
              <rect x="64" y="0" width="32" height="4" fill="#FBBC04" />
              <rect x="96" y="0" width="32" height="4" fill="#34A853" />
            </svg>
          </div>

          <!-- Descripción y Criterios -->
          <p class="print-desc text-sm sm:text-[15px] theme-text-primary opacity-90 max-w-2xl leading-relaxed">
            {badge.data.description}
          </p>
          {badge.data.criteria?.narrative && (
            <p class="print-narrative text-xs sm:text-sm theme-text-secondary max-w-xl leading-relaxed mt-1.5">
              {badge.data.criteria.narrative}
            </p>
          )}

          <!-- Caja de Metadatos -->
          <div class="diploma-meta-box mt-5 w-full max-w-2xl rounded-2xl p-3.5 sm:p-4 grid grid-cols-3 gap-3 sm:gap-4 text-center transition-all duration-500">
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Rol Acreditado</span>
              <span class="text-xs sm:text-sm font-bold theme-text-primary">{assertion.data.role}</span>
            </div>
            <div class="flex flex-col gap-0.5 border-x-2 theme-border px-2">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Entidad Emisora</span>
              <span class="text-xs sm:text-sm font-bold theme-text-primary">GDG on Campus UHU</span>
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Estándar</span>
              <span class="text-xs sm:text-sm font-bold text-[#34A853] flex items-center justify-center gap-1">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Open Badges 2.0</span>
              </span>
            </div>
          </div>

          <!-- Tags de Competencias -->
          {badge.data.tags && badge.data.tags.length > 0 && (
            <div class="print-tags mt-4 w-full flex flex-wrap items-center justify-center gap-2">
              {badge.data.tags.map((tag: string) => (
                <span class="theme-badge-pill inline-flex items-center justify-center text-center text-[11px] leading-none px-3.5 py-1.5 rounded-full font-semibold">{`#${tag.trim()}`}</span>
              ))}
            </div>
          )}
        </div>

        <!-- Pie del Diploma: Bloques de Sello y Firma Institucional -->
        <div class="print-footer-block w-full pt-5 mt-2 flex flex-row items-center justify-between gap-2 sm:gap-4 border-t-2 theme-border">
          <div class="flex-1 flex flex-col items-center min-w-0">
            <div class="text-[10px] sm:text-xs font-bold theme-accent-text tracking-widest uppercase mb-1 sm:mb-1.5 whitespace-nowrap">
              GDG on Campus UHU
            </div>
            <div class="w-20 sm:w-48 border-t-2 theme-border mb-1 sm:mb-1.5 print:!w-48"></div>
            <div class="text-[10px] sm:text-xs font-bold theme-text-primary whitespace-nowrap">Universidad de Huelva</div>
            <div class="text-[9px] sm:text-[11px] theme-text-secondary whitespace-nowrap truncate max-w-full">Comunidad de Desarrolladores</div>
          </div>

          <!-- Sello Central Verificado + Código QR Vectorial de Verificación -->
          <div class="flex items-center justify-center gap-2 sm:gap-2.5 shrink-0 print:!flex">
            <div
              class="p-1 rounded-xl border-2 theme-border bg-white shrink-0 shadow-xs"
              title={`Escanea para verificar: ${certUrl}`}
            >
              <svg
                class="w-[52px] h-[52px] sm:w-[62px] sm:h-[62px] print:!w-[62px] print:!h-[62px] block"
                viewBox={`-1 -1 ${qr.size + 2} ${qr.size + 2}`}
                shape-rendering="crispEdges"
                aria-label="Código QR de verificación del certificado"
              >
                <rect x="-1" y="-1" width={qr.size + 2} height={qr.size + 2} fill="#FFFFFF" />
                <path d={qr.path} fill="#111827" />
              </svg>
            </div>

            <div class="diploma-verified-badge theme-pill-btn hidden sm:inline-flex print:!inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full shrink-0">
              <svg class="w-12 h-2.5 shrink-0 overflow-visible" viewBox="0 0 46 10" aria-hidden="true">
                <circle cx="5" cy="5" r="4" fill="#4285F4" />
                <circle cx="17" cy="5" r="4" fill="#EA4335" />
                <circle cx="29" cy="5" r="4" fill="#FBBC04" />
                <circle cx="41" cy="5" r="4" fill="#34A853" />
              </svg>
              <span class="text-[11px] leading-none font-mono font-bold theme-text-primary">VERIFIED</span>
            </div>
          </div>

          <div class="flex-1 flex flex-col items-center min-w-0">
            <div class="font-mono text-[9px] sm:text-xs font-semibold theme-text-secondary mb-1 sm:mb-1.5 select-all whitespace-nowrap truncate max-w-full print:!text-xs">
              {assertionId}
            </div>
            <div class="w-20 sm:w-48 border-t-2 theme-border mb-1 sm:mb-1.5 print:!w-48"></div>
            <div class="text-[10px] sm:text-xs font-bold theme-text-primary whitespace-nowrap">Credencial Criptográfica</div>
            <div class="text-[9px] sm:text-[11px] theme-text-secondary whitespace-nowrap truncate max-w-full">Verificación Alojada SHA-256</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Barra de Acciones Inferior -->
  <div class="no-print mt-6 flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      onclick="window.dispatchEvent(new CustomEvent('open-badge-modal'))"
      class="theme-primary-btn px-5 py-2.5 rounded-full text-white font-semibold text-sm transition-all flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Añadir a tu cartera</span>
    </button>

    <a
      href={linkedinUrl.toString()}
      target="_blank"
      rel="noopener noreferrer"
      class="theme-pill-btn px-5 py-2.5 rounded-full font-semibold text-sm transition-all flex items-center gap-2"
    >
      <svg class="w-4 h-4 text-[#0A66C2] fill-current" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z" />
      </svg>
      <span>Añadir a LinkedIn</span>
    </a>

    <button
      type="button"
      onclick="window.print()"
      class="theme-pill-btn px-4 py-2.5 rounded-full font-semibold text-sm transition-all flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>Imprimir / PDF</span>
    </button>

    {hasEvidence && (
      <a
        href={assertion.data.evidence.trim()}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-pill-btn px-4 py-2.5 rounded-full font-semibold text-sm transition-all flex items-center gap-1.5"
      >
        <span>Ver Evidencia / Proyecto ↗</span>
      </a>
    )}
  </div>
</div>

<style is:global>
  /* ==========================================================================
     DIPLOMA-SPECIFIC STYLING PER THEME (Bordes y paddings de 6px idénticos en los 5 estilos)
     ========================================================================== */
  .diploma-outer {
    padding: 6px !important;
  }

  /* 1. Google Diploma */
  html[data-theme="google"] .diploma-outer {
    background: linear-gradient(135deg, #4285F4 0%, #EA4335 33%, #FBBC04 66%, #34A853 100%);
    box-shadow: 0 16px 45px rgba(32, 33, 36, 0.12);
  }
  html[data-theme="google"] .diploma-inner {
    background: #FFFFFF;
  }
  html[data-theme="google"] .diploma-frame-1 { border: 2px solid #DADCE0; }
  html[data-theme="google"] .diploma-frame-2 { border: 1.5px dashed #E8EAED; }
  html[data-theme="google"] .diploma-recipient-name { color: #202124; }
  html[data-theme="google"] .diploma-meta-box {
    background: #F8F9FA;
    border: 2px solid #DADCE0;
  }

  /* 2. Cyber Diploma */
  html[data-theme="cyber"] .diploma-outer {
    background: linear-gradient(135deg, #00F0FF, #FF007F, #FFE600, #00FF66);
    box-shadow: 0 0 45px rgba(0, 240, 255, 0.35), 0 0 80px rgba(255, 0, 127, 0.2);
  }
  html[data-theme="cyber"] .diploma-inner {
    background: #070B19;
  }
  html[data-theme="cyber"] .diploma-frame-1 { border: 2px solid rgba(0, 240, 255, 0.4); }
  html[data-theme="cyber"] .diploma-frame-2 { border: 1.5px dashed rgba(255, 0, 127, 0.35); }
  html[data-theme="cyber"] .diploma-recipient-name {
    background: linear-gradient(90deg, #00F0FF, #FF007F, #00FF66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 14px rgba(0, 240, 255, 0.4));
  }
  html[data-theme="cyber"] .diploma-meta-box {
    background: rgba(12, 20, 44, 0.9);
    border: 2px solid rgba(0, 240, 255, 0.4);
    box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.1);
  }

  /* 3. Piscina Diploma */
  html[data-theme="piscina"] .diploma-outer {
    background: linear-gradient(135deg, #00F2FE, #4FACFE, #00E5FF, #0284C7);
    box-shadow: 0 20px 55px rgba(2, 132, 199, 0.42);
  }
  html[data-theme="piscina"] .diploma-inner {
    background: linear-gradient(180deg, #FFFFFF 0%, #E0F7FA 100%);
  }
  html[data-theme="piscina"] .diploma-frame-1 { border: 2px solid rgba(0, 188, 212, 0.55); }
  html[data-theme="piscina"] .diploma-frame-2 { border: 1.5px dashed rgba(2, 132, 199, 0.4); }
  html[data-theme="piscina"] .diploma-recipient-name {
    background: linear-gradient(90deg, #0284C7, #00B4DB, #00897B);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  html[data-theme="piscina"] .diploma-meta-box {
    background: rgba(255, 255, 255, 0.88);
    border: 2px solid rgba(0, 188, 212, 0.5);
  }

  /* 4. Nieve Diploma */
  html[data-theme="nieve"] .diploma-outer {
    background: linear-gradient(135deg, #FFFFFF, #7DD3FC, #38BDF8, #BAE6FD);
    box-shadow: 0 20px 60px rgba(2, 132, 199, 0.5), 0 0 38px rgba(224, 242, 254, 0.45);
  }
  html[data-theme="nieve"] .diploma-inner {
    background: linear-gradient(180deg, #08182E 0%, #0F294A 100%);
  }
  html[data-theme="nieve"] .diploma-frame-1 { border: 2px solid rgba(224, 242, 254, 0.55); }
  html[data-theme="nieve"] .diploma-frame-2 { border: 1.5px dashed rgba(125, 211, 252, 0.4); }
  html[data-theme="nieve"] .diploma-recipient-name {
    background: linear-gradient(90deg, #FFFFFF, #7DD3FC, #E0F2FE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 12px rgba(186, 230, 253, 0.45));
  }
  html[data-theme="nieve"] .diploma-meta-box {
    background: rgba(14, 36, 66, 0.8);
    border: 2px solid rgba(186, 230, 253, 0.5);
    box-shadow: inset 0 0 22px rgba(255, 255, 255, 0.14);
  }

  /* 5. Caramelos Diploma */
  html[data-theme="caramelos"] .diploma-outer {
    background: repeating-linear-gradient(
      45deg,
      #FF1493,
      #FF1493 16px,
      #FF85C0 16px,
      #FF85C0 32px,
      #FFF0F6 32px,
      #FFF0F6 48px
    );
    box-shadow: 0 20px 50px rgba(255, 20, 147, 0.38);
  }
  html[data-theme="caramelos"] .diploma-inner {
    background: linear-gradient(180deg, #FFF9FC 0%, #FFE4F2 100%);
  }
  html[data-theme="caramelos"] .diploma-frame-1 { border: 2px dashed #FF4D94; }
  html[data-theme="caramelos"] .diploma-frame-2 { border: 1.5px dotted #FF85C0; }
  html[data-theme="caramelos"] .diploma-recipient-name {
