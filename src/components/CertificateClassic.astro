---
import { getFullUrl } from '@/config/site';

interface Props {
  assertion: any;
  badge: any;
  assertionId: string;
}

const { assertion, badge, assertionId } = Astro.props;

const issueDate = new Date(assertion.data.issuedOn).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const certUrl = getFullUrl(`/cert/${assertionId}`);

// LinkedIn Add to Profile URL
const linkedinUrl = new URL('https://www.linkedin.com/profile/add');
linkedinUrl.searchParams.set('startTask', 'CERTIFICATION_NAME');
linkedinUrl.searchParams.set('name', badge.data.name);
linkedinUrl.searchParams.set('organizationName', 'GDG on Campus Universidad de Huelva');
linkedinUrl.searchParams.set('issueYear', new Date(assertion.data.issuedOn).getFullYear().toString());
linkedinUrl.searchParams.set('issueMonth', (new Date(assertion.data.issuedOn).getMonth() + 1).toString());
linkedinUrl.searchParams.set('certUrl', certUrl);
linkedinUrl.searchParams.set('certId', assertionId);
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <!-- Contenedor Exterior del Diploma (Inspirado en GDG UAM + Google Brand Guidelines) -->
  <div class="print-diploma-wrapper bg-white rounded-2xl p-3 sm:p-6 shadow-[0_4px_24px_rgba(32,33,36,0.08)] border border-[#DADCE0]">
    
    <!-- Tarjeta del Diploma -->
    <div class="relative bg-white text-[#202124] rounded-xl overflow-hidden border border-[#DADCE0] p-6 sm:p-12 md:p-14 flex flex-col items-center text-center min-h-[640px] justify-between">
      
      <!-- Barra superior de 4 colores oficiales de Google -->
      <div class="absolute top-0 left-0 right-0 h-2 flex">
        <div class="flex-1 bg-[#4285F4]"></div>
        <div class="flex-1 bg-[#EA4335]"></div>
        <div class="flex-1 bg-[#FBBC04]"></div>
        <div class="flex-1 bg-[#34A853]"></div>
      </div>

      <!-- Marco interior doble elegante (Punto medio entre diploma clásico y diseño Google) -->
      <div class="absolute inset-3 sm:inset-5 border border-[#E8EAED] rounded-lg pointer-events-none"></div>
      <div class="absolute inset-4 sm:inset-6 border border-[#F1F3F4] rounded-md pointer-events-none"></div>

      <!-- Decoración geométrica sutil Google en las esquinas -->
      <svg class="absolute -top-12 -left-12 w-48 h-48 opacity-[0.07] pointer-events-none" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="80" stroke="#4285F4" stroke-width="4" />
        <circle cx="100" cy="100" r="55" stroke="#EA4335" stroke-width="3" stroke-dasharray="8 8" />
      </svg>
      <svg class="absolute -bottom-12 -right-12 w-48 h-48 opacity-[0.07] pointer-events-none" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="80" stroke="#34A853" stroke-width="4" />
        <circle cx="100" cy="100" r="55" stroke="#FBBC04" stroke-width="3" stroke-dasharray="8 8" />
      </svg>

      <!-- Marca de agua central sutil -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.03]">
        <img src={badge.data.image} alt="" class="w-96 h-96 object-contain" />
      </div>

      <!-- CAPA DE CONTENIDO DEL DIPLOMA -->
      <div class="relative z-10 w-full flex flex-col items-center flex-1 justify-between">
        
        <!-- Cabecera de Logos (GDG on Campus UHU + Insignia del Evento) -->
        <div class="flex flex-col items-center w-full">
          <div class="flex items-center justify-center gap-4 sm:gap-6 mb-5">
            <div class="flex items-center gap-3">
              <img
                src="/images/gdgoc-uhu-logo.jpg"
                alt="GDG on Campus Universidad de Huelva"
                class="h-12 w-12 sm:h-14 sm:w-14 rounded-xl object-cover border border-[#DADCE0] shadow-2xs"
              />
              <div class="text-left">
                <div class="font-bold text-sm sm:text-base text-[#202124] leading-tight">
                  GDG <span class="font-normal text-[#5F6368]">on Campus</span>
                </div>
                <div class="text-xs font-medium text-[#1A73E8]">
                  Universidad de Huelva
                </div>
              </div>
            </div>

            <div class="h-9 w-[1px] bg-[#DADCE0]"></div>

            <img
              src={badge.data.image}
              alt={badge.data.name}
              class="h-12 w-12 sm:h-14 sm:w-14 object-contain drop-shadow-xs"
            />
          </div>

          <!-- Título de Reconocimiento -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#E8F0FE] text-[#1A73E8] text-xs font-bold uppercase tracking-[0.15em] mb-2">
            {assertion.data.role}
          </div>

          <h1 class="font-display text-xl sm:text-3xl font-bold text-[#202124] uppercase tracking-[0.08em] mt-1">
            {badge.data.name}
          </h1>

          <div class="text-xs sm:text-sm font-medium text-[#5F6368] mt-1.5 tracking-wide">
            {issueDate}
          </div>
        </div>

        <!-- Bloque Central: Destinatario y Mérito -->
        <div class="my-6 sm:my-8 w-full flex flex-col items-center">
          <p class="text-sm sm:text-base text-[#5F6368] italic mb-3">
            Este certificado digital se otorga con orgullo a
          </p>

          <!-- Nombre del Alumno con subrayado elegante Google -->
          <div class="relative inline-block px-4 sm:px-10 pb-3 mb-5 border-b-2 border-[#DADCE0] min-w-[260px] sm:min-w-[420px]">
            <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#202124] tracking-tight leading-tight">
              {assertion.data.recipient.name}
            </h2>
            <!-- Acento central de 4 colores en la línea -->
            <div class="absolute -bottom-[2px] left-1/2 -translate-x-1/2 w-28 h-[3px] flex rounded-full overflow-hidden">
              <div class="flex-1 bg-[#4285F4]"></div>
              <div class="flex-1 bg-[#EA4335]"></div>
              <div class="flex-1 bg-[#FBBC04]"></div>
              <div class="flex-1 bg-[#34A853]"></div>
            </div>
          </div>

          <!-- Descripción y Criterios -->
          <p class="text-sm sm:text-[15px] text-[#5F6368] max-w-2xl leading-relaxed">
            {badge.data.description}
          </p>
          {badge.data.criteria?.narrative && (
            <p class="text-xs sm:text-sm text-[#5F6368]/90 max-w-xl leading-relaxed mt-2">
              {badge.data.criteria.narrative}
            </p>
          )}

          <!-- Caja de Metadatos (Inspirada en la cuadrícula de la UAM con estética Google Material) -->
          <div class="mt-6 w-full max-w-2xl bg-[#F8F9FA] border border-[#DADCE0] rounded-xl p-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
            <div class="flex flex-col gap-0.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#5F6368]">Rol Acreditado</span>
              <span class="text-sm font-bold text-[#202124]">{assertion.data.role}</span>
            </div>
            <div class="flex flex-col gap-0.5 sm:border-x border-[#DADCE0] px-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#5F6368]">Entidad Emisora</span>
              <span class="text-sm font-bold text-[#202124]">GDG on Campus UHU</span>
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#5F6368]">Estándar</span>
              <span class="text-sm font-bold text-[#1E8E3E] flex items-center justify-center gap-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Open Badges v2.0
              </span>
            </div>
          </div>

          <!-- Tags de Competencias -->
          {badge.data.tags && badge.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5">
              {badge.data.tags.map((tag: string) => (
                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#E8F0FE] text-[#1A73E8] font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Pie del Diploma: Bloques de Sello y Firma Institucional -->
        <div class="w-full pt-6 mt-2 flex flex-col sm:flex-row items-center justify-around gap-6 border-t border-[#F1F3F4]">
          <div class="flex flex-col items-center min-w-[200px]">
            <div class="text-xs font-bold text-[#1A73E8] tracking-widest uppercase mb-1.5">
              GDG on Campus UHU
            </div>
            <div class="w-44 h-[1px] bg-[#DADCE0] mb-1.5"></div>
            <div class="text-xs font-bold text-[#202124]">Universidad de Huelva</div>
            <div class="text-[11px] text-[#5F6368]">Comunidad Oficial de Desarrolladores</div>
          </div>

          <!-- Sello Central Verificado -->
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#DADCE0] bg-white shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-[#4285F4]"></span>
            <span class="w-2 h-2 rounded-full bg-[#EA4335]"></span>
            <span class="w-2 h-2 rounded-full bg-[#FBBC04]"></span>
            <span class="w-2 h-2 rounded-full bg-[#34A853]"></span>
            <span class="text-[11px] font-mono font-semibold text-[#5F6368] ml-1">VERIFIED</span>
          </div>

          <div class="flex flex-col items-center min-w-[200px]">
            <div class="font-mono text-xs font-semibold text-[#5F6368] mb-1.5">
              {assertionId.slice(0, 16)}...
            </div>
            <div class="w-44 h-[1px] bg-[#DADCE0] mb-1.5"></div>
            <div class="text-xs font-bold text-[#202124]">Credencial Criptográfica</div>
            <div class="text-[11px] text-[#5F6368]">Verificación Alojada SHA-256</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Barra de Acciones Inferior (Estilo GDG UAM + Google Material Buttons) -->
  <div class="no-print mt-6 flex flex-wrap items-center justify-center gap-3">
    <!-- Botón Principal: Añadir a tu perfil (Abre el modal de insignias) -->
    <button
      type="button"
      onclick="window.dispatchEvent(new CustomEvent('open-badge-modal'))"
      class="px-5 py-2.5 rounded-xl bg-[#1A73E8] hover:bg-[#1557B0] text-white font-medium text-sm shadow-xs hover:shadow-md transition-all flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Añadir a tu perfil</span>
    </button>

    <!-- Botón: Añadir a LinkedIn -->
    <a
      href={linkedinUrl.toString()}
      target="_blank"
      rel="noopener noreferrer"
      class="px-5 py-2.5 rounded-xl bg-[#E8F0FE] hover:bg-[#D2E3FC] text-[#1A73E8] font-medium text-sm transition-colors flex items-center gap-2"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z" />
      </svg>
      <span>Añadir a LinkedIn</span>
    </a>

    <!-- Botón: Imprimir / Guardar PDF -->
    <button
      type="button"
      onclick="window.print()"
      class="px-4 py-2.5 rounded-xl bg-white hover:bg-[#F1F3F4] text-[#202124] border border-[#DADCE0] font-medium text-sm transition-colors flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4 text-[#5F6368]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>Imprimir / PDF</span>
    </button>

    <!-- Botón: Compartir -->
    <button
      type="button"
      id="share-cert-btn"
      data-url={certUrl}
      data-title={`${badge.data.name} - ${assertion.data.recipient.name}`}
      class="px-4 py-2.5 rounded-xl bg-white hover:bg-[#F1F3F4] text-[#202124] border border-[#DADCE0] font-medium text-sm transition-colors flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4 text-[#5F6368]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span id="share-btn-text">Compartir</span>
    </button>

    {assertion.data.evidence && (
      <a
        href={assertion.data.evidence}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2.5 rounded-xl bg-[#E6F4EA] hover:bg-[#CEEAD6] text-[#1E8E3E] font-medium text-sm transition-colors flex items-center gap-1.5"
      >
        <span>Ver Evidencia / Proyecto ↗</span>
      </a>
    )}
  </div>

  <!-- Caja inferior de ID de Verificación (Como en GDG UAM) -->
  <div class="no-print mt-6 bg-white border border-[#DADCE0] rounded-xl p-4 text-center">
    <p class="text-xs sm:text-sm text-[#5F6368]">
      Este certificado digital está verificado por <strong class="text-[#202124] font-medium">GDG on Campus Universidad de Huelva</strong> bajo la especificación Open Badges v2.0.
    </p>
    <div class="font-mono text-xs text-[#5F6368] mt-1.5">
      Certificate ID: <span class="text-[#202124] font-medium select-all">{assertionId}</span>
    </div>
  </div>
</div>

<script>
  const shareBtn = document.getElementById('share-cert-btn');
  const shareText = document.getElementById('share-btn-text');
  shareBtn?.addEventListener('click', async () => {
    const url = shareBtn.getAttribute('data-url') || window.location.href;
    const title = shareBtn.getAttribute('data-title') || document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      await navigator.clipboard.writeText(url);
      if (shareText) {
        shareText.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          shareText.textContent = 'Compartir';
        }, 2000);
      }
    }
  });
</script>
