---
import { getFullUrl } from '@/config/site';

interface Props {
  assertion: any;
  badge: any;
  assertionId: string;
}

const { assertion, badge, assertionId } = Astro.props;

const issueDate = new Date(assertion.data.issuedOn).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const certUrl = getFullUrl(`/cert/${assertionId}`);

const linkedinUrl = new URL('https://www.linkedin.com/profile/add');
linkedinUrl.searchParams.set('startTask', 'CERTIFICATION_NAME');
linkedinUrl.searchParams.set('name', badge.data.name);
linkedinUrl.searchParams.set('organizationName', 'GDG on Campus Universidad de Huelva');
linkedinUrl.searchParams.set('issueYear', new Date(assertion.data.issuedOn).getFullYear().toString());
linkedinUrl.searchParams.set('issueMonth', (new Date(assertion.data.issuedOn).getMonth() + 1).toString());
linkedinUrl.searchParams.set('certUrl', certUrl);
linkedinUrl.searchParams.set('certId', assertionId);
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <!-- Contenedor Exterior del Diploma (Estilo Cyber / Hackathon con geometría Google 4 colores) -->
  <div class="print-diploma-wrapper rounded-2xl p-1 bg-gradient-to-r from-[#4285F4] via-[#EA4335] via-[#FBBC04] to-[#34A853] shadow-[0_8px_40px_-10px_rgba(66,133,244,0.35)]">
    
    <div class="relative bg-[#0B0F19] text-slate-100 rounded-[14px] overflow-hidden p-6 sm:p-12 md:p-14 flex flex-col items-center text-center min-h-[640px] justify-between">
      
      <!-- Marco interior con acento neón -->
      <div class="absolute inset-3 sm:inset-5 border border-slate-800/90 rounded-lg pointer-events-none"></div>

      <!-- Geometría decorativa 4 colores de Google en las esquinas (Inspirado en GDG UAM Hackathon) -->
      <svg class="absolute -top-16 -left-16 w-72 h-72 opacity-20 pointer-events-none" viewBox="0 0 300 300" fill="none">
        <defs>
          <linearGradient id="g4-tl" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#4285F4" />
            <stop offset="33%" stop-color="#EA4335" />
            <stop offset="66%" stop-color="#FBBC04" />
            <stop offset="100%" stop-color="#34A853" />
          </linearGradient>
        </defs>
        <circle cx="120" cy="120" r="85" stroke="url(#g4-tl)" stroke-width="2.5" />
        <circle cx="150" cy="140" r="55" stroke="url(#g4-tl)" stroke-width="2" stroke-dasharray="6 8" />
        <polygon points="20,200 200,20 260,260" stroke="#4285F4" stroke-width="1.5" opacity="0.4" />
      </svg>

      <svg class="absolute -bottom-16 -right-16 w-72 h-72 opacity-20 pointer-events-none" viewBox="0 0 300 300" fill="none">
        <defs>
          <linearGradient id="g4-br" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#34A853" />
            <stop offset="33%" stop-color="#FBBC04" />
            <stop offset="66%" stop-color="#EA4335" />
            <stop offset="100%" stop-color="#4285F4" />
          </linearGradient>
        </defs>
        <circle cx="180" cy="180" r="85" stroke="url(#g4-br)" stroke-width="2.5" />
        <circle cx="150" cy="160" r="55" stroke="url(#g4-br)" stroke-width="2" stroke-dasharray="6 8" />
        <polygon points="80,80 280,140 160,280" stroke="#34A853" stroke-width="1.5" opacity="0.4" />
      </svg>

      <!-- CAPA DE CONTENIDO -->
      <div class="relative z-10 w-full flex flex-col items-center flex-1 justify-between">
        
        <!-- Cabecera de Logos -->
        <div class="flex flex-col items-center w-full">
          <div class="flex items-center justify-center gap-4 sm:gap-6 mb-5">
            <div class="flex items-center gap-3">
              <img
                src="/images/gdgoc-uhu-logo.jpg"
                alt="GDG on Campus Universidad de Huelva"
                class="h-12 w-12 sm:h-14 sm:w-14 rounded-xl object-cover border border-slate-700 shadow-md"
              />
              <div class="text-left">
                <div class="font-bold text-sm sm:text-base text-white leading-tight">
                  GDG <span class="font-normal text-slate-400">on Campus</span>
                </div>
                <div class="text-xs font-medium text-[#4285F4]">
                  Universidad de Huelva
                </div>
              </div>
            </div>

            <div class="h-9 w-[1px] bg-slate-800"></div>

            <img
              src={badge.data.image}
              alt={badge.data.name}
              class="h-12 w-12 sm:h-14 sm:w-14 object-contain drop-shadow-[0_0_12px_rgba(66,133,244,0.45)]"
            />
          </div>

          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-950/80 border border-sky-800/60 text-sky-300 font-mono text-xs font-bold uppercase tracking-[0.15em] mb-2">
            ⚡ {assertion.data.role}
          </div>

          <h1 class="font-display text-xl sm:text-3xl font-bold text-white uppercase tracking-[0.08em] mt-1">
            {badge.data.name}
          </h1>

          <div class="text-xs font-mono text-slate-400 mt-1.5 uppercase tracking-widest">
            {issueDate}
          </div>
        </div>

        <!-- Bloque Central: Destinatario -->
        <div class="my-6 sm:my-8 w-full flex flex-col items-center">
          <p class="text-sm text-slate-400 italic mb-3">
            Este certificado digital se otorga a
          </p>

          <div class="relative inline-block px-4 sm:px-10 pb-3 mb-5 border-b border-slate-800 min-w-[260px] sm:min-w-[420px]">
            <h2 class="font-display text-3xl sm:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#4285F4] via-sky-300 to-[#34A853] tracking-tight leading-tight">
              {assertion.data.recipient.name}
            </h2>
            <div class="absolute -bottom-[2px] left-1/2 -translate-x-1/2 w-28 h-[3px] flex rounded-full overflow-hidden">
              <div class="flex-1 bg-[#4285F4]"></div>
              <div class="flex-1 bg-[#EA4335]"></div>
              <div class="flex-1 bg-[#FBBC04]"></div>
              <div class="flex-1 bg-[#34A853]"></div>
            </div>
          </div>

          <p class="text-sm sm:text-[15px] text-slate-300 max-w-2xl leading-relaxed">
            {badge.data.description}
          </p>
          {badge.data.criteria?.narrative && (
            <p class="text-xs sm:text-sm text-slate-400 max-w-xl leading-relaxed mt-2">
              {badge.data.criteria.narrative}
            </p>
          )}

          <!-- Cuadrícula de Metadatos -->
          <div class="mt-6 w-full max-w-2xl bg-slate-900/90 border border-slate-800 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center font-mono">
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Reconocimiento</span>
              <span class="text-xs sm:text-sm font-bold text-sky-300">{assertion.data.role}</span>
            </div>
            <div class="flex flex-col gap-0.5 sm:border-x border-slate-800 px-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Emisor</span>
              <span class="text-xs sm:text-sm font-bold text-white">GDG on Campus UHU</span>
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Verificación</span>
              <span class="text-xs sm:text-sm font-bold text-[#34A853]">Open Badges v2.0 ✓</span>
            </div>
          </div>

          {badge.data.tags && badge.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5 font-mono">
              {badge.data.tags.map((tag: string) => (
                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-slate-900 border border-slate-700 text-sky-300">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Pie del Diploma -->
        <div class="w-full pt-6 mt-2 flex flex-col sm:flex-row items-center justify-around gap-6 border-t border-slate-800/80">
          <div class="flex flex-col items-center min-w-[200px]">
            <div class="text-xs font-bold text-[#4285F4] tracking-widest uppercase mb-1.5">
              GDG on Campus UHU
            </div>
            <div class="w-44 h-[1px] bg-slate-800 mb-1.5"></div>
            <div class="text-xs font-bold text-white">Universidad de Huelva</div>
            <div class="text-[11px] text-slate-400">Comunidad Oficial de Desarrolladores</div>
          </div>

          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-800 bg-slate-900">
            <span class="w-2 h-2 rounded-full bg-[#4285F4]"></span>
            <span class="w-2 h-2 rounded-full bg-[#EA4335]"></span>
            <span class="w-2 h-2 rounded-full bg-[#FBBC04]"></span>
            <span class="w-2 h-2 rounded-full bg-[#34A853]"></span>
            <span class="text-[11px] font-mono font-semibold text-slate-300 ml-1">VERIFIED</span>
          </div>

          <div class="flex flex-col items-center min-w-[200px]">
            <div class="font-mono text-xs font-semibold text-slate-400 mb-1.5">
              {assertionId.slice(0, 16)}...
            </div>
            <div class="w-44 h-[1px] bg-slate-800 mb-1.5"></div>
            <div class="text-xs font-bold text-white">Credencial Criptográfica</div>
            <div class="text-[11px] text-slate-400">Verificación Alojada SHA-256</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Barra de Acciones Inferior -->
  <div class="no-print mt-6 flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      onclick="window.dispatchEvent(new CustomEvent('open-badge-modal'))"
      class="px-5 py-2.5 rounded-xl bg-[#4285F4] hover:bg-[#1A73E8] text-white font-medium text-sm shadow-md transition-all flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Añadir a tu perfil</span>
    </button>

    <a
      href={linkedinUrl.toString()}
      target="_blank"
      rel="noopener noreferrer"
      class="px-5 py-2.5 rounded-xl bg-[#0A66C2] hover:bg-[#004182] text-white font-medium text-sm transition-colors flex items-center gap-2"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z" />
      </svg>
      <span>Añadir a LinkedIn</span>
    </a>

    <button
      type="button"
      onclick="window.print()"
      class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-medium text-sm transition-colors flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>Imprimir / PDF</span>
    </button>

    <button
      type="button"
      id="share-cert-btn-cyber"
      data-url={certUrl}
      data-title={`${badge.data.name} - ${assertion.data.recipient.name}`}
      class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-medium text-sm transition-colors flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span id="share-btn-text-cyber">Compartir</span>
    </button>

    {assertion.data.evidence && (
      <a
        href={assertion.data.evidence}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2.5 rounded-xl bg-emerald-950/80 hover:bg-emerald-900/80 border border-emerald-700/60 text-emerald-300 font-medium text-sm transition-colors flex items-center gap-1.5"
      >
        <span>Ver Evidencia / Proyecto ↗</span>
      </a>
    )}
  </div>

  <!-- Caja inferior de ID de Verificación -->
  <div class="no-print mt-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4 text-center">
    <p class="text-xs sm:text-sm text-slate-400">
      Este certificado digital está verificado por <strong class="text-white font-medium">GDG on Campus Universidad de Huelva</strong> bajo la especificación Open Badges v2.0.
    </p>
    <div class="font-mono text-xs text-slate-400 mt-1.5">
      Certificate ID: <span class="text-sky-300 font-medium select-all">{assertionId}</span>
    </div>
  </div>
</div>

<script>
  const shareBtn = document.getElementById('share-cert-btn-cyber');
  const shareText = document.getElementById('share-btn-text-cyber');
  shareBtn?.addEventListener('click', async () => {
    const url = shareBtn.getAttribute('data-url') || window.location.href;
    const title = shareBtn.getAttribute('data-title') || document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      await navigator.clipboard.writeText(url);
      if (shareText) {
        shareText.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          shareText.textContent = 'Compartir';
        }, 2000);
      }
    }
  });
</script>
