---
---

<div id="theme-fx-container" class="fixed inset-0 pointer-events-none overflow-hidden z-0 no-print">
  <!-- Interactive Cursor Spotlight Layer (Tracks mouse across all 12 styles) -->
  <div class="cursor-spotlight absolute inset-0 transition-opacity duration-500"></div>

  <!-- ======================================================================
       1. GOOGLE MESH: Vibrant Multi-Point Gradient Mesh & Prismatic Vector Arcs
       ====================================================================== -->
  <div class="fx-layer fx-google absolute inset-0">
    <svg class="absolute inset-0 w-full h-full opacity-85" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <filter id="google-mesh-strong" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="95" />
        </filter>
        <linearGradient id="g-arc-blue" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#4285F4" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#34A853" stop-opacity="0.2" />
        </linearGradient>
        <linearGradient id="g-arc-red" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#EA4335" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#FBBC04" stop-opacity="0.2" />
        </linearGradient>
      </defs>
      <!-- Deep saturated organic mesh gradient blobs with independent orbital flow -->
      <g filter="url(#google-mesh-strong)">
        <circle cx="220" cy="180" r="320" fill="#4285F4" fill-opacity="0.65" style="animation: meshMorph 12s ease-in-out infinite;" />
        <circle cx="1220" cy="190" r="340" fill="#EA4335" fill-opacity="0.55" style="animation: meshMorph 15s ease-in-out infinite reverse;" />
        <circle cx="280" cy="740" r="330" fill="#FBBC04" fill-opacity="0.6" style="animation: meshMorph 14s ease-in-out infinite 2s;" />
        <circle cx="1180" cy="720" r="350" fill="#34A853" fill-opacity="0.58" style="animation: meshMorph 13s ease-in-out infinite 1s;" />
        <!-- Center dynamic blend nodes -->
        <circle cx="720" cy="450" r="280" fill="#4285F4" fill-opacity="0.35" style="animation: meshMorph 18s ease-in-out infinite 3s;" />
        <circle cx="680" cy="380" r="240" fill="#FBBC04" fill-opacity="0.32" style="animation: meshMorph 16s ease-in-out infinite 4s;" />
      </g>
    </svg>

    <!-- Prismatic Precision Vector Rings & Chromatic Orbitals -->
    <svg class="absolute top-12 right-[6%] w-72 h-72 opacity-40" style="animation: spinSlow 38s linear infinite;" viewBox="0 0 260 260" fill="none">
      <circle cx="130" cy="130" r="115" stroke="url(#g-arc-blue)" stroke-width="3.5" stroke-dasharray="24 14" />
      <circle cx="130" cy="130" r="88" stroke="url(#g-arc-red)" stroke-width="2.5" stroke-dasharray="12 14" />
      <circle cx="130" cy="130" r="60" stroke="#FBBC04" stroke-width="2.5" />
      <circle cx="130" cy="15" r="5" fill="#4285F4" />
      <circle cx="245" cy="130" r="5" fill="#EA4335" />
      <circle cx="130" cy="245" r="5" fill="#34A853" />
      <circle cx="15" cy="130" r="5" fill="#FBBC04" />
    </svg>
    <svg class="absolute bottom-12 left-[5%] w-80 h-80 opacity-40" style="animation: spinSlow 46s linear infinite reverse;" viewBox="0 0 260 260" fill="none">
      <circle cx="130" cy="130" r="118" stroke="#34A853" stroke-width="3" stroke-dasharray="32 16" />
      <circle cx="130" cy="130" r="86" stroke="#4285F4" stroke-width="2.5" stroke-dasharray="14 14" />
      <circle cx="130" cy="130" r="54" stroke="#EA4335" stroke-width="2" />
    </svg>
  </div>

  <!-- ======================================================================
       2. HARDWARE PCB: High-Density Motherboard, BGA Processor & Bus Packets
       ====================================================================== -->
  <div class="fx-layer fx-hardware absolute inset-0">
    <svg class="absolute inset-0 w-full h-full opacity-60" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <defs>
        <!-- Fine High-Density PCB Soldermask Grid -->
        <pattern id="pcb-matrix" width="48" height="48" patternUnits="userSpaceOnUse">
          <circle cx="24" cy="24" r="1.8" fill="#00FF88" fill-opacity="0.35" />
          <path d="M 48 0 L 0 0 0 48" stroke="#00FF88" stroke-width="0.5" stroke-opacity="0.18" />
        </pattern>
      </defs>
      <rect width="1440" height="900" fill="url(#pcb-matrix)" />

      <!-- Massive Central Bus Traces (Gold and Copper) -->
      <g stroke="#D4AF37" stroke-width="2.8" stroke-opacity="0.75" stroke-linecap="round">
        <path d="M0 120 H180 L260 200 H480" />
        <path d="M0 150 H160 L240 230 H450" />
        <path d="M0 180 H140 L220 260 H420" />
        <path d="M0 640 H200 L290 550 H520" />
        <path d="M0 670 H180 L270 580 H490" />
        <path d="M1440 140 H1240 L1150 230 H960" />
        <path d="M1440 170 H1260 L1170 260 H990" />
        <path d="M1440 680 H1220 L1130 590 H920" />
        <path d="M1440 710 H1200 L1110 620 H890" />
      </g>

      <!-- Animated Traveling Signal Pulses across High-Speed Bus Lines -->
      <g stroke="#00FF88" stroke-width="3.5" stroke-dasharray="50 320" style="animation: pcbSignal 3.2s linear infinite;">
        <path d="M0 120 H180 L260 200 H480" />
        <path d="M0 180 H140 L220 260 H420" />
        <path d="M1440 140 H1240 L1150 230 H960" />
        <path d="M0 640 H200 L290 550 H520" />
        <path d="M1440 680 H1220 L1130 590 H920" />
      </g>
      <g stroke="#FFD54F" stroke-width="3" stroke-dasharray="40 280" style="animation: pcbSignal 4s linear infinite reverse;">
        <path d="M0 150 H160 L240 230 H450" />
        <path d="M1440 170 H1260 L1170 260 H990" />
        <path d="M0 670 H180 L270 580 H490" />
        <path d="M1440 710 H1200 L1110 620 H890" />
      </g>

      <!-- Gold Plated Vias -->
      <g fill="#020E08" stroke="#FFD54F" stroke-width="2.5">
        <circle cx="480" cy="200" r="7" /><circle cx="450" cy="230" r="7" /><circle cx="420" cy="260" r="7" />
        <circle cx="520" cy="550" r="7" /><circle cx="490" cy="580" r="7" />
        <circle cx="960" cy="230" r="7" /><circle cx="990" cy="260" r="7" />
        <circle cx="920" cy="590" r="7" /><circle cx="890" cy="620" r="7" />
      </g>

      <!-- Center-Left Major BGA Processor (U1: GDG-TENSOR-V4) -->
      <g transform="translate(60, 310)">
        <rect x="0" y="0" width="160" height="160" rx="10" fill="#041B11" stroke="#D4AF37" stroke-width="3" />
        <rect x="18" y="18" width="124" height="124" rx="6" fill="#062E1D" stroke="#00FF88" stroke-width="2" />
        <rect x="36" y="36" width="88" height="88" rx="4" fill="#02140C" stroke="#FFD54F" stroke-width="1.5" />
        <circle cx="28" cy="28" r="4.5" fill="#FFD54F" />
        <text x="80" y="75" text-anchor="middle" fill="#FFD54F" font-family="monospace" font-size="12" font-weight="bold">GDG-TENSOR</text>
        <text x="80" y="93" text-anchor="middle" fill="#00FF88" font-family="monospace" font-size="10">64-BIT V4.2</text>
        <text x="80" y="109" text-anchor="middle" fill="#86EFAC" font-family="monospace" font-size="8">ETSI UHU CORE</text>
        <!-- Gold Edge Connector Pins -->
        <path d="M15 -12v12M35 -12v12M55 -12v12M75 -12v12M95 -12v12M115 -12v12M135 -12v12M145 -12v12" stroke="#D4AF37" stroke-width="4.5" />
        <path d="M15 160v12M35 160v12M55 160v12M75 160v12M95 160v12M115 160v12M135 160v12M145 160v12" stroke="#D4AF37" stroke-width="4.5" />
        <path d="M-12 15h12M-12 35h12M-12 55h12M-12 75h12M-12 95h12M-12 115h12M-12 135h12M-12 145h12" stroke="#D4AF37" stroke-width="4.5" />
        <path d="M160 15h12M160 35h12M160 55h12M160 75h12M160 95h12M160 115h12M160 135h12M160 145h12" stroke="#D4AF37" stroke-width="4.5" />
      </g>

      <!-- Center-Right QFP Memory Controller (U2: DDR5-X64) -->
      <g transform="translate(1220, 320)">
        <rect x="0" y="0" width="150" height="150" rx="10" fill="#041B11" stroke="#00FF88" stroke-width="3" />
        <rect x="18" y="18" width="114" height="114" rx="6" fill="#062E1D" stroke="#D4AF37" stroke-width="2" />
        <circle cx="26" cy="26" r="4" fill="#00FF88" />
        <text x="75" y="70" text-anchor="middle" fill="#00FF88" font-family="monospace" font-size="11" font-weight="bold">DDR5-RAM</text>
        <text x="75" y="86" text-anchor="middle" fill="#FFD54F" font-family="monospace" font-size="9">6400 MT/s</text>
        <text x="75" y="102" text-anchor="middle" fill="#86EFAC" font-family="monospace" font-size="8">SHA-256 ACCEL</text>
        <path d="M15 -10v10M35 -10v10M55 -10v10M75 -10v10M95 -10v10M115 -10v10M135 -10v10" stroke="#FFD54F" stroke-width="4" />
        <path d="M15 150v10M35 150v10M55 150v10M75 150v10M95 150v10M115 150v10M135 150v10" stroke="#FFD54F" stroke-width="4" />
      </g>

      <!-- SMD Resistor Arrays, Oscillator & Test Points -->
      <g stroke="#94A3B8" stroke-width="1.5">
        <rect x="250" y="295" width="28" height="12" rx="2" fill="#020E08" stroke="#D4AF37" />
        <text x="264" y="304" text-anchor="middle" fill="#A7F3D0" font-family="monospace" font-size="6">R101</text>
        <rect x="250" y="315" width="28" height="12" rx="2" fill="#020E08" stroke="#D4AF37" />
        <text x="264" y="324" text-anchor="middle" fill="#A7F3D0" font-family="monospace" font-size="6">R102</text>
        <!-- Crystal Oscillator 25.000 MHz -->
        <rect x="245" y="490" width="55" height="24" rx="4" fill="#C0C0C0" fill-opacity="0.25" stroke="#FFD54F" stroke-width="2" />
        <text x="272" y="506" text-anchor="middle" fill="#FFD54F" font-family="monospace" font-size="8" font-weight="bold">25.000 MHz</text>
      </g>

      <!-- Silkscreen Engineering Labels -->
      <g fill="#00FF88" font-family="monospace" font-size="10" opacity="0.65">
        <text x="32" y="80">TP_CLOCK_100MHZ</text>
        <text x="32" y="860">GND_PLANE // ISO-2026</text>
        <text x="1270" y="80">VCC_3V3_HIGH_CURRENT</text>
        <text x="1260" y="860">GDGOC-PCB-REV4</text>
      </g>
    </svg>
  </div>

  <!-- ======================================================================
       3. CYBERPUNK: Night City Skyline, Holographic Kanji, Glitch HUD & AVs
       ====================================================================== -->
  <div class="fx-layer fx-cyberpunk absolute inset-0">
    <!-- Perspective Cyber Neon Grid -->
    <div
      class="absolute inset-0 opacity-35"
      style="background-image: linear-gradient(rgba(252, 238, 10, 0.25) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 0, 85, 0.25) 1px, transparent 1px); background-size: 64px 64px;"
    ></div>

    <!-- High-Speed Scanline Beam -->
    <div class="absolute left-0 right-0 h-1.5 bg-gradient-to-r from-[#FF0055] via-[#FCEE0A] to-[#00F0FF] shadow-[0_0_28px_#FCEE0A]" style="animation: scanlineFast 4.5s linear infinite;"></div>

    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <!-- Background Night City Skyscraper Megastructures -->
      <g opacity="0.55">
        <!-- Far Silhouette Layer -->
        <path d="M0 650 V480 H45 V520 H90 V410 H150 V460 H210 V380 H280 V540 H340 V420 H410 V650" fill="#0E051D" stroke="#FF0055" stroke-width="1.2" />
        <path d="M1030 650 V430 H1100 V370 H1160 V460 H1230 V390 H1300 V470 H1370 V360 H1440 V650" fill="#0E051D" stroke="#00F0FF" stroke-width="1.2" />
        
        <!-- Lit Windows Matrix on Skyscraper 1 -->
        <g fill="#FCEE0A" opacity="0.8">
          <rect x="220" y="400" width="6" height="4" /><rect x="235" y="400" width="6" height="4" /><rect x="250" y="400" width="6" height="4" />
          <rect x="220" y="415" width="6" height="4" /><rect x="250" y="415" width="6" height="4" />
          <rect x="220" y="430" width="6" height="4" /><rect x="235" y="430" width="6" height="4" />
          <rect x="220" y="445" width="6" height="4" /><rect x="235" y="445" width="6" height="4" /><rect x="250" y="445" width="6" height="4" />
        </g>
        <!-- Lit Windows Matrix on Skyscraper 2 -->
        <g fill="#00F0FF" opacity="0.8">
          <rect x="1110" y="390" width="6" height="4" /><rect x="1125" y="390" width="6" height="4" /><rect x="1140" y="390" width="6" height="4" />
          <rect x="1110" y="405" width="6" height="4" /><rect x="1140" y="405" width="6" height="4" />
          <rect x="1110" y="420" width="6" height="4" /><rect x="1125" y="420" width="6" height="4" /><rect x="1140" y="420" width="6" height="4" />
        </g>

        <!-- Rooftop Radio Antennas with Pulsing Red Beacon -->
        <line x1="245" y1="380" x2="245" y2="330" stroke="#FCEE0A" stroke-width="2" />
        <circle cx="245" cy="326" r="3.5" fill="#FF0055" style="animation: starTwinkle 1.5s infinite;" />
        <line x1="1130" y1="370" x2="1130" y2="310" stroke="#00F0FF" stroke-width="2" />
        <circle cx="1130" cy="306" r="3.5" fill="#FCEE0A" style="animation: starTwinkle 1.8s infinite 0.4s;" />
      </g>

      <!-- Giant Holographic Neon Billboards & Japanese Cyber Kanji -->
      <!-- Left Hologram: 夜の街 (Night City) -->
      <g transform="translate(65, 140)" style="animation: cyberGlitch 5s infinite;">
        <rect x="0" y="0" width="70" height="150" fill="#0A0314" stroke="#FF0055" stroke-width="2.5" />
        <text x="35" y="42" text-anchor="middle" fill="#FCEE0A" font-size="26" font-family="'Orbitron', sans-serif" font-weight="900">夜</text>
        <text x="35" y="82" text-anchor="middle" fill="#00F0FF" font-size="26" font-family="'Orbitron', sans-serif" font-weight="900">の</text>
        <text x="35" y="122" text-anchor="middle" fill="#FF0055" font-size="26" font-family="'Orbitron', sans-serif" font-weight="900">街</text>
        <text x="35" y="142" text-anchor="middle" fill="#FCEE0A" font-size="8" font-family="monospace">NIGHT CITY</text>
      </g>

      <!-- Right Hologram: 超過駆動 (OVERDRIVE // NETRUNNER) -->
      <g transform="translate(1300, 140)" style="animation: cyberGlitch 6.5s infinite 1.2s;">
        <rect x="0" y="0" width="75" height="160" fill="#0A0314" stroke="#FCEE0A" stroke-width="2.5" />
        <text x="37" y="40" text-anchor="middle" fill="#00F0FF" font-size="24" font-family="'Orbitron', sans-serif" font-weight="900">超</text>
        <text x="37" y="75" text-anchor="middle" fill="#FF0055" font-size="24" font-family="'Orbitron', sans-serif" font-weight="900">駆</text>
        <text x="37" y="110" text-anchor="middle" fill="#FCEE0A" font-size="24" font-family="'Orbitron', sans-serif" font-weight="900">動</text>
        <text x="37" y="132" text-anchor="middle" fill="#00F0FF" font-size="8" font-family="monospace">OVERDRIVE</text>
        <text x="37" y="148" text-anchor="middle" fill="#FF0055" font-size="8" font-family="monospace">99.8% SYNC</text>
      </g>

      <!-- Left Telemetry Stream Box -->
      <g transform="translate(60, 680)">
        <rect x="0" y="0" width="230" height="90" fill="#0A0314" stroke="#FCEE0A" stroke-width="2" />
        <rect x="0" y="0" width="230" height="18" fill="#FCEE0A" />
        <text x="10" y="13" fill="#000000" font-family="monospace" font-size="10" font-weight="bold">NETRUNNER_DAEMON // V2.0</text>
        <text x="10" y="38" fill="#00F0FF" font-family="monospace" font-size="10">ICE_BREAKER::BYPASSED</text>
        <text x="10" y="56" fill="#FF0055" font-family="monospace" font-size="10">NEURAL_LOAD::34.2 TFLOP/S</text>
        <text x="10" y="74" fill="#FCEE0A" font-family="monospace" font-size="9">TARGET: SHA256_ASSERTION</text>
      </g>

      <!-- Right Targeting HUD Reticle -->
      <g transform="translate(1240, 520)" style="animation: spinSlow 30s linear infinite;">
        <circle cx="0" cy="0" r="95" stroke="#00F0FF" stroke-width="2.5" stroke-dasharray="32 16 10 16" />
        <circle cx="0" cy="0" r="72" stroke="#FF0055" stroke-width="2" stroke-dasharray="14 14" />
        <circle cx="0" cy="0" r="45" stroke="#FCEE0A" stroke-width="1.8" />
        <path d="M-110 0 H-80 M80 0 H110 M0 -110 V-80 M0 80 V110" stroke="#FCEE0A" stroke-width="3" />
      </g>

      <!-- High-Speed AV Vehicle Flight Light Streaks -->
      <g opacity="0.8">
        <line x1="300" y1="460" x2="620" y2="440" stroke="#00F0FF" stroke-width="2.5" stroke-dasharray="40 160" style="animation: windStreak 2.2s linear infinite;" />
        <line x1="820" y1="420" x2="1140" y2="400" stroke="#FF0055" stroke-width="2.5" stroke-dasharray="50 180" style="animation: windStreak 2.6s linear infinite 0.5s;" />
      </g>
    </svg>
  </div>

  <!-- ======================================================================
       4. PISCINA / VERANO: Ocean Swell Coming Towards You, Breaking Crest & Splashes
       ====================================================================== -->
  <div class="fx-layer fx-piscina absolute inset-0">
    <!-- Shimmering Underwater Caustic Rays -->
    <svg class="absolute inset-0 w-full h-full opacity-45" style="animation: causticShimmer 7s ease-in-out infinite;" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <path d="M-50 140 C280 40, 520 250, 820 120 C1100 0, 1340 220, 1500 90" stroke="#FFFFFF" stroke-width="18" stroke-linecap="round" opacity="0.5" />
      <path d="M-60 360 C310 240, 590 440, 920 310 C1180 180, 1380 380, 1520 260" stroke="#E0F7FA" stroke-width="14" stroke-linecap="round" opacity="0.45" />
      <path d="M140 0 C260 280, 100 580, 280 900" stroke="#FFFFFF" stroke-width="10" opacity="0.35" />
      <path d="M1240 0 C1100 320, 1340 620, 1180 900" stroke="#FFFFFF" stroke-width="10" opacity="0.35" />
    </svg>

    <!-- Deep Ocean Wave Swell (Rolling forward in 3 perspective depths) -->
    <!-- Wave Layer 1: Distant Swell -->
    <svg class="absolute bottom-0 left-0 w-[115%] h-80 opacity-55" style="animation: oceanSwellLeft 8s ease-in-out infinite;" viewBox="0 0 1440 360" preserveAspectRatio="none">
      <path fill="#0284C7" d="M0,180 C200,90 400,270 600,180 C800,90 1000,260 1200,180 C1340,120 1400,220 1440,190 L1440,360 L0,360 Z"></path>
    </svg>
    <!-- Wave Layer 2: Mid Breaking Wave Crest Curling Forward -->
    <svg class="absolute bottom-0 left-0 w-[115%] h-64 opacity-70" style="animation: oceanSwellRight 6s ease-in-out infinite;" viewBox="0 0 1440 360" preserveAspectRatio="none">
      <path fill="#00E5FF" d="M0,190 C180,270 380,100 580,200 C780,280 980,110 1180,190 C1300,240 1390,140 1440,210 L1440,360 L0,360 Z"></path>
    </svg>
    <!-- Wave Layer 3: Foreground Big Breaker Surging Toward Screen with White Foam Lip -->
    <svg class="absolute bottom-0 left-0 w-[115%] h-52 opacity-85" style="animation: oceanSwellLeft 4.5s ease-in-out infinite;" viewBox="0 0 1440 360" preserveAspectRatio="none">
      <path fill="#E0F7FA" d="M0,230 C220,150 420,310 640,220 C840,140 1040,290 1240,210 C1360,170 1410,250 1440,230 L1440,360 L0,360 Z"></path>
      <!-- Foaming crest lip -->
      <path stroke="#FFFFFF" stroke-width="8" stroke-linecap="round" d="M0,228 C220,148 420,308 640,218 C840,138 1040,288 1240,208 C1360,168 1410,248 1440,228"></path>
    </svg>

    <!-- Water Splash Bursts Shooting Towards the Screen -->
    <svg class="absolute bottom-28 left-[8%] w-60 h-60 opacity-90" style="animation: splashPulse 3.8s ease-in-out infinite;" viewBox="0 0 240 240" fill="none">
      <!-- Water Splash Crown -->
      <path d="M25 210 Q70 110 50 65 Q100 140 120 40 Q140 140 190 65 Q170 110 215 210 Z" fill="#FFFFFF" fill-opacity="0.75" stroke="#00E5FF" stroke-width="3.5" />
      <!-- Water Droplets flying outward toward camera -->
      <circle cx="42" cy="40" r="9" fill="#FFFFFF" />
      <circle cx="120" cy="18" r="11" fill="#00F2FE" />
      <circle cx="198" cy="44" r="8" fill="#FFFFFF" />
      <circle cx="85" cy="30" r="6" fill="#E0F7FA" />
      <circle cx="155" cy="28" r="7" fill="#FFFFFF" />
      <circle cx="28" cy="110" r="6" fill="#00E5FF" />
      <circle cx="212" cy="115" r="6" fill="#00E5FF" />
    </svg>
    <svg class="absolute bottom-24 right-[8%] w-64 h-64 opacity-90" style="animation: splashPulse 4.4s ease-in-out infinite 0.9s;" viewBox="0 0 240 240" fill="none">
      <path d="M25 210 Q70 110 50 65 Q100 140 120 40 Q140 140 190 65 Q170 110 215 210 Z" fill="#E0F7FA" fill-opacity="0.75" stroke="#FFFFFF" stroke-width="3.5" />
      <circle cx="48" cy="38" r="10" fill="#FFFFFF" />
      <circle cx="120" cy="16" r="9" fill="#FFFFFF" />
      <circle cx="192" cy="42" r="10" fill="#00E5FF" />
      <circle cx="80" cy="26" r="7" fill="#00F2FE" />
      <circle cx="160" cy="24" r="7.5" fill="#FFFFFF" />
    </svg>
  </div>

  <!-- ======================================================================
       5. NIEVE / INVIERNO: Storm Clouds, Lightning Bolts, Wind & Frost
       ====================================================================== -->
  <div class="fx-layer fx-nieve absolute inset-0">
    <div class="absolute inset-0 bg-sky-100/30" style="animation: stormLightning 7s infinite;"></div>
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <g style="animation: boltStrike 7s infinite;">
        <path d="M310 40 L260 190 L325 195 L245 380 L295 385 L210 640" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M260 190 L195 290 L165 370" stroke="#7DD3FC" stroke-width="3" stroke-linecap="round" />
      </g>
      <g style="animation: boltStrike 9s infinite 3.5s;">
        <path d="M1140 30 L1085 180 L1150 188 L1060 390 L1115 400 L1025 660" stroke="#E0F2FE" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <!-- Layered Arctic Storm Clouds at Top -->
      <g opacity="0.75" style="animation: cloudDrift 12s ease-in-out infinite;">
        <path d="M-100 0 H1540 V125 C1380 180, 1220 100, 1060 150 C900 200, 740 110, 580 155 C420 200, 240 110, 80 160 C-20 185, -80 135, -100 125 Z" fill="url(#storm-cloud-grad)" />
