---
interface Props {
  assertionUrl: string;
  badgeName: string;
}

const { assertionUrl } = Astro.props;
const validatorUrl = 'https://openbadgesvalidator.imsglobal.org/';
---

<badge-modal-rework data-assertion-url={assertionUrl}>
  <dialog id="cert-modal-rework" class="backdrop:bg-black/70 backdrop:backdrop-blur-md p-0 rounded-3xl shadow-2xl border theme-border theme-dropdown-panel max-w-md w-[92vw] m-auto fixed inset-0 overflow-hidden z-50 transition-all">
    <div class="theme-top-strip h-1.5 w-full flex overflow-hidden">
      <div class="h-full flex-1 bg-[#4285F4]"></div>
      <div class="h-full flex-1 bg-[#EA4335]"></div>
      <div class="h-full flex-1 bg-[#FBBC04]"></div>
      <div class="h-full flex-1 bg-[#34A853]"></div>
    </div>

    <div class="p-6 sm:p-7">
      <!-- Header -->
      <div class="flex items-center justify-between pb-4 border-b theme-border">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl theme-badge-pill flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-display font-bold tracking-tight theme-text-primary">
              Añadir a tu cartera
            </h3>
            <p class="text-[11px] theme-text-secondary">Estándar criptográfico Open Badges 2.0</p>
          </div>
        </div>
        <button
          type="button"
          data-close-modal
          aria-label="Cerrar modal"
          class="w-8 h-8 flex items-center justify-center rounded-full theme-pill-btn font-bold text-sm cursor-pointer"
        >
          ✕
        </button>
      </div>

      <!-- Importación manual -->
      <div class="mt-5">
        <h4 class="text-xs font-extrabold uppercase tracking-wider theme-text-primary">
          Importación manual JSON-LD
        </h4>
        <p class="text-xs theme-text-secondary mt-1 leading-relaxed">
          Para añadir este certificado a tu cartera digital, copia el siguiente enlace y usa la opción <strong class="theme-text-primary">'Importar desde URL'</strong> en tu cartera preferida.
        </p>

        <div class="mt-3 flex items-center gap-2 theme-search-box rounded-2xl p-2">
          <input
            type="text"
            readonly
            value={assertionUrl}
            class="flex-1 bg-transparent text-xs theme-text-primary font-mono outline-none truncate select-all px-2"
            id="modal-rework-url-input"
          />
          <button
            type="button"
            data-copy-btn
            title="Copiar enlace"
            class="px-3 py-2 rounded-xl theme-primary-btn text-white text-xs font-bold transition-all flex items-center justify-center gap-1.5 shrink-0 cursor-pointer"
          >
            <svg id="copy-rework-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-rework-label">Copiar</span>
          </button>
        </div>
      </div>

      <!-- Carteras Digitales Open Badges -->
      <div class="mt-6">
        <h4 class="text-xs font-extrabold uppercase tracking-wider theme-text-primary mb-3">
          Servicios de Insignias Compatibles
        </h4>
        <div class="grid grid-cols-1 gap-2">
          <a
            href="https://openbadgepassport.com/app/profile/login"
            target="_blank"
            rel="noopener noreferrer"
            class="theme-pill-btn flex items-center justify-between px-4 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <span>OpenBadge Passport</span>
            </span>
            <span class="text-xs opacity-70">↗</span>
          </a>

          <a
            href="https://badges.parchment.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="theme-pill-btn flex items-center justify-between px-4 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>Parchment Digital Badges</span>
            </span>
            <span class="text-xs opacity-70">↗</span>
          </a>

          <a
            href="https://www.credly.com/users/sign_in"
            target="_blank"
            rel="noopener noreferrer"
            class="theme-pill-btn flex items-center justify-between px-4 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              <span>Credly</span>
            </span>
            <span class="text-xs opacity-70">↗</span>
          </a>

          <a
            href={validatorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="theme-badge-pill flex items-center justify-between px-4 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all mt-1 hover:scale-[1.02]"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Validador Oficial IMS Global</span>
            </span>
            <span class="text-xs">Verificar ↗</span>
          </a>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="mt-6 pt-3 border-t theme-border text-center">
        <p class="text-[11px] theme-text-secondary">
          Insignia emitida bajo el estándar Open Badges 2.0 · GDG on Campus UHU
        </p>
      </div>
    </div>
  </dialog>
</badge-modal-rework>

<script>
  class BadgeModalReworkElement extends HTMLElement {
    dialog: HTMLDialogElement | null = null;
    copyBtn: HTMLButtonElement | null = null;
    closeBtn: HTMLButtonElement | null = null;
    urlInput: HTMLInputElement | null = null;

    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      this.copyBtn = this.querySelector('[data-copy-btn]');
      this.closeBtn = this.querySelector('[data-close-modal]');
      this.urlInput = this.querySelector('#modal-rework-url-input');

      window.addEventListener('open-badge-modal', () => {
        this.open();
      });

      this.closeBtn?.addEventListener('click', () => this.close());

      this.dialog?.addEventListener('click', (e) => {
        const rect = this.dialog?.getBoundingClientRect();
        if (rect) {
          const isInDialog = (
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width
          );
          if (!isInDialog) {
            this.close();
          }
        }
      });

      this.copyBtn?.addEventListener('click', async () => {
        const url = this.getAttribute('data-assertion-url') || this.urlInput?.value || '';
        try {
          await navigator.clipboard.writeText(url);
          const label = this.querySelector('#copy-rework-label');
          if (label) label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = 'Copiar';
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    }

    open() {
      this.dialog?.showModal();
    }

    close() {
      this.dialog?.close();
    }
  }

  if (!customElements.get('badge-modal-rework')) {
    customElements.define('badge-modal-rework', BadgeModalReworkElement);
  }
</script>
