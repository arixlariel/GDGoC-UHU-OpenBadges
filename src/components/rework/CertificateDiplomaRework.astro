<script>
  import {
    downloadCertificatePdfRework,
    preloadCertificateAssets,
    type CertificatePdfData,
  } from '@/utils/pdfDownloadRework';

  const downloadBtn = document.getElementById('download-pdf-rework-btn') as HTMLButtonElement | null;
  const labelEl = document.getElementById('download-pdf-rework-label');
  const tiltBtn = document.getElementById('toggle-3d-tilt-btn');
  const tiltLabel = document.getElementById('toggle-3d-tilt-label');
  const diplomaCard = document.getElementById('diploma-tilt-card');

  tiltBtn?.addEventListener('click', () => {
    if (!diplomaCard) return;
    const isDisabled = diplomaCard.dataset.tiltDisabled === 'true';
    if (isDisabled) {
      diplomaCard.dataset.tiltDisabled = 'false';
      if (tiltLabel) tiltLabel.textContent = '3D Interactivo: ON';
    } else {
      diplomaCard.dataset.tiltDisabled = 'true';
      diplomaCard.style.transform = '';
      if (tiltLabel) tiltLabel.textContent = '3D Interactivo: OFF';
    }
  });

  if (downloadBtn) {
    const rawPayload = downloadBtn.getAttribute('data-pdf-payload');
    if (rawPayload) {
      try {
        const parsedPayload: CertificatePdfData = JSON.parse(rawPayload);
        if (parsedPayload) preloadCertificateAssets(parsedPayload);
      } catch {
        // Ignore
      }
    }

    downloadBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      const raw = downloadBtn.getAttribute('data-pdf-payload');
      if (!raw) return;

      const originalLabel = labelEl?.textContent || 'Descargar PDF';
      downloadBtn.disabled = true;
      if (labelEl) labelEl.textContent = 'Generando PDF...';

      try {
        const payload: CertificatePdfData = JSON.parse(raw);
        const activeTheme =
          document.documentElement.getAttribute('data-theme') || payload.style || 'google';
        await downloadCertificatePdfRework(payload, activeTheme);
      } catch (err) {
        console.error('Error al generar el PDF del certificado:', err);
      } finally {
        downloadBtn.disabled = false;
        if (labelEl) labelEl.textContent = originalLabel;
      }
    });
  }
</script>

