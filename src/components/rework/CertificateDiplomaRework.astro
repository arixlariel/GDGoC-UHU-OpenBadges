---
import { getFullUrl, getAssetUrl } from '@/config/site';
import { generateQrSvgPath } from '@/utils/qrcode';
import { REWORK_THEMES, REWORK_STYLE_ORDER, normalizeReworkStyle } from '@/utils/reworkThemes';

interface Props {
  assertion: any;
  badge: any;
  assertionId: string;
  initialStyle: string;
}

const { assertion, badge, assertionId, initialStyle } = Astro.props;
const normalizedStyle = normalizeReworkStyle(initialStyle);

const issueDate = new Date(assertion.data.issuedOn).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const certUrl = getFullUrl(`/cert/${assertionId}`);
const logoUrl = getAssetUrl('/images/gdgoc-uhu-logo.jpg');
const badgeImageUrl = getAssetUrl(badge.data.image);
const qr = generateQrSvgPath(certUrl);
const hasEvidence = Boolean(assertion.data.evidence && assertion.data.evidence.trim().length > 0);

const pdfPayload = {
  assertionId,
  recipientName: assertion.data.recipient.name,
  role: assertion.data.role.trim(),
  badgeName: badge.data.name,
  description: badge.data.description,
  narrative: badge.data.criteria?.narrative || '',
  issueDate,
  tags: Array.isArray(badge.data.tags) ? badge.data.tags.map((t: string) => t.trim()) : [],
  badgeImageUrl,
  logoUrl,
  certUrl,
  qrPath: qr.path,
  qrSize: qr.size,
  style: normalizedStyle,
};

// LinkedIn Add to Profile URL
const linkedinUrl = new URL('https://www.linkedin.com/profile/add');
linkedinUrl.searchParams.set('startTask', 'CERTIFICATION_NAME');
linkedinUrl.searchParams.set('name', badge.data.name);
linkedinUrl.searchParams.set('organizationName', 'GDG on Campus Universidad de Huelva');
linkedinUrl.searchParams.set('issueYear', new Date(assertion.data.issuedOn).getFullYear().toString());
linkedinUrl.searchParams.set('issueMonth', (new Date(assertion.data.issuedOn).getMonth() + 1).toString());
linkedinUrl.searchParams.set('certUrl', certUrl);
linkedinUrl.searchParams.set('certId', assertionId);
---

<div class="print-container max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 relative z-10">
  <!-- Interactive 12-Style Live Switcher Bar & 3D Tilt Toggle (No Print) -->
  <div class="no-print mb-5 theme-card rounded-2xl p-2.5 sm:p-3 flex flex-col sm:flex-row items-center justify-between gap-2.5">
    <div class="flex items-center gap-2 overflow-x-auto max-w-full pb-1 sm:pb-0 no-scrollbar">
      <span class="text-[11px] font-extrabold uppercase tracking-wider theme-text-secondary px-2 shrink-0">
        Probar Estilo:
      </span>
      {REWORK_STYLE_ORDER.map((key) => {
        const item = REWORK_THEMES[key];
        return (
          <button
            type="button"
            data-set-theme={key}
            class="theme-pill-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold inline-flex items-center gap-1.5 shrink-0 cursor-pointer transition-all"
            title={item.subtitle}
          >
            <span class="w-3.5 h-3.5 flex items-center justify-center shrink-0" set:html={item.svgIcon}></span>
            <span>{item.shortLabel}</span>
          </button>
        );
      })}
    </div>

    <button
      type="button"
      id="toggle-3d-tilt-btn"
      class="theme-badge-pill px-3 py-1.5 rounded-xl text-[11px] font-bold inline-flex items-center gap-1.5 shrink-0 cursor-pointer transition-transform hover:scale-105"
      title="Activar o desactivar efecto 3D interactivo al mover el cursor"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
      </svg>
      <span id="toggle-3d-tilt-label">3D Interactivo: ON</span>
    </button>
  </div>

  <!-- Contenedor Exterior del Diploma con soporte 3D Tilt -->
  <div
    id="diploma-tilt-card"
    data-tilt-max="3.2"
    class="tilt-card print-diploma-wrapper diploma-outer rounded-3xl transition-all duration-300 relative"
  >
    <!-- Interactive Specular Glare Layer -->
    <div class="tilt-glare absolute inset-0 rounded-3xl pointer-events-none z-20 no-print"></div>

    <!-- Tarjeta Principal del Diploma -->
    <div class="diploma-inner relative rounded-[18px] overflow-hidden p-6 sm:p-12 md:p-14 flex flex-col items-center text-center min-h-[630px] justify-between transition-all duration-500">
      <!-- Marcos interiores del diploma -->
      <div class="diploma-frame-1 absolute inset-3 sm:inset-5 rounded-xl pointer-events-none transition-all duration-500"></div>
      <div class="diploma-frame-2 absolute inset-4 sm:inset-6 rounded-lg pointer-events-none transition-all duration-500"></div>

      <!-- ==================================================================
           BESPOKE VECTOR CORNER ORNAMENTS FOR ALL 12 STYLES (Zero Emoji Spam!)
           ================================================================== -->
      <!-- 1. Google Mesh Ornaments -->
      <div class="fx-layer fx-google absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute -top-12 -left-12 w-56 h-56 opacity-20" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="82" stroke="#4285F4" stroke-width="4" />
          <circle cx="100" cy="100" r="56" stroke="#EA4335" stroke-width="3" stroke-dasharray="10 8" />
        </svg>
        <svg class="absolute -bottom-12 -right-12 w-56 h-56 opacity-20" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="82" stroke="#34A853" stroke-width="4" />
          <circle cx="100" cy="100" r="56" stroke="#FBBC04" stroke-width="3" stroke-dasharray="10 8" />
        </svg>
      </div>

      <!-- 2. Hardware PCB Ornaments -->
      <div class="fx-layer fx-hardware absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-0 left-0 w-64 h-64 opacity-40" viewBox="0 0 220 220" fill="none">
          <path d="M0 45 H75 L110 80 H165" stroke="#D4AF37" stroke-width="2.5" />
          <path d="M0 70 H60 L95 105 H140" stroke="#00E676" stroke-width="2" />
          <circle cx="165" cy="80" r="5" fill="#04160E" stroke="#FFD54F" stroke-width="2.5" />
          <circle cx="140" cy="105" r="5" fill="#04160E" stroke="#00E676" stroke-width="2.5" />
          <rect x="28" y="28" width="28" height="28" rx="4" fill="#06291A" stroke="#D4AF37" stroke-width="2" />
        </svg>
        <svg class="absolute bottom-0 right-0 w-64 h-64 opacity-40" viewBox="0 0 220 220" fill="none">
          <path d="M220 175 H145 L110 140 H55" stroke="#D4AF37" stroke-width="2.5" />
          <path d="M220 150 H160 L125 115 H80" stroke="#00E676" stroke-width="2" />
          <circle cx="55" cy="140" r="5" fill="#04160E" stroke="#FFD54F" stroke-width="2.5" />
          <circle cx="80" cy="115" r="5" fill="#04160E" stroke="#00E676" stroke-width="2.5" />
        </svg>
      </div>

      <!-- 3. Cyberpunk Ornaments -->
      <div class="fx-layer fx-cyberpunk absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-5 left-6 w-52 h-24 opacity-65" viewBox="0 0 220 90" fill="none">
          <path d="M0 0 H170 L150 22 H0 Z" fill="#FCEE0A" fill-opacity="0.2" stroke="#FCEE0A" stroke-width="1.5" />
          <text x="10" y="15" fill="#FCEE0A" font-family="monospace" font-size="10" font-weight="bold">NC_NET // VERIFIED</text>
        </svg>
        <svg class="absolute bottom-5 right-6 w-56 h-56 opacity-40" viewBox="0 0 200 200" fill="none">
          <circle cx="130" cy="130" r="58" stroke="#00F0FF" stroke-width="2.5" stroke-dasharray="18 8 4 8" />
          <circle cx="130" cy="130" r="40" stroke="#FF0055" stroke-width="2" />
        </svg>
      </div>

      <!-- 4. Piscina / Verano Ornaments (Vector Waves & Splashes) -->
      <div class="fx-layer fx-piscina absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute bottom-0 left-0 w-full h-28 opacity-35" viewBox="0 0 1200 120" preserveAspectRatio="none">
          <path d="M0,50 C200,110 400,-10 600,50 C800,110 1000,-10 1200,50 L1200,120 L0,120 Z" fill="#00E5FF" />
          <path d="M0,75 C250,20 450,115 700,65 C950,15 1100,90 1200,70 L1200,120 L0,120 Z" fill="#0284C7" fill-opacity="0.45" />
        </svg>
      </div>

      <!-- 5. Nieve / Invierno Ornaments (Lightning & Ice Fractals) -->
      <div class="fx-layer fx-nieve absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-6 left-6 w-28 h-28 opacity-45" viewBox="0 0 120 120" fill="none" stroke="#BAE6FD" stroke-width="2">
          <path d="M60 10 V110 M16 35 L104 85 M16 85 L104 35" />
          <polygon points="60,32 84,46 84,74 60,88 36,74 36,46" stroke="#FFFFFF" stroke-width="1.5" />
        </svg>
        <svg class="absolute bottom-6 right-6 w-28 h-28 opacity-45" viewBox="0 0 120 120" fill="none" stroke="#BAE6FD" stroke-width="2">
          <path d="M60 10 V110 M16 35 L104 85 M16 85 L104 35" />
          <polygon points="60,32 84,46 84,74 60,88 36,74 36,46" stroke="#FFFFFF" stroke-width="1.5" />
        </svg>
      </div>

      <!-- 6. Caramelos Ornaments (Rainbow Arc & Pot of Gold) -->
      <div class="fx-layer fx-caramelos absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute -top-10 -left-10 w-56 h-56 opacity-35" viewBox="0 0 200 200" fill="none">
          <circle cx="60" cy="60" r="110" stroke="#FF1493" stroke-width="8" />
          <circle cx="60" cy="60" r="100" stroke="#F59E0B" stroke-width="8" />
          <circle cx="60" cy="60" r="90" stroke="#00E5FF" stroke-width="8" />
          <circle cx="60" cy="60" r="80" stroke="#8B5CF6" stroke-width="8" />
        </svg>
        <svg class="absolute bottom-5 right-6 w-24 h-24 opacity-80" viewBox="0 0 100 100" fill="none">
          <circle cx="38" cy="36" r="9" fill="#FACC15" stroke="#B45309" stroke-width="2" />
          <circle cx="52" cy="32" r="10" fill="#FDE047" stroke="#B45309" stroke-width="2" />
          <circle cx="64" cy="37" r="9" fill="#FACC15" stroke="#B45309" stroke-width="2" />
          <path d="M22 42 H78 C86 64, 78 88, 50 90 C22 88, 14 64, 22 42 Z" fill="#311042" stroke="#F59E0B" stroke-width="3" />
        </svg>
      </div>

      <!-- 7. Aurora & Cosmos Ornaments -->
      <div class="fx-layer fx-aurora absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-6 right-6 w-44 h-44 opacity-45" viewBox="0 0 160 160" fill="none">
          <ellipse cx="80" cy="80" rx="68" ry="26" transform="rotate(-30 80 80)" stroke="#00FFAA" stroke-width="1.5" />
          <ellipse cx="80" cy="80" rx="68" ry="26" transform="rotate(30 80 80)" stroke="#A855F7" stroke-width="1.5" stroke-dasharray="6 4" />
          <circle cx="80" cy="80" r="8" fill="#00FFAA" />
        </svg>
      </div>

      <!-- 8. Blueprint CAD Ornaments -->
      <div class="fx-layer fx-blueprint absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-6 left-8 font-mono text-[10px] text-[#93C5FD]/75 tracking-widest">
          CAD-REF: {assertionId.substring(0, 10).toUpperCase()} // ISO-A4
        </div>
        <div class="absolute top-6 right-8 font-mono text-[10px] text-[#93C5FD]/75 tracking-widest">
          TOL: ±0.01mm // SCALE 1:1
        </div>
      </div>

      <!-- 9. Antiguo (Greece & Egypt) Ornaments -->
      <div class="fx-layer fx-antiguo absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute bottom-6 left-7 w-28 h-24 opacity-45" viewBox="0 0 120 100" fill="none">
          <polygon points="10,90 60,15 110,90" fill="#D4AF37" fill-opacity="0.3" stroke="#92400E" stroke-width="2.5" />
          <circle cx="60" cy="58" r="10" stroke="#1B365D" stroke-width="2" />
        </svg>
        <svg class="absolute bottom-6 right-7 w-28 h-24 opacity-45" viewBox="0 0 120 100" fill="none">
          <polygon points="10,90 60,15 110,90" fill="#D4AF37" fill-opacity="0.3" stroke="#92400E" stroke-width="2.5" />
          <circle cx="60" cy="58" r="10" stroke="#1B365D" stroke-width="2" />
        </svg>
      </div>

      <!-- 10. Japón Tradicional & Dongba Ornaments -->
      <div class="fx-layer fx-japon absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-6 left-7 w-24 h-24 opacity-50" viewBox="0 0 100 100" fill="none">
          <path d="M10 24 Q50 14 90 24 L86 32 Q50 24 14 32 Z" fill="#C82829" />
          <rect x="20" y="42" width="60" height="6" fill="#C82829" />
          <rect x="28" y="28" width="7" height="64" fill="#C82829" />
          <rect x="65" y="28" width="7" height="64" fill="#C82829" />
        </svg>
        <svg class="absolute top-6 right-7 w-20 h-20 opacity-45" viewBox="0 0 100 100" fill="none">
          <circle cx="50" cy="50" r="36" fill="#C82829" fill-opacity="0.25" stroke="#C82829" stroke-width="2" />
        </svg>
      </div>

      <!-- 11. Voynich & Stained Glass Ornaments -->
      <div class="fx-layer fx-voynich absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-5 left-6 w-28 h-28 opacity-45" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="48" stroke="#F59E0B" stroke-width="2" />
          <circle cx="60" cy="60" r="32" stroke="#F43F5E" stroke-width="1.5" stroke-dasharray="6 4" />
          <path d="M60 12 V108 M12 60 H108" stroke="#F59E0B" stroke-width="1.5" />
        </svg>
        <svg class="absolute top-5 right-6 w-28 h-28 opacity-45" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="48" stroke="#F59E0B" stroke-width="2" />
          <circle cx="60" cy="60" r="32" stroke="#34D399" stroke-width="1.5" stroke-dasharray="6 4" />
          <path d="M60 12 V108 M12 60 H108" stroke="#F59E0B" stroke-width="1.5" />
        </svg>
      </div>

      <!-- 12. Mixteca / Amazonia Ornaments -->
      <div class="fx-layer fx-mixteca absolute inset-0 pointer-events-none overflow-hidden">
        <svg class="absolute top-6 left-7 w-28 h-28 opacity-55" viewBox="0 0 120 120" fill="none">
          <path d="M10 60 H40 V25 H85 V50 H60" stroke="#F59E0B" stroke-width="4" />
          <rect x="18" y="18" width="14" height="14" fill="#00A86B" />
        </svg>
        <svg class="absolute top-6 right-7 w-28 h-28 opacity-55" viewBox="0 0 120 120" fill="none">
          <path d="M110 60 H80 V25 H35 V50 H60" stroke="#F59E0B" stroke-width="4" />
          <rect x="88" y="18" width="14" height="14" fill="#00A86B" />
        </svg>
      </div>

      <!-- Marca de agua central institucional con el logo de la ETSI UHU -->
      <div class="diploma-watermark absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.05]">
        <div class="w-80 h-80 sm:w-96 sm:h-96 rounded-full overflow-hidden border-4 border-current p-2">
          <img
            src={logoUrl}
            alt=""
            loading="eager"
            decoding="sync"
            class="w-full h-full object-cover rounded-full grayscale contrast-125"
          />
        </div>
      </div>

      <!-- CAPA DE CONTENIDO DEL DIPLOMA -->
      <div class="relative z-10 w-full flex flex-col items-center flex-1 justify-between">
        <!-- Cabecera de Logos (GDG on Campus UHU + Insignia del Evento) -->
        <div class="print-header-block flex flex-col items-center w-full">
          <div class="print-logos-row flex items-center justify-center gap-4 sm:gap-6 mb-4">
            <div class="flex items-center gap-3">
              <img
                src={logoUrl}
                alt="GDG on Campus Universidad de Huelva"
                loading="eager"
                decoding="sync"
                class="h-12 w-12 sm:h-14 sm:w-14 rounded-xl object-cover border theme-border bg-white shadow-sm"
              />
              <div class="text-left">
                <div class="font-bold text-sm sm:text-base theme-text-primary leading-tight">
                  GDG on Campus
                </div>
                <div class="text-xs font-semibold theme-accent-text">
                  Universidad de Huelva
                </div>
              </div>
            </div>

            <div class="h-10 border-l-2 theme-border"></div>

            <img
              src={badgeImageUrl}
              alt={badge.data.name}
              loading="eager"
              decoding="sync"
              class="h-12 w-12 sm:h-14 sm:w-14 object-contain drop-shadow-md hover:scale-110 transition-transform duration-300"
            />
          </div>

          <!-- Rol o Reconocimiento -->
          <div class="theme-badge-pill inline-flex items-center justify-center text-center px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider leading-none mb-2">
            {assertion.data.role.trim()}
          </div>

          <h1 class="print-badge-title font-display text-xl sm:text-3xl font-bold theme-text-primary uppercase tracking-[0.06em] mt-1">
            {badge.data.name}
          </h1>

          <div class="diploma-issue-date text-xs sm:text-sm font-semibold theme-accent-text mt-1.5 tracking-wider">
            Emitido el {issueDate}
          </div>
        </div>

        <!-- Bloque Central: Destinatario y Mérito -->
        <div class="print-body-block my-5 sm:my-7 w-full flex flex-col items-center">
          <p class="text-sm sm:text-base theme-text-secondary italic mb-2.5">
            Este certificado digital se otorga a
          </p>

          <div class="print-recipient-box relative inline-block px-4 sm:px-10 pb-3 mb-4 border-b-2 theme-border min-w-[260px] sm:min-w-[420px]">
            <h2 class="diploma-recipient-name font-display text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
              {assertion.data.recipient.name}
            </h2>
            <svg
              class="diploma-underline-accent absolute -bottom-[3px] left-0 right-0 mx-auto w-36 h-1.5 rounded-full overflow-hidden"
              viewBox="0 0 128 4"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect x="0" y="0" width="32" height="4" fill="#4285F4" />
              <rect x="32" y="0" width="32" height="4" fill="#EA4335" />
              <rect x="64" y="0" width="32" height="4" fill="#FBBC04" />
              <rect x="96" y="0" width="32" height="4" fill="#34A853" />
            </svg>
          </div>

          <!-- Descripción y Criterios -->
          <p class="print-desc text-sm sm:text-[15px] theme-text-primary opacity-95 max-w-2xl leading-relaxed">
            {badge.data.description}
          </p>
          {badge.data.criteria?.narrative && (
            <p class="print-narrative text-xs sm:text-sm theme-text-secondary max-w-xl leading-relaxed mt-1.5">
              {badge.data.criteria.narrative}
            </p>
          )}

          <!-- Caja de Metadatos -->
          <div class="diploma-meta-box mt-5 w-full max-w-2xl rounded-2xl p-3.5 sm:p-4 grid grid-cols-3 gap-3 sm:gap-4 text-center transition-all duration-500">
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Rol Acreditado</span>
              <span class="text-xs sm:text-sm font-bold theme-text-primary">{assertion.data.role}</span>
            </div>
            <div class="flex flex-col gap-0.5 border-x-2 theme-border px-2">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Entidad Emisora</span>
              <span class="text-xs sm:text-sm font-bold theme-text-primary">GDG on Campus UHU</span>
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider theme-text-secondary">Estándar</span>
              <span class="text-xs sm:text-sm font-bold text-[#34A853] flex items-center justify-center gap-1">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Open Badges 2.0</span>
              </span>
            </div>
          </div>

          <!-- Tags de Competencias -->
          {badge.data.tags && badge.data.tags.length > 0 && (
            <div class="print-tags mt-4 w-full flex flex-wrap items-center justify-center gap-2">
              {badge.data.tags.map((tag: string) => (
                <span class="theme-badge-pill inline-flex items-center justify-center text-center text-[11px] leading-none px-3.5 py-1.5 rounded-full font-semibold">
                  {`#${tag.trim()}`}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Pie del Diploma: Bloques de Sello y Firma Institucional -->
        <div class="print-footer-block w-full pt-4 sm:pt-5 mt-2 flex flex-row items-center justify-between gap-2 sm:gap-4 border-t-2 theme-border">
          <div class="print-footer-left flex-1 flex flex-col items-center text-center min-w-0">
            <div class="print-footer-org text-[10px] sm:text-xs font-bold theme-accent-text tracking-wider uppercase mb-1 whitespace-nowrap">
              <span class="print-inline block sm:inline">GDG on</span> <span class="text-theme-accent">Campus</span>
            </div>
            <div class="print-footer-line w-16 sm:w-44 border-t-2 theme-border mb-1.5 mx-auto"></div>
            <div class="print-footer-title text-[9px] sm:text-xs font-bold theme-text-primary leading-tight whitespace-nowrap">Universidad de Huelva</div>
            <div class="print-footer-subtitle text-[8px] sm:text-[11px] theme-text-secondary leading-tight whitespace-nowrap">
              <span class="footer-lbl-mobile">Desarrolladores</span><span class="footer-lbl-desktop">Comunidad de Desarrolladores</span>
            </div>
          </div>

          <!-- Sello Central: Código QR Vectorial de Verificación -->
          <div class="flex items-center justify-center shrink-0 px-1 sm:px-4">
            <div
              class="print-qr-container p-1 sm:p-1.5 rounded-xl border-2 theme-border bg-white shrink-0 shadow-sm"
              title={`Escanea para verificar: ${certUrl}`}
            >
              <svg
                class="print-qr-svg w-[54px] h-[54px] sm:w-[64px] sm:h-[64px] block"
                viewBox={`-1 -1 ${qr.size + 2} ${qr.size + 2}`}
                shape-rendering="crispEdges"
                aria-label="Código QR de verificación del certificado"
              >
                <rect x="-1" y="-1" width={qr.size + 2} height={qr.size + 2} fill="#FFFFFF" />
                <path d={qr.path} fill="#111827" />
              </svg>
            </div>
          </div>

