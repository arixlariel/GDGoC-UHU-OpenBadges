---
import { siteConfig, getAssetUrl } from '@/config/site';
import { REWORK_THEMES, REWORK_STYLE_ORDER, normalizeReworkStyle, type ReworkStyleKey } from '@/utils/reworkThemes';

interface Props {
  lockedStyle?: string;
  originalUrl?: string;
}

const { lockedStyle, originalUrl = getAssetUrl('/') } = Astro.props;
const normalizedLocked: ReworkStyleKey | null = lockedStyle ? normalizeReworkStyle(lockedStyle) : null;
const initialMeta = normalizedLocked ? REWORK_THEMES[normalizedLocked] : REWORK_THEMES.google;
---

<header class="theme-header sticky top-0 z-50 backdrop-blur-2xl transition-all duration-500">
  <!-- Dynamic Top Brand Strip -->
  <div class="theme-top-strip h-1.5 w-full flex overflow-hidden relative">
    <div class="h-full flex-1 bg-[#4285F4]"></div>
    <div class="h-full flex-1 bg-[#EA4335]"></div>
    <div class="h-full flex-1 bg-[#FBBC04]"></div>
    <div class="h-full flex-1 bg-[#34A853]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-[70px] flex items-center justify-between gap-2 sm:gap-4">
    <!-- Left: Brand Identity + UI Rework Badge -->
    <div class="flex items-center gap-3 min-w-0">
      <a href={getAssetUrl('/ui_rework')} class="flex items-center gap-3 group min-w-0">
        <div class="relative w-11 h-11 rounded-2xl overflow-hidden border theme-border shadow-md shrink-0 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 bg-white">
          <img
            src={getAssetUrl('/images/gdgoc-uhu-logo.jpg')}
            alt="GDG on Campus Universidad de Huelva"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-2xl"></div>
        </div>
        <div class="truncate">
          <div class="flex items-center gap-2">
            <span class="font-display font-bold text-[15px] sm:text-base theme-text-primary leading-tight tracking-tight">
              GDG on Campus
            </span>
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider theme-badge-pill">
              <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
              UI Rework
            </span>
          </div>
          <div class="text-xs font-medium theme-text-secondary leading-tight truncate">
            Universidad de Huelva
          </div>
        </div>
      </a>
    </div>

    <!-- Right: Direct Comparison Link + 12-Style Lab Selector + Comunidad -->
    <nav class="flex items-center gap-1.5 sm:gap-2.5 text-sm font-medium shrink-0">
      <!-- Direct Comparison Button (Jump to Original v1) -->
      <a
        href={originalUrl}
        class="theme-pill-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-xs font-bold transition-all duration-300"
        title="Comparar directamente con la versión original actual"
      >
        <svg class="w-3.5 h-3.5 opacity-80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <span class="hidden md:inline">Versión Original</span>
        <span class="md:hidden">v1</span>
      </a>

      <!-- 12-Theme Mega Switcher (Also works in Lab Mode on Certificate pages!) -->
      <div class="relative" id="theme-switcher-container">
        <button
          type="button"
          id="theme-menu-button"
          aria-expanded="false"
          class="theme-pill-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 cursor-pointer select-none"
          title={normalizedLocked ? 'Estilo del certificado (Haz clic para probar los 12 estilos en Modo Laboratorio)' : 'Explorar los 12 universos visuales'}
        >
          <span id="current-theme-icon" class="w-4 h-4 flex items-center justify-center shrink-0" set:html={initialMeta.svgIcon}></span>
          <span id="current-theme-label" class="truncate max-w-[96px] sm:max-w-none">{initialMeta.shortLabel}</span>
          {normalizedLocked && (
            <span
              id="cert-official-lock-badge"
              class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[9px] uppercase tracking-wider bg-current/10 opacity-80"
              title="Estilo oficial asignado al certificado"
            >
              Lab 12
            </span>
          )}
          <svg class="w-3.5 h-3.5 opacity-70 transition-transform duration-300" id="theme-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Mega Dropdown Panel with all 12 Styles -->
        <div
          id="theme-dropdown-menu"
          class="hidden absolute right-0 mt-3 w-[320px] sm:w-[440px] rounded-3xl p-3.5 shadow-2xl border theme-dropdown-panel z-50 backdrop-blur-2xl transition-all duration-300"
        >
          <div class="flex items-center justify-between px-2 pb-2.5 mb-2 border-b theme-border">
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider theme-text-primary flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 theme-accent-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
                <span>Selector de Universo Visual (12 Estilos)</span>
              </div>
              <p class="text-[11px] theme-text-secondary mt-0.5">
                {normalizedLocked
                  ? `Estilo original: ${initialMeta.label} · Modo Laboratorio activo`
                  : 'Cambia la estética completa en tiempo real'}
              </p>
            </div>
            {normalizedLocked && (
              <button
                type="button"
                data-set-theme={normalizedLocked}
                class="text-[10px] font-bold px-2.5 py-1 rounded-full theme-badge-pill cursor-pointer hover:scale-105 transition-transform shrink-0"
              >
                Restaurar oficial
              </button>
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 max-h-[68vh] overflow-y-auto pr-0.5">
            {REWORK_STYLE_ORDER.map((key) => {
              const item = REWORK_THEMES[key];
              const isOfficial = normalizedLocked === key;
              return (
                <button
                  type="button"
                  data-set-theme={key}
                  class="theme-option-btn group/opt w-full flex items-center gap-3 p-2.5 rounded-2xl text-left transition-all cursor-pointer relative overflow-hidden"
                >
                  <!-- Color Swatch + Custom Vector Icon -->
                  <div
                    class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 shadow-sm border border-white/20 relative overflow-hidden"
                    style={`background: ${item.bgPreview};`}
                  >
                    <div class="w-6 h-6 rounded-lg bg-slate-950/75 backdrop-blur-xs flex items-center justify-center text-white" set:html={item.svgIcon}></div>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-extrabold truncate theme-text-primary">{item.label}</span>
                      {isOfficial && (
                        <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                          Oficial
                        </span>
                      )}
                    </div>
                    <div class="text-[10px] theme-text-secondary truncate opacity-85">
                      {item.subtitle}
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Comunidad Button (Preserved 100%) -->
      <a
        href={siteConfig.communityUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-primary-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-white transition-all duration-300 text-xs sm:text-sm font-bold"
      >
        <span>Comunidad</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>

