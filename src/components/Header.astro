---
import { siteConfig, getAssetUrl } from '@/config/site';

interface Props {
  lockedStyle?: 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos';
}

const { lockedStyle } = Astro.props;

const STYLE_INFO: Record<string, { icon: string; label: string }> = {
  google: { icon: '🔵', label: 'Google' },
  cyber: { icon: '⚡', label: 'Cyber' },
  piscina: { icon: '🌊', label: 'Piscina' },
  nieve: { icon: '❄️', label: 'Nieve' },
  caramelos: { icon: '🍬', label: 'Caramelos' },
};

const lockedMeta = lockedStyle ? (STYLE_INFO[lockedStyle] || STYLE_INFO.google) : null;
---

<header class="theme-header sticky top-0 z-40 backdrop-blur-xl transition-all duration-500">
  <!-- Top Brand Strip (adapts to active theme) -->
  <div class="theme-top-strip h-1.5 w-full flex overflow-hidden">
    <div class="h-full flex-1 bg-[#4285F4]"></div>
    <div class="h-full flex-1 bg-[#EA4335]"></div>
    <div class="h-full flex-1 bg-[#FBBC04]"></div>
    <div class="h-full flex-1 bg-[#34A853]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <a href={getAssetUrl('/')} class="flex items-center gap-3 group min-w-0">
      <!-- Official GDGoC UHU Logo -->
      <div class="w-11 h-11 rounded-xl overflow-hidden border theme-border shadow-sm shrink-0 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 bg-white">
        <img
          src={getAssetUrl('/images/gdgoc-uhu-logo.jpg')}
          alt="GDG on Campus Universidad de Huelva"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="truncate">
        <div class="font-bold text-[15px] theme-text-primary leading-tight tracking-tight">
          GDG on Campus
        </div>
        <div class="text-xs font-medium theme-text-secondary leading-tight truncate">
          Universidad de Huelva
        </div>
      </div>
    </a>

    <nav class="flex items-center gap-2 sm:gap-2.5 text-sm font-medium shrink-0">
      <!-- Style / Theme Switcher Dropdown (or Locked Badge on Certificate pages) -->
      {lockedMeta ? (
        <div
          class="theme-pill-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs sm:text-sm font-semibold select-none opacity-90 cursor-default"
          title="Estilo fijo asignado a este certificado en su emisión"
        >
          <span class="text-base leading-none">{lockedMeta.icon}</span>
          <span>{lockedMeta.label}</span>
          <svg
            class="w-3.5 h-3.5 opacity-75 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-label="Estilo bloqueado"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            />
          </svg>
        </div>
      ) : (
        <div class="relative" id="theme-switcher-container">
          <button
            type="button"
            id="theme-menu-button"
            aria-expanded="false"
            class="theme-pill-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-300 cursor-pointer select-none"
            title="Cambiar estilo visual de la página"
          >
            <span id="current-theme-icon" class="text-base leading-none">🔵</span>
            <span id="current-theme-label">Google</span>
            <svg class="w-3.5 h-3.5 opacity-70 transition-transform duration-200" id="theme-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu with the 5 Styles (No subtitles, Caramelos at the end) -->
          <div
            id="theme-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-48 rounded-2xl p-2 shadow-2xl border theme-dropdown-panel z-50 backdrop-blur-2xl transition-all"
          >
            <button
              type="button"
              data-set-theme="google"
              class="theme-option-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-bold transition-all cursor-pointer"
            >
              <span class="text-lg">🔵</span>
              <span>Google</span>
            </button>

            <button
              type="button"
              data-set-theme="cyber"
              class="theme-option-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-bold transition-all cursor-pointer mt-1"
            >
              <span class="text-lg">⚡</span>
              <span>Cyber</span>
            </button>

            <button
              type="button"
              data-set-theme="piscina"
              class="theme-option-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-bold transition-all cursor-pointer mt-1"
            >
              <span class="text-lg">🌊</span>
              <span>Piscina</span>
            </button>

            <button
              type="button"
              data-set-theme="nieve"
              class="theme-option-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-bold transition-all cursor-pointer mt-1"
            >
              <span class="text-lg">❄️</span>
              <span>Nieve</span>
            </button>

            <button
              type="button"
              data-set-theme="caramelos"
              class="theme-option-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-bold transition-all cursor-pointer mt-1"
            >
              <span class="text-lg">🍬</span>
              <span>Caramelos</span>
            </button>
          </div>
        </div>
      )}

      <!-- Comunidad Button -->
      <a
        href={siteConfig.communityUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="theme-primary-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-white transition-all duration-300 text-xs sm:text-sm font-semibold"
      >
        <span>Comunidad</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
