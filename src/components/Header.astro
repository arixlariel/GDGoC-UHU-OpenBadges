---
import { siteConfig, getFullUrl } from '@/config/site';
---

<header class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-md sticky top-0 z-40 border-b border-[#DADCE0] dark:border-slate-800 shadow-[0_1px_2px_0_rgba(60,64,67,0.06)]">
  <!-- Top 4-color Google Brand Strip -->
  <div class="h-1 w-full flex">
    <div class="h-full flex-1 bg-[#4285F4]"></div>
    <div class="h-full flex-1 bg-[#EA4335]"></div>
    <div class="h-full flex-1 bg-[#FBBC04]"></div>
    <div class="h-full flex-1 bg-[#34A853]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href={getFullUrl('/')} class="flex items-center gap-3 group min-w-0">
      <!-- Official GDGoC UHU Logo (Uploaded Illustration) -->
      <div class="w-11 h-11 rounded-xl overflow-hidden border border-[#DADCE0] dark:border-slate-700 shadow-sm shrink-0 group-hover:scale-105 transition-transform bg-white">
        <img
          src="/images/gdgoc-uhu-logo.jpg"
          alt="GDG on Campus Universidad de Huelva"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="truncate">
        <div class="font-bold text-[15px] text-[#202124] dark:text-white leading-tight flex items-center gap-1.5 tracking-tight">
          <span>GDG</span>
          <span class="font-normal text-[#5F6368] dark:text-slate-400">on Campus</span>
          <span class="hidden sm:inline-block text-[#DADCE0] dark:text-slate-700">·</span>
          <span class="hidden sm:inline-block font-medium text-[#1A73E8] dark:text-sky-400 text-xs">Certificados Digitales</span>
        </div>
        <div class="text-xs font-medium text-[#5F6368] dark:text-slate-400 leading-tight truncate">
          Universidad de Huelva
        </div>
      </div>
    </a>

    <nav class="flex items-center gap-2.5 sm:gap-3 text-sm font-medium shrink-0">
      <a
        href={getFullUrl('/')}
        class="px-3 py-2 rounded-lg text-[#5F6368] dark:text-slate-300 hover:bg-[#F1F3F4] dark:hover:bg-slate-800 hover:text-[#202124] dark:hover:text-white transition-colors hidden md:inline-block"
      >
        Certificados Digitales
      </a>

      <!-- LinkedIn Button -->
      <a
        href={siteConfig.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full border border-[#DADCE0] dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-[#F8F9FA] dark:hover:bg-slate-700 text-[#202124] dark:text-slate-200 text-xs sm:text-sm font-medium transition-all shadow-2xs"
      >
        <svg class="w-4 h-4 text-[#0A66C2] fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      <!-- Comunidad Button -->
      <a
        href={siteConfig.communityUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#1A73E8] hover:bg-[#1557B0] text-white shadow-xs hover:shadow-md transition-all text-xs sm:text-sm font-medium"
      >
        <span>Comunidad</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
