---
import { getFullUrl } from '@/config/site';
---

<header class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-md sticky top-0 z-40 border-b border-gray-200/80 dark:border-gray-800">
  <!-- Top 4-color Google bar -->
  <div class="h-1 w-full flex">
    <div class="h-full flex-1 bg-gdg-blue"></div>
    <div class="h-full flex-1 bg-gdg-red"></div>
    <div class="h-full flex-1 bg-gdg-yellow"></div>
    <div class="h-full flex-1 bg-gdg-green"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={getFullUrl('/')} class="flex items-center gap-3 group">
      <!-- GDG Brackets Icon -->
      <div class="w-9 h-9 rounded-lg bg-gray-50 dark:bg-slate-800 flex items-center justify-center p-1.5 border border-gray-200 dark:border-gray-700 shadow-sm group-hover:scale-105 transition-transform">
        <svg viewBox="0 0 100 80" class="w-full h-full">
          <path d="M 35 15 L 15 40 L 35 65" stroke="#EA4335" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M 65 15 L 85 40 L 65 65" stroke="#4285F4" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <line x1="45" y1="65" x2="55" y2="15" stroke="#FBBC04" stroke-width="10" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="font-bold text-sm text-gray-900 dark:text-white leading-tight flex items-center gap-1.5">
          GDG <span class="font-normal text-gray-500 dark:text-gray-400">on Campus</span>
        </div>
        <div class="text-[11px] font-medium text-uhu-blue dark:text-sky-400 leading-tight">
          Universidad de Huelva
        </div>
      </div>
    </a>

    <nav class="flex items-center gap-4 text-xs font-semibold">
      <a
        href={getFullUrl('/')}
        class="text-gray-600 dark:text-gray-300 hover:text-gdg-blue dark:hover:text-sky-400 transition-colors"
      >
        Certificados
      </a>
      <a
        href={getFullUrl('/api/badges/issuer.json')}
        target="_blank"
        class="text-gray-600 dark:text-gray-300 hover:text-gdg-blue dark:hover:text-sky-400 transition-colors hidden sm:inline-block"
      >
        Emisor (JSON)
      </a>
      <a
        href="https://gdg.community.dev/gdg-on-campus-universidad-de-huelva-huelva-spain/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-full bg-gdg-blue hover:bg-blue-600 text-white shadow-sm transition-all text-xs font-medium"
      >
        Comunidad GDG
      </a>
    </nav>
  </div>
</header>
