---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFullUrl } from '@/config/site';

const badges = await getCollection('badges');
const assertions = await getCollection('assertions');

const styleAliasMap: Record<string, 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos'> = {
  google: 'google',
  classic: 'google',
  cyber: 'cyber',
  hackathon: 'cyber',
  piscina: 'piscina',
  summer: 'piscina',
  nieve: 'nieve',
  winter: 'nieve',
  caramelos: 'caramelos',
  candy: 'caramelos',
};

const styleOrder: Record<string, number> = {
  google: 1,
  cyber: 2,
  piscina: 3,
  nieve: 4,
  caramelos: 5,
};

// Ordenar los certificados de ejemplo según el orden de estilos (Google, Cyber, Piscina, Nieve, Caramelos)
const sortedAssertions = [...assertions].sort((a, b) => {
  const badgeA = badges.find((bg) => bg.id.replace(/\.json$/, '') === a.data.badgeId);
  const badgeB = badges.find((bg) => bg.id.replace(/\.json$/, '') === b.data.badgeId);
  const styleA = styleAliasMap[a.data.styleOverride || badgeA?.data.style || 'google'] || 'google';
  const styleB = styleAliasMap[b.data.styleOverride || badgeB?.data.style || 'google'] || 'google';
  return (styleOrder[styleA] || 99) - (styleOrder[styleB] || 99);
});

const styleMeta: Record<string, { label: string; icon: string; pillClass: string }> = {
  google: {
    label: 'Google',
    icon: '🔵',
    pillClass: 'bg-[#E8F0FE] text-[#1967D2] border border-[#D2E3FC]',
  },
  cyber: {
    label: 'Cyber',
    icon: '⚡',
    pillClass: 'bg-[#091326] text-[#00F0FF] border border-[#00F0FF]/50',
  },
  piscina: {
    label: 'Piscina',
    icon: '🌊',
    pillClass: 'bg-[#CCFBF1] text-[#0F766E] border border-[#2DD4BF]',
  },
  nieve: {
    label: 'Nieve',
    icon: '❄️',
    pillClass: 'bg-[#E0F2FE] text-[#0369A1] border border-[#7DD3FC]',
  },
  caramelos: {
    label: 'Caramelos',
    icon: '🍬',
    pillClass: 'bg-[#FCE7F3] text-[#BE185D] border border-[#F472B6]',
  },
};
---

<BaseLayout
  title="Certificados Digitales · GDG on Campus Universidad de Huelva"
  description="Acreditaciones oficiales en relación a los eventos tecnológicos que organiza el Google Developer Group on Campus de la Universidad de Huelva."
>
  <!-- Hero Section -->
  <section class="theme-hero-section relative overflow-hidden pt-10 pb-16 sm:pt-16 sm:pb-20 backdrop-blur-md transition-all duration-500">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Column: Title, Copy & Verification Search -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="theme-badge-pill inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-5 transition-all duration-300">
            <span class="flex gap-1">
              <span class="w-2 h-2 rounded-full bg-[#4285F4] animate-pulse"></span>
              <span class="w-2 h-2 rounded-full bg-[#EA4335] animate-pulse" style="animation-delay: 0.2s"></span>
              <span class="w-2 h-2 rounded-full bg-[#FBBC04] animate-pulse" style="animation-delay: 0.4s"></span>
              <span class="w-2 h-2 rounded-full bg-[#34A853] animate-pulse" style="animation-delay: 0.6s"></span>
            </span>
            <span>Open Badges 2.0</span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl font-bold theme-text-primary tracking-tight leading-[1.12]">
            Certificados Digitales
          </h1>
          <p class="mt-2 font-display text-lg sm:text-xl font-bold theme-accent-text">
            GDG on Campus Universidad de Huelva
          </p>

          <p class="mt-4 text-sm sm:text-base theme-text-secondary max-w-xl mx-auto lg:mx-0 leading-relaxed">
            Acreditaciones oficiales en relación a los eventos tecnológicos que organiza el Google Developer Group on Campus de la Universidad de Huelva
          </p>

          <!-- Search / Verify ID Box -->
          <div class="mt-7 max-w-lg mx-auto lg:mx-0">
            <form
              onsubmit="event.preventDefault(); const val = document.getElementById('search-cert-id').value.trim(); if(val) window.location.href = './cert/' + val;"
              class="theme-search-box flex items-center gap-2 p-2 rounded-full transition-all duration-300"
            >
              <svg class="w-5 h-5 theme-text-secondary ml-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="search-cert-id"
                placeholder="Introduce el ID del certificado"
                class="flex-1 bg-transparent text-xs sm:text-sm theme-text-primary placeholder:opacity-60 outline-none px-2 font-mono"
                required
              />
              <button
                type="submit"
                class="theme-primary-btn px-5 py-2.5 rounded-full text-white font-semibold text-xs sm:text-sm transition-all duration-300 shrink-0 cursor-pointer"
              >
                Verificar
              </button>
            </form>
          </div>

          <!-- Single IMS Validator Link -->
          <div class="mt-6 flex flex-wrap items-center justify-center lg:justify-start gap-3 text-xs">
            <a
              href="https://openbadgesvalidator.imsglobal.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="theme-pill-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full font-semibold transition-all duration-300"
            >
              <span>✓ Validador IMS Global</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Campus ETSI UHU Illustration Card -->
        <div class="lg:col-span-5">
          <div class="theme-card relative mx-auto max-w-sm lg:max-w-none rounded-3xl overflow-hidden p-3">
            <div class="overflow-hidden rounded-2xl border theme-border">
              <img
                src={getFullUrl('/images/gdgoc-uhu-logo.jpg')}
                alt="Escuela Técnica Superior de Ingeniería - GDG on Campus Universidad de Huelva"
                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="pt-3 px-2 pb-1 flex items-center justify-between text-xs theme-text-secondary">
              <span class="font-semibold theme-text-primary">ETSI · Universidad de Huelva</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificados Emitidos Recientes -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-2">
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold theme-text-primary">
          Certificados Digitales Emitidos
        </h2>
        <p class="text-sm theme-text-secondary mt-1">
          Explora los certificados emitidos (cada uno conserva su propio estilo visual al abrirlo).
        </p>
      </div>
      <span class="theme-pill-btn inline-flex items-center gap-2 text-xs font-semibold px-3.5 py-1.5 rounded-full self-start sm:self-auto">
        <span class="w-2 h-2 rounded-full bg-[#34A853] animate-ping"></span>
        {sortedAssertions.length} {sortedAssertions.length === 1 ? 'credencial activa' : 'credenciales activas'}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedAssertions.map((assertion) => {
        const id = assertion.id.replace(/\.json$/, '');
        const badge = badges.find((b) => b.id.replace(/\.json$/, '') === assertion.data.badgeId);
        const rawStyle = assertion.data.styleOverride || badge?.data.style || 'google';
        const styleKey = styleAliasMap[rawStyle] || 'google';
        const meta = styleMeta[styleKey] || styleMeta.google;

        return (
          <a
            href={getFullUrl(`/cert/${id}`)}
            class="theme-card group relative overflow-hidden rounded-2xl p-5 block"
          >
            <!-- Top accent bar per certificate style -->
            {styleKey === 'google' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 grid grid-cols-4">
                <div class="bg-[#4285F4]"></div>
                <div class="bg-[#EA4335]"></div>
                <div class="bg-[#FBBC04]"></div>
                <div class="bg-[#34A853]"></div>
              </div>
            )}
            {styleKey === 'cyber' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#00F0FF] via-[#FF007F] to-[#00FF66]"></div>
            )}
            {styleKey === 'piscina' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#00F2FE] via-[#00E5FF] to-[#0284C7]"></div>
            )}
            {styleKey === 'nieve' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#FFFFFF] via-[#7DD3FC] to-[#38BDF8]"></div>
            )}
            {styleKey === 'caramelos' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#FF1493] via-[#FF85C0] to-[#FF69B4]"></div>
            )}

            <div class="flex items-center gap-4 pt-1">
              <div class="w-16 h-16 shrink-0 p-2 rounded-2xl border theme-border bg-white/80 flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300 shadow-xs">
                {badge && (
                  <img src={badge.data.image} alt={badge.data.name} class="w-full h-full object-contain" />
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full inline-flex items-center gap-1 ${meta.pillClass}`}>
                    <span>{meta.icon}</span>
                    <span>{meta.label}</span>
                  </span>
                  <span class="text-[11px] theme-text-secondary font-mono truncate opacity-75">
                    #{id.substring(0, 8)}
                  </span>
                </div>
                <h3 class="font-display text-base font-bold truncate theme-text-primary">
                  {badge?.data.name}
                </h3>
                <p class="text-xs mt-1 truncate theme-text-secondary">
                  Otorgado a <strong class="theme-text-primary font-semibold">{assertion.data.recipient.name}</strong>
                </p>
                <div class="mt-2.5 text-xs font-bold theme-accent-text inline-flex items-center gap-1 group-hover:translate-x-1.5 transition-transform">
                  <span>Abrir certificado ({meta.label})</span>
                  <span>→</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Características del Sistema -->
  <section class="theme-hero-section border-t theme-border py-14 relative z-10 backdrop-blur-md">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="font-display text-2xl font-bold theme-text-primary">
          Estándar Open Badges 2.0
        </h2>
        <p class="text-sm theme-text-secondary mt-2">
          Credenciales verificables con garantía criptográfica y portabilidad internacional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
        <div class="theme-card p-6 rounded-2xl">
          <div class="w-11 h-11 rounded-2xl bg-[#4285F4]/15 text-[#4285F4] flex items-center justify-center font-display font-bold text-lg mb-4">
            1
          </div>
          <h3 class="font-display font-bold theme-text-primary mb-2">Autenticidad Verificable</h3>
          <p class="text-xs theme-text-secondary leading-relaxed">
            Cada certificado está respaldado por metadatos JSON-LD oficiales de GDG on Campus Universidad de Huelva siguiendo la especificación de IMS Global.
          </p>
        </div>

        <div class="theme-card p-6 rounded-2xl">
          <div class="w-11 h-11 rounded-2xl bg-[#34A853]/15 text-[#34A853] flex items-center justify-center font-display font-bold text-lg mb-4">
            2
          </div>
          <h3 class="font-display font-bold theme-text-primary mb-2">Privacidad Protegida</h3>
          <p class="text-xs theme-text-secondary leading-relaxed">
            El correo electrónico del titular se protege mediante un hash criptográfico SHA-256 con salt único, permitiendo validar la titularidad sin exponer datos personales.
          </p>
        </div>

        <div class="theme-card p-6 rounded-2xl">
          <div class="w-11 h-11 rounded-2xl bg-[#FBBC04]/20 text-[#F29900] flex items-center justify-center font-display font-bold text-lg mb-4">
            3
          </div>
          <h3 class="font-display font-bold theme-text-primary mb-2">Integración con LinkedIn y PDF</h3>
          <p class="text-xs theme-text-secondary leading-relaxed">
            Descarga tu diploma en formato horizontal listo para imprimir o añádelo directamente a la sección de Licencias y Certificaciones de tu perfil de LinkedIn.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
