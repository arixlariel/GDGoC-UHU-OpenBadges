---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFullUrl, issuerConfig } from '@/config/site';

const badges = await getCollection('badges');
const assertions = await getCollection('assertions');
---

<BaseLayout
  title="Certificados Open Badges · GDG on Campus Universidad de Huelva"
  description="Verificación pública de insignias digitales e hitos académicos para GDGoC Universidad de Huelva."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-gray-100 dark:border-gray-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <!-- Badge pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-100 dark:border-blue-900/60 text-gdg-blue dark:text-sky-300 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-gdg-blue animate-pulse"></span>
        <span>Estándar Oficial Open Badges v2.0</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-tight">
        Certificación y Credenciales Digitales
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-gdg-blue via-gdg-red to-gdg-yellow mt-2">
          GDG on Campus Universidad de Huelva
        </span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Plataforma abierta y descentralizada de acreditación de competencias técnicas, hackathons y talleres de Google Developer Groups en la UHU.
      </p>

      <!-- Search / Verify ID Box -->
      <div class="mt-8 max-w-lg mx-auto">
        <form onsubmit="event.preventDefault(); const val = document.getElementById('search-cert-id').value.trim(); if(val) window.location.href = './cert/' + val;" class="flex items-center gap-2 bg-gray-50 dark:bg-slate-800/80 p-2 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm focus-within:ring-2 focus-within:ring-gdg-blue">
          <svg class="w-5 h-5 text-gray-400 ml-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search-cert-id"
            placeholder="Introduce el ID de tu certificado (ej: 69679d9f...)"
            class="flex-1 bg-transparent text-xs sm:text-sm text-gray-900 dark:text-white outline-none px-2 font-mono"
            required
          />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-gdg-blue hover:bg-blue-600 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm shrink-0"
          >
            Verificar
          </button>
        </form>
      </div>

      <!-- Endpoints Open Badges Info -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs font-mono">
        <a
          href={getFullUrl('/api/badges/issuer.json')}
          target="_blank"
          class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-700 dark:text-gray-300 transition-colors"
        >
          📋 /api/badges/issuer.json
        </a>
        <a
          href="https://badgecheck.io"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-lg bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 hover:bg-purple-100 transition-colors"
        >
          ✓ Validador Oficial IMS Global
        </a>
      </div>
    </div>
  </section>

  <!-- Certificados de Ejemplo / Galería -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">
          Certificados Emitidos Recientes
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
          Comprueba cómo se visualizan en los dos estilos inspirados en GDG UAM.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {assertions.map((assertion) => {
        const id = assertion.id.replace(/\.json$/, '');
        const badge = badges.find((b) => b.id.replace(/\.json$/, '') === assertion.data.badgeId);
        const style = assertion.data.styleOverride || badge?.data.style || 'classic';
        const isHackathon = style === 'hackathon';

        return (
          <a
            href={getFullUrl(`/cert/${id}`)}
            class={`block rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border ${
              isHackathon
                ? 'bg-slate-950 border-cyan-500/40 shadow-[0_0_20px_-5px_rgba(6,182,212,0.2)]'
                : 'bg-white dark:bg-slate-900 border-gray-200 dark:border-gray-800 shadow-sm'
            }`}
          >
            <div class="flex items-center gap-5">
              <div class="w-20 h-20 shrink-0 p-2 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-gray-700 flex items-center justify-center">
                {badge && (
                  <img src={badge.data.image} alt={badge.data.name} class="w-full h-full object-contain" />
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${
                    isHackathon
                      ? 'bg-cyan-950 text-cyan-300 border border-cyan-800'
                      : 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300'
                  }`}>
                    {isHackathon ? 'Estilo Hackathon' : 'Estilo Clásico'}
                  </span>
                  <span class="text-[11px] text-gray-400 font-mono truncate">
                    #{id.substring(0, 8)}
                  </span>
                </div>
                <h3 class={`text-base font-bold truncate ${isHackathon ? 'text-white' : 'text-gray-900 dark:text-white'}`}>
                  {badge?.data.name}
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate">
                  Otorgado a: <strong class={isHackathon ? 'text-cyan-300' : 'text-gray-700 dark:text-gray-200'}>{assertion.data.recipient.name}</strong>
                </p>
                <div class="mt-2 text-[11px] font-semibold text-gdg-blue dark:text-sky-400 flex items-center gap-1">
                  <span>Ver certificado completo</span>
                  <span>→</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Características del Sistema -->
  <section class="bg-gray-50 dark:bg-slate-900/50 border-t border-gray-200 dark:border-gray-800 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          ¿Cómo funciona Open Badges en GDGoC UHU?
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2">
          Garantía criptográfica y propiedad soberana de tus credenciales académicas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-gdg-blue flex items-center justify-center font-bold text-lg mb-4">
            1
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">Identidad del Emisor (Issuer)</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
            GDG on Campus UHU publica su perfil institucional en un endpoint JSON-LD verificable que avala la legitimidad de cada certificado.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800">
          <div class="w-10 h-10 rounded-xl bg-green-50 dark:bg-green-950/60 text-gdg-green flex items-center justify-center font-bold text-lg mb-4">
            2
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">Acreditación (Assertion)</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
            Cada estudiante recibe un hash criptográfico SHA-256 de su identidad, preservando su privacidad y evitando falsificaciones.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800">
          <div class="w-10 h-10 rounded-xl bg-yellow-50 dark:bg-yellow-950/60 text-gdg-yellow flex items-center justify-center font-bold text-lg mb-4">
            3
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-2">Portabilidad Universal</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
            Exporta tu insignia a LinkedIn, OpenBadge Passport, Badgr o Credly con un solo clic para enriquecer tu CV digital.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
