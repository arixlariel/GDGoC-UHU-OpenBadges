---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig, getAssetUrl, getFullUrl, getOpenBadgesPath } from '@/config/site';
import {
  BEVY_UPCOMING_API_URL,
  fetchUpcomingBevyEvents,
} from '@/utils/bevyEvents';

const upcomingEvents = await fetchUpcomingBevyEvents();
const nextEvent = upcomingEvents[0] || null;
const extraEventsCount = Math.max(0, upcomingEvents.length - 1);
---

<BaseLayout
  title="GDGoC UHU"
  description={siteConfig.hubDescription}
  image={getFullUrl('/og/hub.png')}
  ogImageWidth={1200}
  ogImageHeight={630}
  certStyle="google"
  section="hub"
  preloadHeroImage={true}
>
  <section class="flex-1 flex items-center justify-center py-12 sm:py-16 px-4 sm:px-6 relative z-10">
    <div class="max-w-[1320px] w-full mx-auto flex flex-col items-center gap-5">
      <div
        data-tilt-max="1.2"
        class="tilt-card theme-card relative w-full max-w-2xl rounded-3xl overflow-hidden px-6 py-10 sm:px-12 sm:py-14 text-center"
      >
        <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-3xl"></div>

        <div class="relative z-10 flex flex-col items-center">
          <!-- Logo oficial GDGoC UHU -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border theme-border bg-white shadow-sm mb-6">
            <img
              src={getAssetUrl('/images/gdgoc-uhu-logo-400.webp')}
              alt="GDG on Campus Universidad de Huelva"
              width="96"
              height="96"
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Etiqueta institucional discreta (4 puntos consistentes en toda la web) -->
          <div class="theme-badge-pill inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-4">
            <span class="flex gap-1" aria-hidden="true">
              <span class="theme-dot theme-dot-1"></span>
              <span class="theme-dot theme-dot-2"></span>
              <span class="theme-dot theme-dot-3"></span>
              <span class="theme-dot theme-dot-4"></span>
            </span>
            <span>Google Developer Group on Campus</span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl font-bold theme-text-primary tracking-tight leading-[1.12]">
            GDGoC UHU
          </h1>
          <p class="mt-2 font-display text-base sm:text-lg font-bold theme-accent-text">
            Universidad de Huelva
          </p>
          <p class="mt-4 text-sm sm:text-base theme-text-secondary max-w-md leading-relaxed">
            Acceso directo a nuestras plataformas oficiales
          </p>

          <!-- Botones directos a Cyber Trainer (izquierda) y Open Badges (derecha) -->
          <div class="mt-8 w-full max-w-md grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <a
              href={getAssetUrl('/cybertrainer/')}
              class="theme-primary-btn inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-full text-white font-semibold text-sm sm:text-[0.95rem] transition-all duration-300 whitespace-nowrap"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Cyber Trainer</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href={getOpenBadgesPath('/')}
              class="theme-pill-btn inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-full font-semibold text-sm sm:text-[0.95rem] transition-all duration-300 whitespace-nowrap"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Open Badges</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Próximo Evento de Bevy (sincronizado automáticamente en build + refresco en vivo) -->
      <div
        id="bevy-upcoming-slot"
        data-bevy-api={BEVY_UPCOMING_API_URL}
        data-community-url={siteConfig.communityUrl}
        data-event-end={nextEvent?.endDate || ''}
        class:list={['w-full max-w-2xl', !nextEvent && 'hidden']}
      >
        <div
          data-tilt-max="1.2"
          class="tilt-card theme-card relative w-full rounded-3xl overflow-hidden px-5 py-5 sm:px-6 sm:py-5 text-left"
        >
          <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-3xl"></div>
          <div class="theme-card-strip absolute top-0 left-0 right-0 h-1 grid grid-cols-4">
            <div class="bg-[#4285F4]"></div>
            <div class="bg-[#EA4335]"></div>
            <div class="bg-[#FBBC04]"></div>
            <div class="bg-[#34A853]"></div>
          </div>

          <div class="relative z-10 flex flex-col sm:flex-row sm:items-center gap-4 pt-1">
            <div class="flex items-start sm:items-center gap-3.5 min-w-0 flex-1">
              <div
                id="bevy-event-thumb-wrap"
                class:list={[
                  'w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden border theme-border bg-white shadow-xs shrink-0',
                  !nextEvent?.imageUrl && 'hidden',
                ]}
              >
                <img
                  id="bevy-event-img"
                  src={nextEvent?.imageUrl || ''}
                  alt={nextEvent?.title || 'Próximo evento GDGoC UHU'}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-[#E6F4EA] text-[#137333] border border-[#CEEAD6]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34A853] animate-pulse"></span>
                    <span>Próximo evento</span>
                  </span>
                  <span
                    id="bevy-event-date"
                    class="text-xs font-semibold theme-accent-text whitespace-nowrap"
                  >
                    {nextEvent?.formattedDate || ''}
                  </span>
                  <span
                    id="bevy-event-free"
                    class:list={[
                      'text-[11px] font-semibold px-2 py-0.5 rounded-full bg-[#E8F0FE] text-[#1967D2] border border-[#D2E3FC]',
                      !nextEvent?.isFree && 'hidden',
                    ]}
                  >
                    Gratuito
                  </span>
                </div>

                <h2
                  id="bevy-event-title"
                  class="font-display text-sm sm:text-[0.98rem] font-bold theme-text-primary leading-snug line-clamp-2"
                >
                  {nextEvent?.title || ''}
                </h2>

                <p
                  id="bevy-event-desc"
                  class:list={[
                    'mt-1 text-xs theme-text-secondary leading-relaxed line-clamp-2 hidden sm:block',
                    !nextEvent?.descriptionShort && '!hidden',
                  ]}
                >
                  {nextEvent?.descriptionShort || ''}
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between sm:flex-col sm:items-end gap-2 shrink-0 pt-1 sm:pt-0">
              <a
                id="bevy-event-cta"
                href={nextEvent?.url || siteConfig.communityUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="theme-primary-btn inline-flex items-center justify-center gap-1.5 h-10 px-5 rounded-full text-white font-semibold text-xs sm:text-sm transition-all duration-300 whitespace-nowrap"
              >
                <span>Apuntarse</span>
                <span aria-hidden="true">→</span>
              </a>

              <a
                id="bevy-more-events"
                href={siteConfig.communityUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'text-[11px] font-semibold theme-text-secondary hover:underline whitespace-nowrap',
                  extraEventsCount === 0 && 'hidden',
                ]}
              >
                {extraEventsCount > 0 ? `+${extraEventsCount} evento${extraEventsCount > 1 ? 's' : ''} más ↗` : ''}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const slot = document.getElementById('bevy-upcoming-slot');
      if (!slot) return;

      const apiUrl = slot.getAttribute('data-bevy-api');
      const currentEnd = slot.getAttribute('data-event-end');
      if (currentEnd) {
        const endTs = Date.parse(currentEnd);
        if (!Number.isNaN(endTs) && endTs <= Date.now()) {
          slot.classList.add('hidden');
        }
      }

      if (!apiUrl) return;

      function formatDateEs(startIso, endIso) {
        const start = new Date(startIso);
        if (Number.isNaN(start.getTime())) return '';
        const tz = 'Europe/Madrid';
        const dayFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: tz });
        const timeFmt = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: tz });
        const isoDayFmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: tz });
        const startDay = dayFmt.format(start);
        const startTime = timeFmt.format(start);
        if (endIso) {
          const end = new Date(endIso);
          if (!Number.isNaN(end.getTime()) && isoDayFmt.format(start) !== isoDayFmt.format(end)) {
            return startDay + ' – ' + dayFmt.format(end) + ' · ' + startTime + ' h';
          }
        }
        return startDay + ' · ' + startTime + ' h';
      }

      function renderEvent(upcoming) {
        if (!upcoming || upcoming.length === 0) {
          slot.classList.add('hidden');
          return;
        }
        const ev = upcoming[0];
        const titleEl = document.getElementById('bevy-event-title');
        const dateEl = document.getElementById('bevy-event-date');
        const descEl = document.getElementById('bevy-event-desc');
        const ctaEl = document.getElementById('bevy-event-cta');
        const freeEl = document.getElementById('bevy-event-free');
        const thumbWrap = document.getElementById('bevy-event-thumb-wrap');
        const imgEl = document.getElementById('bevy-event-img');
        const moreEl = document.getElementById('bevy-more-events');

        if (titleEl) titleEl.textContent = String(ev.title || '').trim();
        if (dateEl) dateEl.textContent = formatDateEs(ev.start_date, ev.end_date);
        if (descEl) {
          const desc = String(ev.description_short || '').trim();
          descEl.textContent = desc;
          descEl.classList.toggle('!hidden', !desc);
        }
        if (ctaEl && ev.url) ctaEl.setAttribute('href', String(ev.url));
        if (freeEl) {
          const isFree = /free|grat/i.test(String(ev.event_type_title || ''));
          freeEl.classList.toggle('hidden', !isFree);
        }
        if (thumbWrap && imgEl) {
          const pic = String(ev.cropped_picture_url || '').trim();
          if (pic) {
            imgEl.setAttribute('src', pic);
            imgEl.setAttribute('alt', String(ev.title || 'Próximo evento GDGoC UHU'));
            thumbWrap.classList.remove('hidden');
          } else {
            thumbWrap.classList.add('hidden');
          }
        }
        if (moreEl) {
          const extra = upcoming.length - 1;
          if (extra > 0) {
            moreEl.textContent = '+' + extra + (extra > 1 ? ' eventos más ↗' : ' evento más ↗');
            moreEl.classList.remove('hidden');
          } else {
            moreEl.classList.add('hidden');
          }
        }
        slot.setAttribute('data-event-end', String(ev.end_date || ev.start_date || ''));
        slot.classList.remove('hidden');
      }

      fetch(apiUrl, { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (data) {
          if (!data || !Array.isArray(data.results)) return;
          const now = Date.now();
          const upcoming = data.results
            .filter(function (ev) {
              if (!ev || !ev.title || !ev.url) return false;
              const endTs = Date.parse(ev.end_date || ev.start_date || '');
              return !Number.isNaN(endTs) && endTs > now;
            })
            .sort(function (a, b) {
              return Date.parse(a.start_date || '') - Date.parse(b.start_date || '');
            });
          renderEvent(upcoming);
        })
        .catch(function () {
          // Mantener el estado pre-renderizado en build si Bevy no responde
        });
    })();
  </script>
</BaseLayout>
