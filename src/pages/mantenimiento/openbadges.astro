---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MaintenanceCard from '@/components/MaintenanceCard.astro';

const badges = await getCollection('badges');
const assertions = await getCollection('assertions');

const badgeStyleById = new Map<string, 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos'>();
for (const b of badges) {
  const bId = b.id.replace(/^.*\/|\.json$/g, '');
  badgeStyleById.set(bId, b.data.style || 'google');
}

const certStyleMap: Record<string, 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos'> = {};
for (const a of assertions) {
  const aId = a.id.replace(/^.*\/|\.json$/g, '');
  certStyleMap[aId] = a.data.styleOverride || badgeStyleById.get(a.data.badgeId) || 'google';
}
---

<BaseLayout
  title="Mantenimiento · GDGoC UHU Open Badges"
  description="Estamos realizando tareas de mantenimiento en GDGoC UHU Open Badges. Tus certificados volverán a estar disponibles en breve."
  section="openbadges"
  certStyleMap={certStyleMap}
  noIndex={true}
>
  <MaintenanceCard scope="openbadges" />
</BaseLayout>
