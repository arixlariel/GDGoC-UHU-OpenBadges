---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAssetUrl, getFullUrl, getOpenBadgesPath, isShowcaseAssertion } from '@/config/site';
import { getBadgeThumbUrl } from '@/utils/assetVersion';

const badges = await getCollection('badges');
const assertions = await getCollection('assertions');
const showcaseAssertions = assertions.filter((a) => isShowcaseAssertion(a));

const styleOrder: Record<string, number> = {
  google: 1,
  cyber: 2,
  piscina: 3,
  nieve: 4,
  caramelos: 5,
};

// Rotar únicamente entre los certificados públicos de los organizadores
const sortedAssertions = [...showcaseAssertions].sort((a, b) => {
  const badgeA = badges.find((bg) => bg.id.replace(/^.*\/|\.json$/g, '') === a.data.badgeId);
  const badgeB = badges.find((bg) => bg.id.replace(/^.*\/|\.json$/g, '') === b.data.badgeId);
  const styleA = a.data.styleOverride || badgeA?.data.style || 'google';
  const styleB = b.data.styleOverride || badgeB?.data.style || 'google';
  return (styleOrder[styleA] || 99) - (styleOrder[styleB] || 99);
});

const styleMeta: Record<string, { label: string; icon: string; pillClass: string }> = {
  google: {
    label: 'Google',
    icon: '🔵',
    pillClass: 'bg-[#E8F0FE] text-[#1967D2] border border-[#D2E3FC]',
  },
  cyber: {
    label: 'Cyber',
    icon: '⚡',
    pillClass: 'bg-[#091326] text-[#00F0FF] border border-[#00F0FF]/50',
  },
  piscina: {
    label: 'Piscina',
    icon: '🌊',
    pillClass: 'bg-[#CCFBF1] text-[#0F766E] border border-[#2DD4BF]',
  },
  nieve: {
    label: 'Nieve',
    icon: '❄️',
    pillClass: 'bg-[#E0F2FE] text-[#0369A1] border border-[#7DD3FC]',
  },
  caramelos: {
    label: 'Caramelos',
    icon: '🍬',
    pillClass: 'bg-[#FCE7F3] text-[#BE185D] border border-[#F472B6]',
  },
};
---

<BaseLayout
  title="GDGoC UHU Open Badges"
  description="Acreditaciones oficiales en relación a los eventos tecnológicos que organiza el Google Developer Group on Campus de la Universidad de Huelva."
  image={getFullUrl('/og/openbadges.png')}
  ogImageWidth={1200}
  ogImageHeight={630}
  section="openbadges"
  preloadHeroImage={true}
>
  <!-- Hero Section -->
  <section class="theme-hero-section relative overflow-hidden pt-10 pb-16 sm:pt-16 sm:pb-20 transition-colors duration-300">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Column: Title, Copy & Verification Search -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="theme-badge-pill inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-5 transition-colors duration-300">
            <span class="flex gap-1" aria-hidden="true">
              <span class="theme-dot theme-dot-1"></span>
              <span class="theme-dot theme-dot-2"></span>
              <span class="theme-dot theme-dot-3"></span>
              <span class="theme-dot theme-dot-4"></span>
            </span>
            <span>Open Badges 2.0 &amp; 3.0</span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl font-bold theme-text-primary tracking-tight leading-[1.12]">
            Certificados Digitales
          </h1>
          <p class="mt-2 font-display text-lg sm:text-xl font-bold theme-accent-text">
            GDG on Campus Universidad de Huelva
          </p>

          <p class="mt-4 text-sm sm:text-base theme-text-secondary max-w-xl mx-auto lg:mx-0 leading-relaxed">
            Acreditaciones oficiales en relación a los eventos tecnológicos que organiza el Google Developer Group on Campus de la Universidad de Huelva
          </p>

          <!-- Search / Verify ID Box -->
          <div class="mt-7 max-w-lg mx-auto lg:mx-0">
            <form
              id="search-cert-form"
              autocomplete="off"
              class="theme-search-box flex items-center gap-2 p-2 rounded-full transition-all duration-300"
            >
              <svg class="w-5 h-5 theme-text-secondary ml-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="search-cert-id"
                autocomplete="off"
                aria-label="Introduce el ID del certificado"
                placeholder="Introduce el ID del certificado"
                class="flex-1 bg-transparent text-xs sm:text-sm theme-text-primary placeholder:opacity-60 outline-none px-2 font-mono"
                required
              />
              <button
                type="submit"
                class="theme-primary-btn px-5 py-2.5 rounded-full text-white font-semibold text-xs sm:text-sm transition-all duration-300 shrink-0 cursor-pointer"
              >
                Verificar
              </button>
            </form>
          </div>

          <script is:inline define:vars={{ certBaseUrl: getOpenBadgesPath('/cert/') }}>
            (function () {
              const form = document.getElementById('search-cert-form');
              const input = document.getElementById('search-cert-id');
              if (!form || !input) return;

              const clearInput = () => {
                input.value = '';
              };

              clearInput();
              window.addEventListener('pageshow', clearInput);
              window.addEventListener('pagehide', clearInput);

              form.addEventListener('submit', (e) => {
                e.preventDefault();
                const val = input.value.trim();
                clearInput();
                input.blur();
                if (val) {
                  window.location.href = certBaseUrl + encodeURIComponent(val) + '/';
                }
              });
            })();
          </script>

          <!-- Single 1EdTech Validator Link (Open Badges 3.0) -->
          <div class="mt-6 flex flex-wrap items-center justify-center lg:justify-start gap-3">
            <a
              href="https://vc.1ed.tech/upload?validatorId=OB30Inspector"
              target="_blank"
              rel="noopener noreferrer"
              class="theme-pill-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300"
            >
              <span>Validador 1EdTech Global</span>
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Column: Campus ETSI UHU Illustration Card with 3D Tilt -->
        <div class="lg:col-span-5">
          <div
            data-tilt-max="2.2"
            class="tilt-card theme-card relative mx-auto max-w-sm lg:max-w-none rounded-3xl overflow-hidden p-3 group"
          >
            <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-3xl"></div>
            <div class="overflow-hidden rounded-2xl border theme-border aspect-square">
              <img
                src={getAssetUrl('/images/gdgoc-uhu-logo.jpg')}
                alt="Escuela Técnica Superior de Ingeniería - GDG on Campus Universidad de Huelva"
                width="1024"
                height="1024"
                fetchpriority="high"
                loading="eager"
                decoding="sync"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="pt-3 px-2 pb-1 flex items-center justify-between text-xs theme-text-secondary">
              <span class="font-semibold theme-text-primary">Campus El Carmen · Universidad de Huelva</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificados Emitidos Recientes -->
  <section class="max-w-[1320px] w-full mx-auto px-4 sm:px-6 py-14 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-2">
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold theme-text-primary">
          Certificados Digitales Emitidos
        </h2>
        <p class="text-sm theme-text-secondary mt-1">
          Explora algunos de nuestros certificados digitales
        </p>
      </div>
      <span class="theme-info-pill inline-flex items-center gap-2 text-xs font-semibold px-3.5 py-1.5 rounded-full self-start sm:self-auto cursor-default select-none">
        <span class="w-2 h-2 rounded-full bg-[#34A853] animate-ping"></span>
        {assertions.length} {assertions.length === 1 ? 'credencial activa' : 'credenciales activas'}
      </span>
    </div>

    <div id="cert-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedAssertions.map((assertion, index) => {
        const id = assertion.id.replace(/^.*\/|\.json$/g, '');
        const badge = badges.find((b) => b.id.replace(/^.*\/|\.json$/g, '') === assertion.data.badgeId);
        const styleKey = assertion.data.styleOverride || badge?.data.style || 'google';
        const meta = styleMeta[styleKey] || styleMeta.google;

        return (
          <a
            href={getOpenBadgesPath(`/cert/${id}/`)}
            data-tilt-max="2.2"
            style={index >= 6 ? 'display: none;' : undefined}
            class="cert-card-item tilt-card theme-card group relative overflow-hidden rounded-2xl p-5 block"
          >
            <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-2xl"></div>
            <!-- Top accent bar per certificate style -->
            {styleKey === 'google' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 grid grid-cols-4">
                <div class="bg-[#4285F4]"></div>
                <div class="bg-[#EA4335]"></div>
                <div class="bg-[#FBBC04]"></div>
                <div class="bg-[#34A853]"></div>
              </div>
            )}
            {styleKey === 'cyber' && (
              <div class="absolute top-0 left-0 right-0 h-1.5" style="background: linear-gradient(90deg, #00F0FF, #FF007F, #FFE600, #00FF66);"></div>
            )}
            {styleKey === 'piscina' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#00F2FE] via-[#00E5FF] to-[#0284C7]"></div>
            )}
            {styleKey === 'nieve' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#FFFFFF] via-[#7DD3FC] to-[#38BDF8]"></div>
            )}
            {styleKey === 'caramelos' && (
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#FF1493] via-[#FF85C0] to-[#FF69B4]"></div>
            )}

            <div class="flex items-center gap-4 pt-1">
              <div class="w-16 h-16 shrink-0 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                {badge && (
                  <img
                    src={getBadgeThumbUrl(badge.data.image)}
                    alt={badge.data.name}
                    width="64"
                    height="64"
                    loading={index < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="w-full h-full object-contain drop-shadow-[0_4px_12px_rgba(0,0,0,0.35)]"
                  />
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full inline-flex items-center gap-1 ${meta.pillClass}`}>
                    <span>{meta.icon}</span>
                    <span>{meta.label}</span>
                  </span>
                  <span class="text-[11px] theme-text-secondary font-mono truncate opacity-75">
                    #{id.substring(0, 8)}
                  </span>
                </div>
                <h3 class="font-display text-base font-bold truncate theme-text-primary">
                  {badge?.data.name}
                </h3>
                <p class="text-xs mt-1 truncate theme-text-secondary">
                  Otorgado a <strong class="theme-text-primary font-semibold">{assertion.data.recipient.name}</strong>
                </p>
                <div class="mt-2.5 text-xs font-bold theme-accent-text inline-flex items-center gap-1 group-hover:translate-x-1.5 transition-transform">
                  <span>Abrir certificado</span>
                  <span>→</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Selección aleatoria de hasta 6 certificados en cada recarga -->
    <script is:inline>
      (function () {
        const grid = document.getElementById('cert-cards-grid');
        if (!grid) return;
        const cards = Array.from(grid.querySelectorAll('.cert-card-item'));
        if (cards.length === 0) return;

        // Algoritmo Fisher-Yates para barajar aleatoriamente en cada recarga
        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          const temp = cards[i];
          cards[i] = cards[j];
          cards[j] = temp;
        }

        const maxVisible = 6;
        cards.forEach((card, index) => {
          if (index < maxVisible) {
            card.style.display = '';
            const img = card.querySelector('img');
            if (img) img.loading = 'eager';
            grid.appendChild(card);
          } else {
            card.style.display = 'none';
          }
        });
      })();
    </script>
  </section>

  <!-- Características del Sistema -->
  <section class="theme-hero-section border-t theme-border py-14 relative z-10">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="font-display text-2xl sm:text-3xl font-bold theme-text-primary">
          Estándar Open Badges 2.0 &amp; 3.0
        </h2>
        <p class="text-sm sm:text-base theme-text-secondary mt-2.5 leading-relaxed">
          Credenciales verificables con firma criptográfica Ed25519 y portabilidad internacional
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div data-tilt-max="2.2" class="tilt-card theme-card p-6 sm:p-7 rounded-2xl relative overflow-hidden">
          <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-2xl"></div>
          <div class="w-11 h-11 rounded-2xl bg-[#4285F4]/15 text-[#4285F4] flex items-center justify-center font-display font-bold text-lg mb-4">
            1
          </div>
          <h3 class="font-display text-base sm:text-lg font-bold theme-text-primary mb-2.5">Autenticidad Verificable</h3>
          <p class="text-sm theme-text-secondary leading-relaxed">
            Cada certificado está respaldado por metadatos JSON-LD oficiales de GDGoC Universidad de Huelva (Open Badges 2.0 &amp; 3.0) y firma criptográfica Ed25519 conforme a 1EdTech
          </p>
        </div>

        <div data-tilt-max="2.2" class="tilt-card theme-card p-6 sm:p-7 rounded-2xl relative overflow-hidden">
          <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-2xl"></div>
          <div class="w-11 h-11 rounded-2xl bg-[#34A853]/15 text-[#34A853] flex items-center justify-center font-display font-bold text-lg mb-4">
            2
          </div>
          <h3 class="font-display text-base sm:text-lg font-bold theme-text-primary mb-2.5">Privacidad Protegida</h3>
          <p class="text-sm theme-text-secondary leading-relaxed">
            El correo electrónico del titular se protege mediante un hash criptográfico SHA-256 con salt variable, permitiendo validar la titularidad sin exponer datos personales
          </p>
        </div>

        <div data-tilt-max="2.2" class="tilt-card theme-card p-6 sm:p-7 rounded-2xl relative overflow-hidden">
          <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-2xl"></div>
          <div class="w-11 h-11 rounded-2xl bg-[#FBBC04]/20 text-[#F29900] flex items-center justify-center font-display font-bold text-lg mb-4">
            3
          </div>
          <h3 class="font-display text-base sm:text-lg font-bold theme-text-primary mb-2.5">Integración con LinkedIn y PDF</h3>
          <p class="text-sm theme-text-secondary leading-relaxed">
            Descarga tu diploma en formato horizontal listo para imprimir o añádelo directamente a tu LinkedIn u otras carteras
          </p>
        </div>
      </div>

      <!-- Mini-guía de uso del Validador Oficial de 1EdTech -->
      <div
        data-tilt-max="1.5"
        class="tilt-card mt-6 theme-card p-6 sm:p-7 rounded-2xl relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-5"
      >
        <div class="tilt-glare absolute inset-0 pointer-events-none z-20 rounded-2xl"></div>
        <div class="space-y-2 relative z-10">
          <h3 class="font-display text-base sm:text-lg font-bold theme-text-primary">
            ¿Cómo verificar un certificado con el Validador 1EdTech Global?
          </h3>
          <p class="text-sm theme-text-secondary leading-relaxed max-w-3xl">
            Abre tu certificado, pulsa <strong class="theme-text-primary">Añadir a tu cartera</strong> para copiar el enlace <strong class="theme-text-primary">Open Badges 3.0</strong> de tu credencial (o descarga el archivo <code class="font-mono text-[13px]">.json</code>), accede al validador oficial de 1EdTech Global, pega el enlace o sube el <code class="font-mono text-[13px]">.json</code> y pulsa <strong class="theme-text-primary">Upload</strong> para verificar su firma criptográfica sin errores
          </p>
        </div>
        <a
          href="https://vc.1ed.tech/upload?validatorId=OB30Inspector"
          target="_blank"
          rel="noopener noreferrer"
          class="theme-primary-btn relative z-10 inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full text-white font-semibold text-xs sm:text-sm shrink-0 transition-all duration-300 self-start md:self-center"
        >
          <span>Validador 1EdTech Global</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
