---
import { getCollection } from 'astro:content';
import { getOpenBadgesPath, getOpenBadgesUrl } from '@/config/site';

export async function getStaticPaths() {
  const assertions = await getCollection('assertions');
  return assertions.map((assertion) => ({
    params: { id: assertion.id.replace(/^.*\/|\.json$/g, '') },
  }));
}

const assertionId = Astro.params.id as string;
const targetPath = getOpenBadgesPath(`/cert/${assertionId}/`);
const targetFullUrl = getOpenBadgesUrl(`/cert/${assertionId}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={targetFullUrl} />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <title>Redirigiendo al certificado | GDGoC UHU Open Badges</title>
    <script is:inline define:vars={{ targetPath }}>
      window.location.replace(targetPath + window.location.search + window.location.hash);
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #05070F; color: #E2F1FF;">
    <p>
      Redirigiendo al certificado oficial…
      <a href={targetPath} style="color: #00F0FF;">Abrir certificado</a>
    </p>
  </body>
</html>
