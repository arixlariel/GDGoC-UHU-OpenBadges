---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CertificateDiploma from '@/components/CertificateDiploma.astro';
import BadgeModal from '@/components/BadgeModal.astro';
import { getFullUrl } from '@/config/site';

export async function getStaticPaths() {
  const assertions = await getCollection('assertions');
  return assertions.map((assertion) => ({
    params: { id: assertion.id.replace(/\.json$/, '') },
    props: { assertion },
  }));
}

const { assertion } = Astro.props;
const assertionId = Astro.params.id as string;

// Fetch badge
const badgeEntry = await getEntry('badges', assertion.data.badgeId);

if (!badgeEntry) {
  throw new Error(`Badge no encontrado: ${assertion.data.badgeId}`);
}

const badge = badgeEntry;
const assertionJsonUrl = getFullUrl(`/api/badges/assertion/${assertionId}.json`);
const badgeImageUrl = getFullUrl(badge.data.image);

const certStyle = (assertion.data.styleOverride || badge.data.style || 'google') as 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos';

const pageTitle = `${badge.data.name} - ${assertion.data.recipient.name} | Certificados Digitales GDGoC UHU`;
const pageDescription = `Certificado digital oficial: ${badge.data.name} otorgado a ${assertion.data.recipient.name} por GDG on Campus Universidad de Huelva.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={badgeImageUrl}
  certStyle={certStyle}
  jsonLdUrl={assertionJsonUrl}
>
  <CertificateDiploma
    assertion={assertion}
    badge={badge}
    assertionId={assertionId}
    initialStyle={certStyle}
  />

  <!-- Modal interactivo Web Component (Añadir a tu cartera) -->
  <BadgeModal
    assertionUrl={assertionJsonUrl}
    badgeName={badge.data.name}
  />
</BaseLayout>
