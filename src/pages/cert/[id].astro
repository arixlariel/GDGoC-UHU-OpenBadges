---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CertificateClassic from '@/components/CertificateClassic.astro';
import CertificateHackathon from '@/components/CertificateHackathon.astro';
import BadgeModal from '@/components/BadgeModal.astro';
import { getFullUrl } from '@/config/site';

export async function getStaticPaths() {
  const assertions = await getCollection('assertions');
  return assertions.map((assertion) => ({
    params: { id: assertion.id.replace(/\.json$/, '') },
    props: { assertion },
  }));
}

const { assertion } = Astro.props;
const assertionId = Astro.params.id as string;

// Fetch badge
const badgeEntry = await getEntry('badges', assertion.data.badgeId);

if (!badgeEntry) {
  throw new Error(`Badge no encontrado: ${assertion.data.badgeId}`);
}

const badge = badgeEntry;
const assertionJsonUrl = getFullUrl(`/api/badges/assertion/${assertionId}.json`);
const badgeImageUrl = getFullUrl(badge.data.image);

// Determinar qué estilo renderizar ('classic' o 'hackathon')
const activeStyle = assertion.data.styleOverride || badge.data.style || 'classic';
const pageTitle = `${badge.data.name} - ${assertion.data.recipient.name} | GDG on Campus UHU`;
const pageDescription = `Certificado de logro oficial: ${badge.data.name} otorgado a ${assertion.data.recipient.name} por GDG on Campus Universidad de Huelva.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={badgeImageUrl}
  theme={activeStyle === 'hackathon' ? 'dark' : 'auto'}
  jsonLdUrl={assertionJsonUrl}
>
  {activeStyle === 'hackathon' ? (
    <CertificateHackathon
      assertion={assertion}
      badge={badge}
      assertionId={assertionId}
    />
  ) : (
    <CertificateClassic
      assertion={assertion}
      badge={badge}
      assertionId={assertionId}
    />
  )}

  <!-- Modal interactivo Web Component (Añadir a tu perfil) -->
  <BadgeModal
    assertionUrl={assertionJsonUrl}
    badgeName={badge.data.name}
  />
</BaseLayout>
