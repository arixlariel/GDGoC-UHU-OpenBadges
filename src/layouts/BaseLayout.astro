        box-shadow: 0 15px 40px rgba(2, 132, 199, 0.45);
      }
      html[data-theme="winter"] .theme-option-btn:hover {
        background: rgba(125, 211, 252, 0.2);
        color: #FFFFFF;
        transform: translateX(5px);
      }
      html[data-theme="winter"] .theme-card {
        background: rgba(16, 42, 74, 0.62);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(186, 230, 253, 0.4);
        box-shadow: 0 8px 32px rgba(2, 12, 27, 0.35), inset 0 0 24px rgba(224, 242, 254, 0.1);
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      html[data-theme="winter"] .theme-card:hover {
        transform: translateY(-9px) scale(1.03);
        border-color: #FFFFFF;
        box-shadow: 0 18px 42px rgba(56, 189, 248, 0.4),
                    0 0 25px rgba(224, 242, 254, 0.5),
                    inset 0 0 30px rgba(255, 255, 255, 0.22);
      }
      html[data-theme="winter"] .theme-search-box {
        background: rgba(12, 33, 60, 0.82);
        backdrop-filter: blur(16px);
        border: 2px solid rgba(186, 230, 253, 0.55);
        box-shadow: 0 0 26px rgba(56, 189, 248, 0.25);
      }
      html[data-theme="winter"] .theme-search-box:focus-within {
        border-color: #FFFFFF;
        transform: scale(1.03);
        box-shadow: 0 0 36px rgba(186, 230, 253, 0.65);
      }

      /* Print Rules */
      @media print {
        header, footer, .no-print, #theme-fx-container {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          margin: 0 !important;
          padding: 0 !important;
        }
        main {
          padding: 0 !important;
          margin: 0 !important;
        }
        .print-diploma-wrapper {
          box-shadow: none !important;
          padding: 0 !important;
          border: none !important;
          transform: none !important;
          width: 100% !important;
          max-width: none !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased relative">
    <!-- ========================================================================
         ANIMATED MOVING BACKGROUND FX FOR EACH OF THE 5 STYLES
         ======================================================================== -->
    <div id="theme-fx-container" class="fixed inset-0 pointer-events-none overflow-hidden z-0 no-print">

      <!-- 1. CLASSIC FX: Floating Google 4-Color Orbs & Geometric Rings -->
