---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig, getFullUrl } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: string;
  certStyle?: 'classic' | 'cyber' | 'candy' | 'summer' | 'winter';
  jsonLdUrl?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = getFullUrl('/images/gdgoc-uhu-logo.jpg'),
  certStyle,
  jsonLdUrl,
} = Astro.props;

const initialTheme = certStyle || 'classic';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
---

<!doctype html>
<html
  lang="es"
  data-theme={initialTheme}
  data-cert-style={certStyle || ''}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={getFullUrl('/images/gdgoc-uhu-logo.jpg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Open Badges v2 Discovery Link (interno para validadores) -->
    {jsonLdUrl && (
      <link rel="alternate" type="application/ld+json" href={jsonLdUrl} title="Open Badges Assertion" />
    )}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Google+Sans+Display:wght@400;500;700&family=Google+Sans+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@500;600;700&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Theme Pre-Init Script (Prevents Flash & Respects Specific Certificate Style) -->
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const forcedCertStyle = html.getAttribute('data-cert-style');
        if (forcedCertStyle) {
          // Si estamos dentro de un certificado específico, respetamos siempre su estilo propio al abrirlo
          html.setAttribute('data-theme', forcedCertStyle);
        } else {
          const saved = localStorage.getItem('gdgoc-uhu-theme');
          const valid = ['classic', 'cyber', 'candy', 'summer', 'winter'];
          if (saved && valid.includes(saved)) {
            html.setAttribute('data-theme', saved);
          }
        }
      })();
    </script>

    <style is:global>
      /* ==========================================================================
         BASE & KEYFRAME ANIMATIONS FOR ALL 5 THEMES
         ========================================================================== */
      body {
        font-family: 'Google Sans', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        transition: background 0.5s ease, color 0.4s ease;
      }

      @keyframes floatSlow {
        0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); }
        50% { transform: translateY(-22px) rotate(6deg) scale(1.06); }
      }
      @keyframes floatReverse {
        0%, 100% { transform: translateY(0px) translateX(0px) rotate(0deg); }
        50% { transform: translateY(20px) translateX(-15px) rotate(-8deg); }
      }
      @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes rainbowFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes scanlineSweep {
        0% { top: -10%; opacity: 0; }
        20% { opacity: 0.75; }
        80% { opacity: 0.75; }
        100% { top: 110%; opacity: 0; }
      }
      @keyframes cyberGridMove {
        0% { background-position: 0 0; }
        100% { background-position: 0 60px; }
      }
      @keyframes candyBounce {
        0%, 100% { transform: translateY(0) rotate(-5deg) scale(1); }
        50% { transform: translateY(-28px) rotate(8deg) scale(1.12); }
      }
      @keyframes bubbleRise {
        0% { transform: translateY(105vh) translateX(0) scale(0.6); opacity: 0; }
        15% { opacity: 0.75; }
        85% { opacity: 0.75; }
        100% { transform: translateY(-15vh) translateX(25px) scale(1.25); opacity: 0; }
      }
      @keyframes poolWaveBob {
        0%, 100% { transform: translateY(0px) rotate(-4deg); }
        50% { transform: translateY(-16px) rotate(6deg); }
      }
      @keyframes snowFall {
        0% { transform: translateY(-10vh) translateX(0px) rotate(0deg); opacity: 0; }
        10% { opacity: 0.9; }
        90% { opacity: 0.9; }
        100% { transform: translateY(108vh) translateX(35px) rotate(360deg); opacity: 0; }
      }
      @keyframes auroraWave {
        0%, 100% { transform: translateX(-8%) skewX(-8deg) scaleY(1); opacity: 0.45; }
        50% { transform: translateX(8%) skewX(8deg) scaleY(1.25); opacity: 0.8; }
      }
      @keyframes shimmerBorder {
        0% { filter: hue-rotate(0deg); }
        100% { filter: hue-rotate(360deg); }
      }

      /* Toggle visibility of theme-specific FX layers */
      .fx-layer { display: none; pointer-events: none; }
      html[data-theme="classic"] .fx-classic { display: block; }
      html[data-theme="cyber"] .fx-cyber { display: block; }
      html[data-theme="candy"] .fx-candy { display: block; }
      html[data-theme="summer"] .fx-summer { display: block; }
      html[data-theme="winter"] .fx-winter { display: block; }

      /* ==========================================================================
         1. THEME: CLASSIC (Google Brand Guidelines + Animated Orbs & 3D Hovers)
         ========================================================================== */
      html[data-theme="classic"] body {
        background: radial-gradient(circle at 15% 15%, rgba(66, 133, 244, 0.08), transparent 40%),
                    radial-gradient(circle at 85% 25%, rgba(234, 67, 53, 0.07), transparent 40%),
                    radial-gradient(circle at 75% 85%, rgba(52, 168, 83, 0.08), transparent 40%),
                    radial-gradient(circle at 20% 80%, rgba(251, 188, 4, 0.09), transparent 40%),
                    #F8F9FA;
        color: #202124;
      }
      html[data-theme="classic"] .theme-header {
        background: rgba(255, 255, 255, 0.88);
        border-bottom: 1px solid #DADCE0;
        box-shadow: 0 4px 20px rgba(32, 33, 36, 0.05);
      }
      html[data-theme="classic"] .theme-footer {
        background: rgba(255, 255, 255, 0.9);
      }
      html[data-theme="classic"] .theme-border { border-color: #DADCE0; }
      html[data-theme="classic"] .theme-text-primary { color: #202124; }
      html[data-theme="classic"] .theme-text-secondary { color: #5F6368; }
      html[data-theme="classic"] .theme-accent-text {
        background: linear-gradient(90deg, #4285F4, #EA4335, #FBBC04, #34A853);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 6s linear infinite;
      }
      html[data-theme="classic"] .theme-hero-section {
        background: rgba(255, 255, 255, 0.75);
        border-bottom: 1px solid #DADCE0;
      }
      html[data-theme="classic"] .theme-badge-pill {
        background: #E8F0FE;
        border: 1px solid #D2E3FC;
        color: #1967D2;
      }
      html[data-theme="classic"] .theme-pill-btn {
        background: #FFFFFF;
        border: 1px solid #DADCE0;
        color: #202124;
        box-shadow: 0 2px 6px rgba(32,33,36,0.05);
      }
      html[data-theme="classic"] .theme-pill-btn:hover {
        border-color: #4285F4;
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 8px 20px rgba(66, 133, 244, 0.22);
      }
      html[data-theme="classic"] .theme-primary-btn {
        background: linear-gradient(135deg, #4285F4, #1967D2);
        box-shadow: 0 4px 14px rgba(66, 133, 244, 0.35);
      }
      html[data-theme="classic"] .theme-primary-btn:hover {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 8px 25px rgba(66, 133, 244, 0.5);
      }
      html[data-theme="classic"] .theme-dropdown-panel {
        background: rgba(255, 255, 255, 0.96);
        border-color: #DADCE0;
        color: #202124;
      }
      html[data-theme="classic"] .theme-option-btn:hover {
        background: #E8F0FE;
        color: #1967D2;
        transform: translateX(4px);
      }
      html[data-theme="classic"] .theme-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid #DADCE0;
        box-shadow: 0 4px 20px rgba(32, 33, 36, 0.06);
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      html[data-theme="classic"] .theme-card:hover {
        transform: translateY(-8px) scale(1.02) rotate(-0.4deg);
        border-color: #4285F4;
        box-shadow: -8px 12px 30px rgba(66, 133, 244, 0.18),
                    8px 12px 30px rgba(234, 67, 53, 0.14),
                    0 20px 40px rgba(52, 168, 83, 0.12);
      }
      html[data-theme="classic"] .theme-search-box {
        background: #FFFFFF;
        border: 2px solid #DADCE0;
        box-shadow: 0 6px 24px rgba(66, 133, 244, 0.1);
      }
      html[data-theme="classic"] .theme-search-box:focus-within {
        border-color: #4285F4;
        box-shadow: 0 8px 30px rgba(66, 133, 244, 0.25);
        transform: scale(1.02);
      }

      /* ==========================================================================
         2. THEME: CYBER (Neon Matrix · Glitch · Laser Scanlines · Cyberpunk)
         ========================================================================== */
      html[data-theme="cyber"] body {
        background: radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.16), transparent 50%),
                    radial-gradient(circle at 85% 80%, rgba(255, 0, 127, 0.15), transparent 45%),
                    #05070F;
        color: #E2F1FF;
      }
      html[data-theme="cyber"] .theme-top-strip {
        background: linear-gradient(90deg, #00F0FF, #FF007F, #FFE600, #00FF66, #00F0FF);
        background-size: 300% 100%;
        animation: rainbowFlow 3s linear infinite;
        box-shadow: 0 0 16px #00F0FF;
      }
      html[data-theme="cyber"] .theme-top-strip > div { display: none; }
      html[data-theme="cyber"] .theme-header {
        background: rgba(6, 9, 20, 0.85);
        border-bottom: 1px solid rgba(0, 240, 255, 0.35);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
      }
      html[data-theme="cyber"] .theme-footer {
        background: rgba(6, 9, 20, 0.9);
      }
      html[data-theme="cyber"] .theme-border { border-color: rgba(0, 240, 255, 0.3); }
      html[data-theme="cyber"] .theme-text-primary {
        color: #F0F9FF;
        text-shadow: 0 0 12px rgba(0, 240, 255, 0.35);
      }
      html[data-theme="cyber"] .theme-text-secondary { color: #94A3B8; }
      html[data-theme="cyber"] .theme-accent-text {
        font-family: 'Orbitron', 'Google Sans Display', sans-serif;
        background: linear-gradient(90deg, #00F0FF, #FF007F, #00FF66);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.4));
        animation: rainbowFlow 4s linear infinite;
      }
      html[data-theme="cyber"] .theme-hero-section {
        background: rgba(8, 12, 26, 0.65);
        border-bottom: 1px solid rgba(0, 240, 255, 0.3);
      }
      html[data-theme="cyber"] .theme-badge-pill {
        background: rgba(0, 240, 255, 0.12);
        border: 1px solid #00F0FF;
        color: #00F0FF;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.3), inset 0 0 10px rgba(0, 240, 255, 0.15);
      }
      html[data-theme="cyber"] .theme-pill-btn {
        background: rgba(12, 18, 38, 0.9);
        border: 1px solid rgba(0, 240, 255, 0.5);
        color: #00F0FF;
        box-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
      }
      html[data-theme="cyber"] .theme-pill-btn:hover {
        background: rgba(255, 0, 127, 0.2);
        border-color: #FF007F;
        color: #FFFFFF;
        transform: translateY(-3px) scale(1.07) skewX(-4deg);
        box-shadow: 0 0 24px #FF007F, 0 0 40px rgba(0, 240, 255, 0.5);
      }
      html[data-theme="cyber"] .theme-primary-btn {
        background: linear-gradient(90deg, #00F0FF, #FF007F);
        color: #05070F !important;
        font-weight: 800;
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.5);
      }
      html[data-theme="cyber"] .theme-primary-btn:hover {
        transform: translateY(-3px) scale(1.08) skewX(-4deg);
        box-shadow: 0 0 32px #00F0FF, 0 0 50px #FF007F;
      }
      html[data-theme="cyber"] .theme-dropdown-panel {
        background: rgba(8, 12, 28, 0.96);
        border-color: #00F0FF;
        color: #E2F1FF;
        box-shadow: 0 0 35px rgba(0, 240, 255, 0.35);
      }
      html[data-theme="cyber"] .theme-option-btn:hover {
        background: rgba(0, 240, 255, 0.18);
        color: #00F0FF;
        transform: translateX(6px) skewX(-3deg);
      }
      html[data-theme="cyber"] .theme-card {
        background: rgba(11, 17, 36, 0.82);
        border: 1px solid rgba(0, 240, 255, 0.35);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.1), inset 0 0 20px rgba(0, 240, 255, 0.05);
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      }
      html[data-theme="cyber"] .theme-card:hover {
        transform: translateY(-10px) scale(1.035) skewX(-1.5deg);
        border-color: #FF007F;
        box-shadow: -6px 0 30px rgba(0, 240, 255, 0.55),
                    6px 0 30px rgba(255, 0, 127, 0.55),
                    inset 0 0 25px rgba(255, 0, 127, 0.2);
      }
      html[data-theme="cyber"] .theme-search-box {
        background: rgba(6, 10, 24, 0.9);
        border: 2px solid #00F0FF;
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
      }
      html[data-theme="cyber"] .theme-search-box:focus-within {
        border-color: #FF007F;
        box-shadow: 0 0 35px rgba(255, 0, 127, 0.6), 0 0 60px rgba(0, 240, 255, 0.3);
        transform: scale(1.03) skewX(-1deg);
      }

      /* ==========================================================================
         3. THEME: CANDY (Arcoíris · Unicornios · Caramelos · Algodón de Azúcar)
         ========================================================================== */
      html[data-theme="candy"] body {
        font-family: 'Fredoka', 'Google Sans', sans-serif;
        background: linear-gradient(135deg, #FFE3F1 0%, #F3E5F5 25%, #E1F5FE 50%, #FFF9C4 75%, #FFE0B2 100%);
        background-size: 400% 400%;
        animation: rainbowFlow 12s ease infinite;
        color: #5B2C6F;
      }
      html[data-theme="candy"] .theme-top-strip {
        height: 8px;
        background: linear-gradient(90deg, #FF4E88, #FF9F1C, #FFE66D, #2EC4B6, #5BC0BE, #9B5DE5, #FF4E88);
        background-size: 200% 100%;
        animation: rainbowFlow 4s linear infinite;
      }
      html[data-theme="candy"] .theme-top-strip > div { display: none; }
      html[data-theme="candy"] .theme-header {
        background: rgba(255, 245, 251, 0.82);
        border-bottom: 3px dashed #FF85C0;
        box-shadow: 0 8px 30px rgba(255, 78, 136, 0.18);
      }
      html[data-theme="candy"] .theme-footer {
        background: rgba(255, 245, 251, 0.88);
        border-top: 3px dashed #FF85C0;
      }
      html[data-theme="candy"] .theme-border { border-color: #FFB3D9; }
      html[data-theme="candy"] .theme-text-primary { color: #591C87; }
      html[data-theme="candy"] .theme-text-secondary { color: #9D4EDD; }
      html[data-theme="candy"] .theme-accent-text {
        background: linear-gradient(90deg, #FF2A85, #FF8E2B, #10B981, #8B5CF6, #FF2A85);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 3.5s linear infinite;
      }
      html[data-theme="candy"] .theme-hero-section {
        background: rgba(255, 255, 255, 0.55);
        border-bottom: 3px dashed #FFB3D9;
      }
      html[data-theme="candy"] .theme-badge-pill {
        background: linear-gradient(90deg, rgba(255, 182, 230, 0.65), rgba(208, 18fff, 0.65), rgba(255, 243, 176, 0.65));
        border: 2px solid #FF6FD8;
        color: #A21CAF;
        box-shadow: 0 4px 15px rgba(255, 111, 216, 0.3);
      }
      html[data-theme="candy"] .theme-pill-btn {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid #FF85C0;
        color: #9D174D;
        box-shadow: 0 4px 14px rgba(255, 133, 192, 0.3);
      }
      html[data-theme="candy"] .theme-pill-btn:hover {
        background: linear-gradient(135deg, #FF85C0, #B388FF);
        color: #FFFFFF;
        border-color: #FFFFFF;
        transform: translateY(-4px) scale(1.1) rotate(3deg);
        box-shadow: 0 12px 28px rgba(255, 78, 136, 0.45);
      }
      html[data-theme="candy"] .theme-primary-btn {
        background: linear-gradient(90deg, #FF4E88, #FF9F1C, #9B5DE5);
        background-size: 200% auto;
        animation: rainbowFlow 4s linear infinite;
        box-shadow: 0 6px 20px rgba(255, 78, 136, 0.45);
      }
      html[data-theme="candy"] .theme-primary-btn:hover {
        transform: translateY(-4px) scale(1.12) rotate(-3deg);
        box-shadow: 0 12px 30px rgba(155, 93, 229, 0.6);
      }
      html[data-theme="candy"] .theme-dropdown-panel {
        background: rgba(255, 248, 253, 0.97);
        border: 3px solid #FF85C0;
        color: #591C87;
        box-shadow: 0 15px 40px rgba(255, 78, 136, 0.3);
      }
      html[data-theme="candy"] .theme-option-btn:hover {
        background: linear-gradient(90deg, #FFE3F1, #F3E5F5);
        color: #D946EF;
        transform: scale(1.04) rotate(1deg);
      }
      html[data-theme="candy"] .theme-card {
        background: rgba(255, 255, 255, 0.85);
        border: 3px solid #FFB3D9;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(255, 111, 216, 0.2);
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      }
      html[data-theme="candy"] .theme-card:hover {
        transform: translateY(-12px) scale(1.05) rotate(1.8deg);
        border-color: #9B5DE5;
        box-shadow: 0 22px 45px rgba(255, 78, 136, 0.38),
                    0 0 30px rgba(255, 230, 109, 0.6);
      }
      html[data-theme="candy"] .theme-search-box {
        background: rgba(255, 255, 255, 0.95);
        border: 3px solid #FF85C0;
        box-shadow: 0 8px 28px rgba(255, 111, 216, 0.28);
      }
      html[data-theme="candy"] .theme-search-box:focus-within {
        border-color: #9B5DE5;
        transform: scale(1.04) rotate(-0.8deg);
        box-shadow: 0 12px 35px rgba(155, 93, 229, 0.45);
      }

      /* ==========================================================================
         4. THEME: SUMMER (Piscina Refrescante · Agua Turquesa · Olas & Sol)
         ========================================================================== */
      html[data-theme="summer"] body {
        background: linear-gradient(180deg, #E0F7FA 0%, #80DEEA 45%, #26C6DA 85%, #00ACC1 100%);
        background-attachment: fixed;
        color: #003642;
      }
      html[data-theme="summer"] .theme-top-strip {
        height: 7px;
        background: linear-gradient(90deg, #00E5FF, #FFE57F, #FF8A65, #00B4DB, #00E5FF);
        background-size: 200% 100%;
        animation: rainbowFlow 5s linear infinite;
      }
      html[data-theme="summer"] .theme-top-strip > div { display: none; }
      html[data-theme="summer"] .theme-header {
        background: rgba(224, 247, 250, 0.82);
        border-bottom: 2px solid rgba(0, 180, 219, 0.45);
        box-shadow: 0 8px 28px rgba(0, 131, 176, 0.18);
      }
      html[data-theme="summer"] .theme-footer {
        background: rgba(0, 77, 97, 0.85);
        color: #E0F7FA !important;
        border-top: 2px solid rgba(0, 229, 255, 0.4);
      }
      html[data-theme="summer"] .theme-footer .theme-text-primary,
      html[data-theme="summer"] .theme-footer .theme-text-secondary {
        color: #E0F7FA !important;
      }
      html[data-theme="summer"] .theme-border { border-color: rgba(0, 172, 193, 0.4); }
      html[data-theme="summer"] .theme-text-primary { color: #003847; }
      html[data-theme="summer"] .theme-text-secondary { color: #00607A; }
      html[data-theme="summer"] .theme-accent-text {
        background: linear-gradient(90deg, #0083B0, #FF6F00, #00B4DB);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 4s linear infinite;
      }
      html[data-theme="summer"] .theme-hero-section {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.65) 0%, rgba(178, 235, 242, 0.45) 100%);
        border-bottom: 2px solid rgba(0, 180, 219, 0.4);
      }
      html[data-theme="summer"] .theme-badge-pill {
        background: rgba(255, 245, 157, 0.85);
        border: 2px solid #FFB300;
        color: #E65100;
        box-shadow: 0 4px 15px rgba(255, 179, 0, 0.3);
      }
      html[data-theme="summer"] .theme-pill-btn {
        background: rgba(255, 255, 255, 0.88);
        border: 2px solid #00BCD4;
        color: #006064;
        box-shadow: 0 4px 14px rgba(0, 188, 212, 0.25);
      }
      html[data-theme="summer"] .theme-pill-btn:hover {
        background: linear-gradient(135deg, #00E5FF, #00B4DB);
        color: #003642;
        border-color: #FFF176;
        transform: translateY(-4px) scale(1.08) rotate(-2deg);
        box-shadow: 0 12px 26px rgba(0, 180, 219, 0.45);
      }
      html[data-theme="summer"] .theme-primary-btn {
        background: linear-gradient(135deg, #FF7043, #FFA726);
        box-shadow: 0 6px 20px rgba(255, 112, 67, 0.45);
      }
      html[data-theme="summer"] .theme-primary-btn:hover {
        transform: translateY(-4px) scale(1.09) rotate(2deg);
        box-shadow: 0 12px 28px rgba(255, 112, 67, 0.65);
      }
      html[data-theme="summer"] .theme-dropdown-panel {
        background: rgba(224, 247, 250, 0.96);
        border: 2px solid #00BCD4;
        color: #003847;
      }
      html[data-theme="summer"] .theme-option-btn:hover {
        background: rgba(0, 229, 255, 0.25);
        color: #006064;
        transform: translateX(5px);
      }
      html[data-theme="summer"] .theme-card {
        background: rgba(255, 255, 255, 0.82);
        border: 2px solid rgba(0, 188, 212, 0.5);
        box-shadow: 0 12px 32px rgba(0, 131, 176, 0.2), inset 0 0 20px rgba(128, 222, 234, 0.25);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      html[data-theme="summer"] .theme-card:hover {
        transform: translateY(-10px) scale(1.035) rotate(-1.2deg);
        border-color: #FF7043;
        box-shadow: 0 22px 45px rgba(0, 131, 176, 0.4),
                    0 0 28px rgba(0, 229, 255, 0.6);
      }
      html[data-theme="summer"] .theme-search-box {
        background: rgba(255, 255, 255, 0.92);
        border: 2px solid #00BCD4;
        box-shadow: 0 8px 28px rgba(0, 151, 167, 0.25);
      }
      html[data-theme="summer"] .theme-search-box:focus-within {
        border-color: #FF7043;
        transform: scale(1.03);
        box-shadow: 0 12px 34px rgba(0, 229, 255, 0.55);
      }

      /* ==========================================================================
         5. THEME: WINTER (Frío · Nieve Cayendo · Hielo Glaciar & Aurora Boreal)
         ========================================================================== */
      html[data-theme="winter"] body {
        background: linear-gradient(180deg, #061224 0%, #0C2340 45%, #163B65 85%, #1E4E79 100%);
        background-attachment: fixed;
        color: #F0F9FF;
      }
      html[data-theme="winter"] .theme-top-strip {
        height: 6px;
        background: linear-gradient(90deg, #E0F2FE, #38BDF8, #818CF8, #2DD4BF, #E0F2FE);
        background-size: 200% 100%;
        animation: rainbowFlow 5s linear infinite;
        box-shadow: 0 0 14px rgba(125, 211, 252, 0.6);
      }
      html[data-theme="winter"] .theme-top-strip > div { display: none; }
      html[data-theme="winter"] .theme-header {
        background: rgba(10, 25, 47, 0.78);
        border-bottom: 1px solid rgba(186, 230, 253, 0.35);
        box-shadow: 0 8px 32px rgba(2, 132, 199, 0.25);
      }
      html[data-theme="winter"] .theme-footer {
