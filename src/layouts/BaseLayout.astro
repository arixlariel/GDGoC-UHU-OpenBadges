        border-color: #FFFFFF;
        color: #FFFFFF;
        transform: translateY(-3px) scale(1.06);
        box-shadow: 0 0 24px rgba(125, 211, 252, 0.6), inset 0 0 15px rgba(255, 255, 255, 0.35);
      }
      html[data-theme="winter"] .theme-primary-btn {
        background: linear-gradient(135deg, #38BDF8, #6366F1);
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.45);
      }
      html[data-theme="winter"] .theme-primary-btn:hover {
        transform: translateY(-3px) scale(1.07);
        box-shadow: 0 0 30px rgba(186, 230, 253, 0.8);
      }
      html[data-theme="winter"] .theme-dropdown-panel {
