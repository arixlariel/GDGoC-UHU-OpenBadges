        color: #F0F9FF;
        text-shadow: 0 0 14px rgba(125, 211, 252, 0.3);
      }
      html[data-theme="winter"] .theme-text-secondary { color: #BAE6FD; }
      html[data-theme="winter"] .theme-accent-text {
        background: linear-gradient(90deg, #FFFFFF, #7DD3FC, #A5B4FC, #5EEAD4);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 5s linear infinite;
      }
      html[data-theme="winter"] .theme-hero-section {
        background: rgba(12, 32, 58, 0.55);
        border-bottom: 1px solid rgba(186, 230, 253, 0.3);
      }
      html[data-theme="winter"] .theme-badge-pill {
        background: rgba(224, 242, 254, 0.15);
        border: 1px solid rgba(186, 230, 253, 0.6);
        color: #E0F2FE;
        box-shadow: 0 0 16px rgba(125, 211, 252, 0.3);
      }
      html[data-theme="winter"] .theme-pill-btn {
        background: rgba(15, 38, 68, 0.78);
