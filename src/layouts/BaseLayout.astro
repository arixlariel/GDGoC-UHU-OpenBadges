        <div class="absolute top-36 right-[10%] w-80 h-80 rounded-full bg-[#EA4335]/10 blur-3xl" style="animation: floatReverse 11s ease-in-out infinite;"></div>
        <div class="absolute bottom-20 left-[18%] w-72 h-72 rounded-full bg-[#FBBC04]/14 blur-3xl" style="animation: floatReverse 10s ease-in-out infinite;"></div>
        <div class="absolute bottom-16 right-[14%] w-80 h-80 rounded-full bg-[#34A853]/12 blur-3xl" style="animation: floatSlow 12s ease-in-out infinite;"></div>
        <svg class="absolute top-24 right-[6%] w-44 h-44 opacity-20" style="animation: spinSlow 40s linear infinite;" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="80" stroke="#4285F4" stroke-width="3" stroke-dasharray="12 10" />
          <circle cx="100" cy="100" r="55" stroke="#EA4335" stroke-width="2.5" stroke-dasharray="8 8" />
        </svg>
        <svg class="absolute bottom-24 left-[5%] w-48 h-48 opacity-20" style="animation: spinSlow 45s linear infinite reverse;" viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="85" stroke="#34A853" stroke-width="3" stroke-dasharray="14 10" />
          <circle cx="100" cy="100" r="60" stroke="#FBBC04" stroke-width="2.5" stroke-dasharray="6 10" />
        </svg>
      </div>

      <!-- 2. CYBER FX: Perspective Neon Grid, Laser Scanline & Floating Matrix Tokens -->
      <div class="fx-layer fx-cyber absolute inset-0">
        <div
          class="absolute inset-0 opacity-25"
          style="background-image: linear-gradient(rgba(0, 240, 255, 0.22) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 0, 127, 0.18) 1px, transparent 1px); background-size: 60px 60px; animation: cyberGridMove 3s linear infinite;"
        ></div>
        <div class="absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#00F0FF] to-transparent shadow-[0_0_20px_#00F0FF]" style="animation: scanlineSweep 6s linear infinite;"></div>
        <span class="absolute top-[18%] left-[7%] font-mono text-xs text-[#00F0FF]/50 font-bold" style="animation: floatSlow 5s ease-in-out infinite;">0xFA92_VERIFIED //⚡</span>
        <span class="absolute top-[32%] right-[8%] font-mono text-sm text-[#FF007F]/50 font-bold" style="animation: floatReverse 6s ease-in-out infinite;">&lt;OPEN_BADGES_2.0 /&gt;</span>
        <span class="absolute bottom-[22%] left-[12%] font-mono text-xs text-[#00FF66]/50 font-bold" style="animation: floatReverse 7s ease-in-out infinite;">SHA256::ACTIVE</span>
        <span class="absolute bottom-[28%] right-[12%] font-mono text-xs text-[#00F0FF]/50 font-bold" style="animation: floatSlow 5.5s ease-in-out infinite;">[GDG_UHU::CYBER_NODE]</span>
      </div>

      <!-- 3. CANDY FX: Floating Unicorns, Rainbows, Lollipops, Candies & Sparkles -->
      <div class="fx-layer fx-candy absolute inset-0">
        <span class="absolute top-[12%] left-[6%] text-4xl opacity-80 select-none" style="animation: candyBounce 4.5s ease-in-out infinite;">🦄</span>
        <span class="absolute top-[16%] right-[8%] text-4xl opacity-80 select-none" style="animation: candyBounce 5.2s ease-in-out infinite 0.5s;">🌈</span>
        <span class="absolute top-[45%] left-[4%] text-3xl opacity-75 select-none" style="animation: candyBounce 4.8s ease-in-out infinite 1s;">🍭</span>
        <span class="absolute top-[52%] right-[5%] text-3xl opacity-75 select-none" style="animation: candyBounce 5.5s ease-in-out infinite 1.4s;">🍬</span>
        <span class="absolute bottom-[18%] left-[10%] text-4xl opacity-80 select-none" style="animation: candyBounce 4.2s ease-in-out infinite 0.8s;">🧁</span>
        <span class="absolute bottom-[14%] right-[12%] text-4xl opacity-80 select-none" style="animation: candyBounce 5s ease-in-out infinite 0.3s;">🦄</span>
        <span class="absolute top-[28%] left-[25%] text-2xl opacity-70 select-none" style="animation: floatSlow 3.8s ease-in-out infinite;">✨</span>
        <span class="absolute top-[68%] right-[24%] text-2xl opacity-70 select-none" style="animation: floatReverse 4.1s ease-in-out infinite;">🌟</span>
      </div>

      <!-- 4. SUMMER FX: Rising Pool Bubbles, Caustic Light & Floating Beach Elements -->
      <div class="fx-layer fx-summer absolute inset-0">
        <!-- Sun glow top right -->
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-gradient-to-br from-[#FFF59D] via-[#FFB74D] to-transparent opacity-60 blur-2xl" style="animation: floatSlow 8s ease-in-out infinite;"></div>
        <!-- Rising pool bubbles -->
        <span class="absolute left-[10%] text-2xl" style="animation: bubbleRise 8s linear infinite;">🫧</span>
        <span class="absolute left-[26%] text-xl" style="animation: bubbleRise 11s linear infinite 2s;">🫧</span>
        <span class="absolute left-[48%] text-3xl" style="animation: bubbleRise 9.5s linear infinite 4s;">🫧</span>
        <span class="absolute left-[72%] text-xl" style="animation: bubbleRise 10s linear infinite 1s;">🫧</span>
        <span class="absolute left-[88%] text-2xl" style="animation: bubbleRise 8.5s linear infinite 3s;">🫧</span>
        <!-- Bobbing pool & summer icons -->
        <span class="absolute top-[15%] left-[6%] text-4xl opacity-85 select-none" style="animation: poolWaveBob 4s ease-in-out infinite;">🏖️</span>
        <span class="absolute top-[20%] right-[9%] text-4xl opacity-90 select-none" style="animation: poolWaveBob 5s ease-in-out infinite 0.6s;">☀️</span>
        <span class="absolute bottom-[20%] left-[8%] text-3xl opacity-80 select-none" style="animation: poolWaveBob 4.5s ease-in-out infinite 1.2s;">🌊</span>
        <span class="absolute bottom-[16%] right-[10%] text-4xl opacity-85 select-none" style="animation: poolWaveBob 4.8s ease-in-out infinite 0.4s;">🌴</span>
        <span class="absolute top-[55%] right-[5%] text-3xl opacity-80 select-none" style="animation: poolWaveBob 3.9s ease-in-out infinite 1.5s;">🍉</span>
      </div>

      <!-- 5. WINTER FX: Aurora Borealis & Continuous Falling Snowflakes -->
      <div class="fx-layer fx-winter absolute inset-0">
        <!-- Aurora Borealis ribbons -->
        <div class="absolute -top-20 left-[10%] right-[10%] h-72 rounded-full bg-gradient-to-r from-[#2DD4BF]/30 via-[#38BDF8]/35 to-[#818CF8]/30 blur-3xl" style="animation: auroraWave 10s ease-in-out infinite;"></div>
        <!-- Falling Snowflakes -->
        <span class="absolute left-[5%] text-xl text-white/80" style="animation: snowFall 9s linear infinite;">❄️</span>
        <span class="absolute left-[14%] text-sm text-sky-200/75" style="animation: snowFall 12s linear infinite 2s;">❅</span>
        <span class="absolute left-[23%] text-2xl text-white/85" style="animation: snowFall 8.5s linear infinite 4s;">❆</span>
        <span class="absolute left-[34%] text-base text-sky-100/70" style="animation: snowFall 11s linear infinite 1s;">❄️</span>
        <span class="absolute left-[46%] text-xl text-white/80" style="animation: snowFall 10s linear infinite 5s;">❅</span>
        <span class="absolute left-[58%] text-2xl text-sky-200/85" style="animation: snowFall 9.2s linear infinite 2.5s;">❄️</span>
        <span class="absolute left-[69%] text-sm text-white/75" style="animation: snowFall 13s linear infinite 3.5s;">❆</span>
        <span class="absolute left-[79%] text-xl text-sky-100/80" style="animation: snowFall 8.8s linear infinite 0.7s;">❄️</span>
        <span class="absolute left-[88%] text-2xl text-white/90" style="animation: snowFall 10.5s linear infinite 1.8s;">❅</span>
        <span class="absolute left-[94%] text-base text-sky-200/75" style="animation: snowFall 11.5s linear infinite 4.2s;">❆</span>
      </div>

    </div>

    <Header />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />

    <!-- Global Theme Switcher Interactive Script -->
    <script>
      const THEME_META: Record<string, { icon: string; label: string }> = {
        classic: { icon: '🏛️', label: 'Clásico' },
        cyber: { icon: '⚡', label: 'Cyber' },
        candy: { icon: '🦄', label: 'Unicornio' },
        summer: { icon: '🏖️', label: 'Piscina' },
        winter: { icon: '❄️', label: 'Invierno' },
      };

      function updateThemeUI(theme: string) {
        const meta = THEME_META[theme] || THEME_META.classic;
        const iconEl = document.getElementById('current-theme-icon');
        const labelEl = document.getElementById('current-theme-label');
        if (iconEl) iconEl.textContent = meta.icon;
        if (labelEl) labelEl.textContent = meta.label;

        document.querySelectorAll('[data-set-theme]').forEach((btn) => {
          const t = btn.getAttribute('data-set-theme');
          if (t === theme) {
            btn.classList.add('ring-2', 'ring-current', 'font-bold');
          } else {
            btn.classList.remove('ring-2', 'ring-current', 'font-bold');
          }
        });
      }

      function applyTheme(theme: string, persist = true) {
        document.documentElement.setAttribute('data-theme', theme);
        if (persist) {
          localStorage.setItem('gdgoc-uhu-theme', theme);
        }
        updateThemeUI(theme);
        window.dispatchEvent(new CustomEvent('gdgoc-theme-change', { detail: { theme } }));
      }

      // Initialize Header UI with current active theme
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'classic';
      updateThemeUI(currentTheme);

      // Dropdown open/close logic
      const menuBtn = document.getElementById('theme-menu-button');
      const dropdown = document.getElementById('theme-dropdown-menu');
      const chevron = document.getElementById('theme-chevron');

      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = dropdown?.classList.contains('hidden');
        if (isHidden) {
          dropdown?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        } else {
          dropdown?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        }
      });

      document.querySelectorAll('[data-set-theme]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-set-theme') || 'classic';
          applyTheme(selected, true);
          dropdown?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        });
      });

      document.addEventListener('click', () => {
        dropdown?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      });
    </script>
  </body>
</html>
