---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig, getFullUrl } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: string;
  certStyle?: 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos';
  jsonLdUrl?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = getFullUrl('/images/gdgoc-uhu-logo.jpg'),
  certStyle,
  jsonLdUrl,
} = Astro.props;

const initialTheme = certStyle || 'google';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
---

<!doctype html>
<html
  lang="es"
  data-theme={initialTheme}
  data-cert-style={certStyle || ''}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={getFullUrl('/images/gdgoc-uhu-logo.jpg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Open Badges v2 Discovery Link (interno para validadores) -->
    {jsonLdUrl && (
      <link rel="alternate" type="application/ld+json" href={jsonLdUrl} title="Open Badges Assertion" />
    )}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Google+Sans+Display:wght@400;500;700&family=Google+Sans+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@500;600;700&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Theme Pre-Init Script: Default is 'google', remembers user's last selection in localStorage, and respects certificate's own style -->
    <script is:inline>
      (function () {
        const validThemes = ['google', 'cyber', 'piscina', 'nieve', 'caramelos'];
        const html = document.documentElement;
        const forcedCertStyle = html.getAttribute('data-cert-style');
        if (forcedCertStyle && validThemes.includes(forcedCertStyle)) {
          html.setAttribute('data-theme', forcedCertStyle);
        } else {
          const saved = localStorage.getItem('gdgoc-uhu-theme');
          const resolved = (saved && validThemes.includes(saved)) ? saved : 'google';
          html.setAttribute('data-theme', resolved);
        }
      })();
    </script>

    <style is:global>
      /* ==========================================================================
         BASE & KEYFRAME ANIMATIONS FOR ALL 5 THEMES
         ========================================================================== */
      body {
        font-family: 'Google Sans', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        transition: background 0.5s ease, color 0.4s ease;
      }

      @keyframes floatSlow {
        0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); }
        50% { transform: translateY(-22px) rotate(6deg) scale(1.06); }
      }
      @keyframes floatReverse {
        0%, 100% { transform: translateY(0px) translateX(0px) rotate(0deg); }
        50% { transform: translateY(20px) translateX(-15px) rotate(-8deg); }
      }
      @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes rainbowFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes scanlineSweep {
        0% { top: -10%; opacity: 0; }
        20% { opacity: 0.75; }
        80% { opacity: 0.75; }
        100% { top: 110%; opacity: 0; }
      }
      @keyframes cyberGridMove {
        0% { background-position: 0 0; }
        100% { background-position: 0 60px; }
      }
      @keyframes candyBounce {
        0%, 100% { transform: translateY(0) rotate(-6deg) scale(1); }
        50% { transform: translateY(-28px) rotate(10deg) scale(1.14); }
      }
      @keyframes sprinkleFall {
        0% { transform: translateY(-10vh) rotate(0deg); opacity: 0; }
        15% { opacity: 0.85; }
        85% { opacity: 0.85; }
        100% { transform: translateY(108vh) rotate(540deg); opacity: 0; }
      }
      @keyframes bubbleRise {
        0% { transform: translateY(105vh) translateX(0) scale(0.5); opacity: 0; }
        15% { opacity: 0.85; }
        50% { transform: translateY(45vh) translateX(-22px) scale(1.05); opacity: 0.9; }
        85% { opacity: 0.8; }
        100% { transform: translateY(-15vh) translateX(24px) scale(1.35); opacity: 0; }
      }
      @keyframes poolWaveBob {
        0%, 100% { transform: translateY(0px) rotate(-4deg); }
        50% { transform: translateY(-18px) rotate(7deg); }
      }
      @keyframes waveSlideLeft {
        0%, 100% { transform: translateX(0) scaleY(1); }
        50% { transform: translateX(-4%) scaleY(1.18); }
      }
      @keyframes waveSlideRight {
        0%, 100% { transform: translateX(-4%) scaleY(1.12); }
        50% { transform: translateX(0%) scaleY(0.92); }
      }
      @keyframes blizzardSnow {
        0% { transform: translateY(-12vh) translateX(-10vw) rotate(0deg); opacity: 0; }
        10% { opacity: 0.95; }
        90% { opacity: 0.95; }
        100% { transform: translateY(108vh) translateX(28vw) rotate(520deg); opacity: 0; }
      }
      @keyframes hailDrop {
        0% { transform: translateY(-10vh) translateX(-15vw) skewX(-22deg); opacity: 0; }
        15% { opacity: 0.9; }
        90% { opacity: 0.9; }
        100% { transform: translateY(110vh) translateX(38vw) skewX(-22deg); opacity: 0; }
      }
      @keyframes windGust {
        0% { transform: translateX(-110vw) translateY(0) skewX(-25deg); opacity: 0; }
        25% { opacity: 0.55; }
        75% { opacity: 0.55; }
        100% { transform: translateX(120vw) translateY(12vh) skewX(-25deg); opacity: 0; }
      }
      @keyframes auroraWave {
        0%, 100% { transform: translateX(-8%) skewX(-8deg) scaleY(1); opacity: 0.45; }
        50% { transform: translateX(8%) skewX(8deg) scaleY(1.25); opacity: 0.8; }
      }

      /* Toggle visibility of theme-specific FX layers */
      .fx-layer { display: none; pointer-events: none; }
      html[data-theme="google"] .fx-google { display: block; }
      html[data-theme="cyber"] .fx-cyber { display: block; }
      html[data-theme="piscina"] .fx-piscina { display: block; }
      html[data-theme="nieve"] .fx-nieve { display: block; }
      html[data-theme="caramelos"] .fx-caramelos { display: block; }

      /* ==========================================================================
         1. THEME: GOOGLE (Clásico Google · Material 3 · 4 Colores Oficiales)
         ========================================================================== */
      html[data-theme="google"] body {
        background: radial-gradient(circle at 15% 15%, rgba(66, 133, 244, 0.09), transparent 40%),
                    radial-gradient(circle at 85% 25%, rgba(234, 67, 53, 0.08), transparent 40%),
                    radial-gradient(circle at 75% 85%, rgba(52, 168, 83, 0.09), transparent 40%),
                    radial-gradient(circle at 20% 80%, rgba(251, 188, 4, 0.1), transparent 40%),
                    #F8F9FA;
        color: #202124;
      }
      html[data-theme="google"] .theme-header {
        background: rgba(255, 255, 255, 0.88);
        border-bottom: 1px solid #DADCE0;
        box-shadow: 0 4px 20px rgba(32, 33, 36, 0.05);
      }
      html[data-theme="google"] .theme-footer {
        background: rgba(255, 255, 255, 0.9);
      }
      html[data-theme="google"] .theme-border { border-color: #DADCE0; }
      html[data-theme="google"] .theme-text-primary { color: #202124; }
      html[data-theme="google"] .theme-text-secondary { color: #5F6368; }
      html[data-theme="google"] .theme-accent-text {
        background: linear-gradient(90deg, #4285F4, #EA4335, #FBBC04, #34A853);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 6s linear infinite;
      }
      html[data-theme="google"] .theme-hero-section {
        background: rgba(255, 255, 255, 0.75);
        border-bottom: 1px solid #DADCE0;
      }
      html[data-theme="google"] .theme-badge-pill {
        background: #E8F0FE;
        border: 1px solid #D2E3FC;
        color: #1967D2;
      }
      html[data-theme="google"] .theme-pill-btn {
        background: #FFFFFF;
        border: 1px solid #DADCE0;
        color: #202124;
        box-shadow: 0 2px 6px rgba(32,33,36,0.05);
      }
      html[data-theme="google"] .theme-pill-btn:hover {
        border-color: #4285F4;
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 8px 20px rgba(66, 133, 244, 0.22);
      }
      html[data-theme="google"] .theme-primary-btn {
        background: linear-gradient(135deg, #4285F4, #1967D2);
        box-shadow: 0 4px 14px rgba(66, 133, 244, 0.35);
      }
      html[data-theme="google"] .theme-primary-btn:hover {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 8px 25px rgba(66, 133, 244, 0.5);
      }
      html[data-theme="google"] .theme-dropdown-panel {
        background: rgba(255, 255, 255, 0.96);
        border-color: #DADCE0;
        color: #202124;
      }
      html[data-theme="google"] .theme-option-btn:hover {
        background: #E8F0FE;
        color: #1967D2;
        transform: translateX(4px);
      }
      html[data-theme="google"] .theme-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid #DADCE0;
        box-shadow: 0 4px 20px rgba(32, 33, 36, 0.06);
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      html[data-theme="google"] .theme-card:hover {
        transform: translateY(-8px) scale(1.02) rotate(-0.4deg);
        border-color: #4285F4;
        box-shadow: -8px 12px 30px rgba(66, 133, 244, 0.18),
                    8px 12px 30px rgba(234, 67, 53, 0.14),
                    0 20px 40px rgba(52, 168, 83, 0.12);
      }
      html[data-theme="google"] .theme-search-box {
        background: #FFFFFF;
        border: 2px solid #DADCE0;
        box-shadow: 0 6px 24px rgba(66, 133, 244, 0.1);
      }
      html[data-theme="google"] .theme-search-box:focus-within {
        border-color: #4285F4;
        box-shadow: 0 8px 30px rgba(66, 133, 244, 0.25);
        transform: scale(1.02);
      }

      /* ==========================================================================
         2. THEME: CYBER (Neon Matrix · Glitch · Laser Scanlines)
         ========================================================================== */
      html[data-theme="cyber"] body {
        background: radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.16), transparent 50%),
                    radial-gradient(circle at 85% 80%, rgba(255, 0, 127, 0.15), transparent 45%),
                    #05070F;
        color: #E2F1FF;
      }
      html[data-theme="cyber"] .theme-top-strip {
        background: linear-gradient(90deg, #00F0FF, #FF007F, #FFE600, #00FF66, #00F0FF);
        background-size: 300% 100%;
        animation: rainbowFlow 3s linear infinite;
        box-shadow: 0 0 16px #00F0FF;
      }
      html[data-theme="cyber"] .theme-top-strip > div { display: none; }
      html[data-theme="cyber"] .theme-header {
        background: rgba(6, 9, 20, 0.85);
        border-bottom: 1px solid rgba(0, 240, 255, 0.35);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
      }
      html[data-theme="cyber"] .theme-footer {
        background: rgba(6, 9, 20, 0.9);
      }
      html[data-theme="cyber"] .theme-border { border-color: rgba(0, 240, 255, 0.3); }
      html[data-theme="cyber"] .theme-text-primary {
        color: #F0F9FF;
        text-shadow: 0 0 12px rgba(0, 240, 255, 0.35);
      }
      html[data-theme="cyber"] .theme-text-secondary { color: #94A3B8; }
      html[data-theme="cyber"] .theme-accent-text {
        font-family: 'Orbitron', 'Google Sans Display', sans-serif;
        background: linear-gradient(90deg, #00F0FF, #FF007F, #00FF66);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.4));
        animation: rainbowFlow 4s linear infinite;
      }
      html[data-theme="cyber"] .theme-hero-section {
        background: rgba(8, 12, 26, 0.65);
        border-bottom: 1px solid rgba(0, 240, 255, 0.3);
      }
      html[data-theme="cyber"] .theme-badge-pill {
        background: rgba(0, 240, 255, 0.12);
        border: 1px solid #00F0FF;
        color: #00F0FF;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.3), inset 0 0 10px rgba(0, 240, 255, 0.15);
      }
      html[data-theme="cyber"] .theme-pill-btn {
        background: rgba(12, 18, 38, 0.9);
        border: 1px solid rgba(0, 240, 255, 0.5);
        color: #00F0FF;
        box-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
      }
      html[data-theme="cyber"] .theme-pill-btn:hover {
        background: rgba(255, 0, 127, 0.2);
        border-color: #FF007F;
        color: #FFFFFF;
        transform: translateY(-3px) scale(1.07) skewX(-4deg);
        box-shadow: 0 0 24px #FF007F, 0 0 40px rgba(0, 240, 255, 0.5);
      }
      html[data-theme="cyber"] .theme-primary-btn {
        background: linear-gradient(90deg, #00F0FF, #FF007F);
        color: #05070F !important;
        font-weight: 800;
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.5);
      }
      html[data-theme="cyber"] .theme-primary-btn:hover {
        transform: translateY(-3px) scale(1.08) skewX(-4deg);
        box-shadow: 0 0 32px #00F0FF, 0 0 50px #FF007F;
      }
      html[data-theme="cyber"] .theme-dropdown-panel {
        background: rgba(8, 12, 28, 0.96);
        border-color: #00F0FF;
        color: #E2F1FF;
        box-shadow: 0 0 35px rgba(0, 240, 255, 0.35);
      }
      html[data-theme="cyber"] .theme-option-btn:hover {
        background: rgba(0, 240, 255, 0.18);
        color: #00F0FF;
        transform: translateX(6px) skewX(-3deg);
      }
      html[data-theme="cyber"] .theme-card {
        background: rgba(11, 17, 36, 0.82);
        border: 1px solid rgba(0, 240, 255, 0.35);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.1), inset 0 0 20px rgba(0, 240, 255, 0.05);
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      }
      html[data-theme="cyber"] .theme-card:hover {
        transform: translateY(-10px) scale(1.035) skewX(-1.5deg);
        border-color: #FF007F;
        box-shadow: -6px 0 30px rgba(0, 240, 255, 0.55),
                    6px 0 30px rgba(255, 0, 127, 0.55),
                    inset 0 0 25px rgba(255, 0, 127, 0.2);
      }
      html[data-theme="cyber"] .theme-search-box {
        background: rgba(6, 10, 24, 0.9);
        border: 2px solid #00F0FF;
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
      }
      html[data-theme="cyber"] .theme-search-box:focus-within {
        border-color: #FF007F;
        box-shadow: 0 0 35px rgba(255, 0, 127, 0.6), 0 0 60px rgba(0, 240, 255, 0.3);
        transform: scale(1.03) skewX(-1deg);
      }

      /* ==========================================================================
         3. THEME: PISCINA (Agua Turquesa · Muchas Olas y Burbujas · Súper Refrescante)
         ========================================================================== */
      html[data-theme="piscina"] body {
        background: radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.55), transparent 35%),
                    radial-gradient(circle at 80% 40%, rgba(0, 229, 255, 0.45), transparent 40%),
                    linear-gradient(180deg, #CCFBF1 0%, #67E8F9 35%, #22D3EE 70%, #0284C7 100%);
        background-attachment: fixed;
        color: #003140;
      }
      html[data-theme="piscina"] .theme-top-strip {
        height: 7px;
        background: linear-gradient(90deg, #00F2FE, #4FACFE, #00E5FF, #76FF03, #00F2FE);
        background-size: 200% 100%;
        animation: rainbowFlow 4s linear infinite;
        box-shadow: 0 2px 14px rgba(0, 229, 255, 0.6);
      }
      html[data-theme="piscina"] .theme-top-strip > div { display: none; }
      html[data-theme="piscina"] .theme-header {
        background: rgba(224, 247, 250, 0.78);
        border-bottom: 2px solid rgba(0, 229, 255, 0.6);
        box-shadow: 0 8px 30px rgba(2, 132, 199, 0.2);
      }
      html[data-theme="piscina"] .theme-footer {
        background: rgba(1, 65, 92, 0.88);
        color: #E0F7FA !important;
        border-top: 2px solid rgba(0, 229, 255, 0.5);
      }
      html[data-theme="piscina"] .theme-footer .theme-text-primary,
      html[data-theme="piscina"] .theme-footer .theme-text-secondary {
        color: #E0F7FA !important;
      }
      html[data-theme="piscina"] .theme-border { border-color: rgba(0, 188, 212, 0.5); }
      html[data-theme="piscina"] .theme-text-primary { color: #002B3D; }
      html[data-theme="piscina"] .theme-text-secondary { color: #00587A; }
      html[data-theme="piscina"] .theme-accent-text {
        background: linear-gradient(90deg, #0284C7, #00B4DB, #00897B, #0284C7);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 4s linear infinite;
      }
      html[data-theme="piscina"] .theme-hero-section {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.68) 0%, rgba(165, 243, 252, 0.52) 100%);
        border-bottom: 2px solid rgba(0, 229, 255, 0.55);
      }
      html[data-theme="piscina"] .theme-badge-pill {
        background: rgba(224, 247, 250, 0.92);
        border: 2px solid #00BCD4;
        color: #006064;
        box-shadow: 0 4px 16px rgba(0, 188, 212, 0.35);
      }
      html[data-theme="piscina"] .theme-pill-btn {
        background: rgba(255, 255, 255, 0.88);
        border: 2px solid #00E5FF;
        color: #004D61;
        box-shadow: 0 4px 16px rgba(0, 188, 212, 0.25);
      }
      html[data-theme="piscina"] .theme-pill-btn:hover {
        background: linear-gradient(135deg, #00F2FE, #4FACFE);
        color: #FFFFFF;
        border-color: #FFFFFF;
        transform: translateY(-4px) scale(1.08) rotate(-2deg);
        box-shadow: 0 12px 28px rgba(0, 180, 219, 0.55);
      }
      html[data-theme="piscina"] .theme-primary-btn {
        background: linear-gradient(135deg, #00B4DB, #0083B0);
        box-shadow: 0 6px 20px rgba(0, 180, 219, 0.5);
      }
      html[data-theme="piscina"] .theme-primary-btn:hover {
        transform: translateY(-4px) scale(1.09) rotate(2deg);
        box-shadow: 0 12px 30px rgba(0, 229, 255, 0.75);
      }
      html[data-theme="piscina"] .theme-dropdown-panel {
        background: rgba(224, 247, 250, 0.96);
        border: 2px solid #00BCD4;
        color: #003847;
      }
      html[data-theme="piscina"] .theme-option-btn:hover {
        background: rgba(0, 229, 255, 0.28);
        color: #004D61;
        transform: translateX(5px);
      }
      html[data-theme="piscina"] .theme-card {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(14px);
        border: 2px solid rgba(0, 229, 255, 0.65);
        box-shadow: 0 14px 34px rgba(2, 132, 199, 0.22), inset 0 0 24px rgba(165, 243, 252, 0.45);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      html[data-theme="piscina"] .theme-card:hover {
        transform: translateY(-10px) scale(1.035) rotate(-1.2deg);
        border-color: #FFFFFF;
        box-shadow: 0 22px 48px rgba(2, 132, 199, 0.45),
                    0 0 32px rgba(0, 229, 255, 0.75),
                    inset 0 0 28px rgba(224, 247, 250, 0.8);
      }
      html[data-theme="piscina"] .theme-search-box {
        background: rgba(255, 255, 255, 0.92);
        border: 2px solid #00BCD4;
        box-shadow: 0 8px 28px rgba(0, 151, 167, 0.28);
      }
      html[data-theme="piscina"] .theme-search-box:focus-within {
        border-color: #0284C7;
        transform: scale(1.03);
        box-shadow: 0 12px 36px rgba(0, 229, 255, 0.65);
      }

      /* ==========================================================================
         4. THEME: NIEVE (Frío Polar · Ventisca · Granizo · Hielo Escarchado)
         ========================================================================== */
      html[data-theme="nieve"] body {
        background: radial-gradient(circle at 50% 0%, rgba(186, 230, 253, 0.22), transparent 55%),
                    linear-gradient(180deg, #040D1A 0%, #0A1E38 40%, #103156 75%, #1B4978 100%);
        background-attachment: fixed;
        color: #F0F9FF;
      }
      html[data-theme="nieve"] .theme-top-strip {
        height: 6px;
        background: linear-gradient(90deg, #FFFFFF, #7DD3FC, #38BDF8, #BAE6FD, #FFFFFF);
        background-size: 200% 100%;
        animation: rainbowFlow 4s linear infinite;
        box-shadow: 0 0 18px rgba(186, 230, 253, 0.8);
      }
      html[data-theme="nieve"] .theme-top-strip > div { display: none; }
      html[data-theme="nieve"] .theme-header {
        background: rgba(8, 22, 42, 0.82);
        border-bottom: 1.5px solid rgba(186, 230, 253, 0.45);
        box-shadow: 0 8px 32px rgba(2, 132, 199, 0.3), inset 0 -1px 12px rgba(255, 255, 255, 0.15);
      }
      html[data-theme="nieve"] .theme-footer {
        background: rgba(6, 17, 32, 0.9);
        border-top: 1.5px solid rgba(186, 230, 253, 0.4);
      }
      html[data-theme="nieve"] .theme-border { border-color: rgba(186, 230, 253, 0.45); }
      html[data-theme="nieve"] .theme-text-primary {
        color: #F0F9FF;
        text-shadow: 0 0 14px rgba(186, 230, 253, 0.35);
      }
      html[data-theme="nieve"] .theme-text-secondary { color: #BAE6FD; }
      html[data-theme="nieve"] .theme-accent-text {
        background: linear-gradient(90deg, #FFFFFF, #7DD3FC, #38BDF8, #E0F2FE);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
